# DeployGuard Desktop — environment configuration.
# Copy to .env.production / .env.staging / .env.development as needed.
# See docs/deployguard/17-desktop-architecture.md and 26-deployment-strategy.md.
#
# NEVER put credentials, API keys or secrets in this file or in git.
# The Odoo base URL below is the same non-secret value already used by
# mobile/.env and documented in CLAUDE.md — not sensitive on its own.

# Deployment target label shown in diagnostics ("production" | "staging" | "development")
VITE_DEPLOYGUARD_ENV=production

# DeployGuard ERP (Odoo) base URL this build talks to directly.
# MVP DEVIATION (see desktop/DEVIATIONS.md): until the DeployGuard Platform
# backend and bridge addon (BUILD-ORDER P1) exist, the desktop authenticates
# straight against this Odoo instance. This value is swapped for the
# Platform API base URL once P1 ships — see src/config/env.ts.
VITE_ODOO_BASE_URL=https://dogforcesecurityservices.com

# Odoo database name to authenticate against (multi-db servers only; leave
# blank if the server has a single database).
VITE_ODOO_DB=dogforce_prod

# Reserved for when the DeployGuard Platform API exists (P1+). Unused in
# the MVP vertical slice.
VITE_DEPLOYGUARD_API_BASE_URL=
