<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="security_help.HelpPortal">
    <div class="dg-help-portal d-flex flex-column h-100 overflow-hidden">
        <!-- ═══════════════════════════════════════════════════════════
             PAGE HEADER — Clean Corporate Light
             ═══════════════════════════════════════════════════════════ -->
        <header class="dg-help-page-header d-flex align-items-center justify-content-between px-4 py-3 bg-white border-bottom flex-wrap gap-3">
            <div class="d-flex flex-column">
                <div class="dg-help-eyebrow">KNOWLEDGE &amp; SUPPORT</div>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <i class="fa fa-question-circle text-primary fs-5" style="color: var(--ds-accent) !important;"/>
                    <h3 class="dg-help-title mb-0 fw-bold">DeployGuard Help Centre</h3>
                    <span class="badge bg-primary-subtle text-primary border px-2 py-1 ms-1" style="font-size: 11px;">
                        Interactive SOPs
                    </span>
                </div>
                <div class="dg-help-subtitle text-muted mt-1 small">
                    Operational procedures, system workflows, and administrative playbooks.
                </div>
            </div>

            <!-- Search & Actions -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="position-relative" style="width: 260px;">
                    <i class="fa fa-search position-absolute top-50 translate-middle-y text-muted" style="left: 10px; font-size: 12px;"/>
                    <input
                        type="text"
                        class="form-control form-control-sm ps-4 dg-help-search-input"
                        placeholder="Search articles &amp; SOPs…"
                        t-model="state.searchQuery"
                        t-on-input="onSearchInput"
                        t-on-keydown="onSearchKeydown"
                    />
                </div>
                <button
                    class="btn btn-sm btn-outline-secondary px-3"
                    t-att-class="{ 'btn-primary text-white fw-semibold': !state.activeCatId &amp;&amp; !state.searching &amp;&amp; !state.activeArticleId }"
                    style="background-color: (!state.activeCatId &amp;&amp; !state.searching &amp;&amp; !state.activeArticleId) ? 'var(--ds-accent)' : '';"
                    t-on-click="resetToWelcome"
                >
                    <i class="fa fa-map-o me-1"/> Workflows &amp; Flows
                </button>
            </div>
        </header>

        <!-- Top Category Navigation Bar -->
        <div class="dg-help-cat-nav bg-white px-4 py-2 border-bottom d-flex align-items-center gap-2 overflow-auto" style="scrollbar-width: none;">
            <button
                class="btn btn-sm btn-light border d-flex align-items-center gap-2 rounded-pill px-3 text-nowrap"
                t-att-class="{ 'active fw-bold text-dark border-primary bg-light': !state.activeCatId &amp;&amp; !state.searching &amp;&amp; !state.activeArticleId }"
                t-on-click="resetToWelcome"
            >
                <i class="fa fa-map-o text-primary"/>
                <span>Workflows &amp; Diagrams</span>
            </button>

            <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                <button
                    class="btn btn-sm btn-light border d-flex align-items-center gap-2 rounded-pill px-3 text-nowrap"
                    t-att-class="{ 'active fw-bold text-dark border-primary bg-light': state.activeCatId === cat.id }"
                    t-on-click="() => this.selectCategory(cat.id)"
                >
                    <i t-att-class="'fa ' + cat.icon" t-att-style="'color:' + cat.color"/>
                    <span t-esc="cat.name"/>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill ms-1" t-esc="cat.article_count"/>
                </button>
            </t>
        </div>

        <!-- Main -->
        <main class="dg-help-main flex-grow-1 overflow-auto">

            <!-- Welcome screen (no category, no search) -->
            <t t-if="!state.activeCatId &amp;&amp; !state.searching &amp;&amp; !state.activeArticleId">
                <div class="dg-help-welcome-container">
                    
                    <!-- Welcome Hero -->
                    <div class="dg-help-welcome-hero">
                        <div class="dg-help-welcome-logo">
                            <i class="fa fa-shield"/>
                        </div>
                        <h2>How can we help you?</h2>
                        <p>Search for specific guides above, browse core categories, or explore our interactive operational flows.</p>
                    </div>

                    <!-- Interactive Lifecycles &amp; Operational Flows -->
                    <div class="dg-help-flows-section">
                        <div class="dg-help-section-header">
                            <h3><i class="fa fa-map me-2 text-primary"/> Interactive Platform Lifecycles &amp; Flows</h3>
                            <p class="text-muted">Select an operational flow below to see step-by-step lifecycles and technical execution guidelines.</p>
                        </div>

                        <!-- Flow Tabs -->
                        <div class="dg-flow-tabs">
                            <button t-foreach="flows" t-as="flow" t-key="flow.id"
                                    t-att-class="'dg-flow-tab-btn ' + (state.activeFlowId === flow.id ? 'active' : '')"
                                    t-on-click="() => this.selectFlowTab(flow.id)">
                                <i t-att-class="'fa ' + flow.icon + ' me-2'"/> <span t-esc="flow.title"/>
                            </button>
                        </div>

                        <!-- Active Flow Content -->
                        <t t-set="activeFlow" t-value="flows.find(f => f.id === state.activeFlowId)"/>
                        <t t-if="activeFlow">
                            <div class="dg-flow-body">
                                <p class="dg-flow-description" t-esc="activeFlow.description"/>

                                <!-- Timeline/Stepper -->
                                <div class="dg-flow-timeline">
                                    <div t-foreach="activeFlow.steps" t-as="step" t-key="step_index"
                                         t-att-class="'dg-timeline-step ' + (state.activeStepIdx === step_index ? 'active' : '')"
                                         t-on-click="() => this.selectFlowStep(step_index)">
                                        <div class="dg-step-circle">
                                            <t t-esc="step_index + 1"/>
                                        </div>
                                        <div class="dg-step-title" t-esc="step.title"/>
                                    </div>
                                </div>

                                <!-- Step Detail Panel with Beginner / Technical Switcher -->
                                <t t-set="activeStep" t-value="activeFlow.steps[state.activeStepIdx]"/>
                                <t t-if="activeStep">
                                    <div class="dg-step-detail-card" t-att-style="'border-top: 4px solid ' + activeFlow.color">
                                        
                                        <!-- Header of the detail card -->
                                        <div class="dg-step-detail-header">
                                            <div class="dg-step-header-meta">
                                                <span class="dg-step-num-badge" t-att-style="'background:' + activeFlow.color">Step <t t-esc="state.activeStepIdx + 1"/></span>
                                                <h4 t-esc="activeStep.title"/>
                                            </div>
                                            
                                            <!-- Toggle: Beginner vs Technical -->
                                            <div class="dg-view-toggle">
                                                <button t-att-class="'toggle-btn ' + (!state.technicalView ? 'active' : '')"
                                                        t-on-click="() => this.toggleTechnicalView(false)">
                                                    <i class="fa fa-user-circle me-1"/> Beginner View
                                                </button>
                                                <button t-att-class="'toggle-btn ' + (state.technicalView ? 'active' : '')"
                                                        t-on-click="() => this.toggleTechnicalView(true)">
                                                    <i class="fa fa-code me-1"/> Technical / Dev View
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Content Body based on Toggle -->
                                        <div class="dg-step-detail-body">
                                            
                                            <!-- BEGINNER VIEW -->
                                            <t t-if="!state.technicalView">
                                                <div class="dg-beginner-panel">
                                                    <p class="dg-step-explanation" t-esc="activeStep.beginner"/>
                                                    
                                                    <div class="dg-step-grid-info">
                                                        <div class="dg-info-block">
                                                            <h5><i class="fa fa-mouse-pointer text-primary me-2"/> Key UI Actions</h5>
                                                            <p class="info-text" t-esc="activeStep.ui_action"/>
                                                        </div>
                                                        <div class="dg-info-block">
                                                            <h5><i class="fa fa-id-badge text-primary me-2"/> Target Operational Role</h5>
                                                            <p class="info-text" t-esc="activeStep.role"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>

                                            <!-- TECHNICAL VIEW -->
                                            <t t-if="state.technicalView">
                                                <div class="dg-technical-panel">
                                                    <div class="dg-info-block-full">
                                                        <h5><i class="fa fa-database text-warning me-2"/> Database Model</h5>
                                                        <code class="technical-code"><t t-esc="activeStep.model"/></code>
                                                    </div>

                                                    <div class="dg-step-grid-info mt-3">
                                                        <div class="dg-info-block">
                                                            <h5><i class="fa fa-toggle-on text-warning me-2"/> Fields &amp; State Transitions</h5>
                                                            <p class="info-text" t-esc="activeStep.states"/>
                                                        </div>
                                                        <div class="dg-info-block">
                                                            <h5><i class="fa fa-cogs text-warning me-2"/> Core Logic &amp; Methods</h5>
                                                            <pre class="technical-pre"><t t-esc="activeStep.logic"/></pre>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>

                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>

                    </div>

                    <!-- Categories Grid (Standard Categories) -->
                    <div class="dg-help-welcome-categories-section">
                        <div class="dg-help-section-header">
                            <h3><i class="fa fa-folder-open-o me-2 text-primary"/> Browse Knowledge Base by Category</h3>
                        </div>
                        <div class="dg-help-cat-grid">
                            <button
                                t-foreach="state.categories"
                                t-as="cat"
                                t-key="cat.id"
                                class="dg-help-cat-tile"
                                t-on-click="() => this.selectCategory(cat.id)"
                            >
                                <div class="dg-help-cat-tile-icon" t-att-style="'background:' + cat.color">
                                    <i t-att-class="'fa ' + cat.icon"/>
                                </div>
                                <div class="dg-help-cat-tile-name" t-esc="cat.name"/>
                                <div class="dg-help-cat-tile-count"><t t-esc="cat.article_count"/> articles</div>
                            </button>
                        </div>
                    </div>

                </div>
            </t>

            <!-- Search results -->
            <t t-if="state.searching">
                <div class="dg-help-search-results">
                    <h2>
                        <t t-if="state.searchResults.length">
                            <t t-esc="state.searchResults.length"/> result(s) for "<t t-esc="state.searchQuery"/>"
                        </t>
                        <t t-else="">
                            No results for "<t t-esc="state.searchQuery"/>"
                        </t>
                    </h2>
                    <t t-if="state.searchResults.length">
                        <button
                            t-foreach="state.searchResults"
                            t-as="art"
                            t-key="art.id"
                            class="dg-help-article-card"
                            t-on-click="() => this.openArticle(art.id)"
                        >
                            <span class="dg-help-card-arrow"><i class="fa fa-chevron-right"/></span>
                            <h3 t-esc="art.title"/>
                            <p t-esc="art.summary"/>
                        </button>
                    </t>
                    <t t-else="">
                        <div class="dg-help-empty">
                            <i class="fa fa-search"/>
                            <span>Try different keywords or browse the categories</span>
                        </div>
                    </t>
                </div>
            </t>

            <!-- Article list for selected category -->
            <t t-if="state.activeCatId &amp;&amp; !state.activeArticleId &amp;&amp; !state.searching">
                <div class="dg-help-article-list">
                    <div class="dg-help-article-list-header">
                        <t t-set="activeCat" t-value="state.categories.find(c => c.id === state.activeCatId)"/>
                        <t t-if="activeCat">
                            <span class="dg-help-cat-icon" t-att-style="'background:' + activeCat.color">
                                <i t-att-class="'fa ' + activeCat.icon"/>
                            </span>
                            <h2 t-esc="activeCat.name"/>
                        </t>
                    </div>
                    <t t-if="state.articles.length">
                        <button
                            t-foreach="state.articles"
                            t-as="art"
                            t-key="art.id"
                            class="dg-help-article-card"
                            t-on-click="() => this.openArticle(art.id)"
                        >
                            <span class="dg-help-card-arrow"><i class="fa fa-chevron-right"/></span>
                            <h3 t-esc="art.title"/>
                            <p t-esc="art.summary"/>
                        </button>
                    </t>
                    <t t-else="">
                        <div class="dg-help-empty">
                            <i class="fa fa-file-text-o"/>
                            <span>No articles in this category yet</span>
                        </div>
                    </t>
                </div>
            </t>

            <!-- Article detail -->
            <t t-if="state.activeArticleId">
                <div class="dg-help-article-detail">
                    <button class="dg-help-back-btn" t-on-click="goBack">
                        <i class="fa fa-arrow-left"/> Back
                    </button>
                    <t t-if="state.activeArticle">
                        <div class="dg-help-article-body" t-out="state.activeArticle.body"/>
                    </t>
                    <t t-else="">
                        <div class="dg-help-empty">
                            <i class="fa fa-spinner fa-spin"/>
                            <span>Loading…</span>
                        </div>
                    </t>
                </div>
            </t>

        </main>
    </div>
</t>

</templates>
