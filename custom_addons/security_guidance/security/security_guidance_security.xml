<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_guidance_session_own" model="ir.rule">
        <field name="name">Guidance session: own</field>
        <field name="model_id" ref="model_security_guidance_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_guidance_session_supervisor" model="ir.rule">
        <field name="name">Guidance session: supervisors read all</field>
        <field name="model_id" ref="model_security_guidance_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('security_work.group_work_supervisor'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_guidance_event_own" model="ir.rule">
        <field name="name">Guidance event: own</field>
        <field name="model_id" ref="model_security_guidance_event"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_guidance_event_supervisor" model="ir.rule">
        <field name="name">Guidance event: supervisors read all</field>
        <field name="model_id" ref="model_security_guidance_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('security_work.group_work_supervisor'))]"/>
    </record>
</odoo>
