<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_guidance_flow_list" model="ir.ui.view">
        <field name="name">security.guidance.flow.list</field>
        <field name="model">security.guidance.flow</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="step_count"/>
            </list>
        </field>
    </record>

    <record id="view_guidance_flow_form" model="ir.ui.view">
        <field name="name">security.guidance.flow.form</field>
        <field name="model">security.guidance.flow</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="code"/>
                        <field name="objective"/>
                        <field name="why"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="step_ids">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="instruction"/>
                            <field name="done_check"/>
                        </list>
                        <form>
                            <group>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="instruction"/>
                                <field name="why"/>
                                <field name="success_message"/>
                                <field name="deviation_hint"/>
                            </group>
                            <group string="How DeployGuard knows">
                                <field name="where_json"/>
                                <field name="target_json"/>
                                <field name="done_ui_json"/>
                                <field name="done_check"/>
                            </group>
                            <field name="help_html"/>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_guidance_event_list" model="ir.ui.view">
        <field name="name">security.guidance.event.list</field>
        <field name="model">security.guidance.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="flow_id"/>
                <field name="step_id"/>
                <field name="kind"/>
                <field name="detail" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_guidance_event_pivot" model="ir.ui.view">
        <field name="name">security.guidance.event.pivot</field>
        <field name="model">security.guidance.event</field>
        <field name="arch" type="xml">
            <pivot string="Where people need help">
                <field name="step_id" type="row"/>
                <field name="kind" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_guidance_flow" model="ir.actions.act_window">
        <field name="name">Guided Tasks</field>
        <field name="res_model">security.guidance.flow</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_guidance_event" model="ir.actions.act_window">
        <field name="name">Where People Need Help</field>
        <field name="res_model">security.guidance.event</field>
        <field name="view_mode">pivot,list</field>
        <field name="help" type="html">
            <p>Which guided steps people go off track on or ask for help with. Use it to improve training and instructions, not to judge people.</p>
        </field>
    </record>

    <menuitem id="menu_guidance_root" name="Guided Tasks" parent="security_work.menu_security_work_root" sequence="60" groups="security_work.group_work_supervisor"/>
    <menuitem id="menu_guidance_flow" name="Flows" parent="menu_guidance_root" action="action_guidance_flow" sequence="10"/>
    <menuitem id="menu_guidance_event" name="Where People Need Help" parent="menu_guidance_root" action="action_guidance_event" sequence="20"/>
</odoo>
