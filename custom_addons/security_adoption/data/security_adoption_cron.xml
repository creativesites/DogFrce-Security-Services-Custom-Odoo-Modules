<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_adoption_materialize" model="ir.cron">
            <field name="name">Adoption: materialize expected work items</field>
            <field name="model_id" ref="model_security_adoption_expected_work_item"/>
            <field name="state">code</field>
            <field name="code">model.action_materialize_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="cron_adoption_snapshot" model="ir.cron">
            <field name="name">Adoption: compute score snapshots</field>
            <field name="model_id" ref="model_security_adoption_snapshot"/>
            <field name="state">code</field>
            <field name="code">model.action_compute_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="cron_adoption_baseline" model="ir.cron">
            <field name="name">Adoption: compute silent-abandonment baselines</field>
            <field name="model_id" ref="model_security_adoption_baseline"/>
            <field name="state">code</field>
            <field name="code">model.action_compute_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="cron_adoption_detect_signals" model="ir.cron">
            <field name="name">Adoption: detect silent-abandonment signals</field>
            <field name="model_id" ref="model_security_adoption_abandonment_signal"/>
            <field name="state">code</field>
            <field name="code">model.action_detect_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
