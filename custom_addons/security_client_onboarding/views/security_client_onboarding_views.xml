<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         Client Onboarding Wizard — 5-step form
    ════════════════════════════════════════════════════════════════════ -->

    <record id="view_security_client_onboarding_wizard_form" model="ir.ui.view">
        <field name="name">security.client.onboarding.wizard.form</field>
        <field name="model">security.client.onboarding.wizard</field>
        <field name="arch" type="xml">
            <form string="Set up a new client" class="dgs-onboarding">
                <sheet class="dgs-onboarding__sheet">

                    <div class="dgs-onboarding__head">
                        <h1 class="dgs-onboarding__title">Set up a new client</h1>
                        <p class="dgs-onboarding__subtitle">
                            Five steps from a new client to a roster you can generate.
                            Nothing is saved until the last step.
                        </p>
                    </div>

                    <field name="step" widget="statusbar"
                           statusbar_visible="1_client,2_sites,3_requirements,4_billing,5_confirm"
                           readonly="1"/>

                    <field name="is_ready" invisible="1"/>
                    <field name="client_display_name" invisible="1"/>

                    <!-- ══ Step 1 — Client ══ -->
                    <div invisible="step != '1_client'" class="dgs-onboarding__step">
                        <p class="dgs-onboarding__hint">
                            Who is the client? Pick one that already exists, or enter a new one.
                        </p>
                        <group>
                            <group string="Existing client">
                                <field name="existing_partner_id" placeholder="Search clients…"
                                       options="{'no_create': True}"/>
                            </group>
                            <group string="Or a new client"
                                   invisible="existing_partner_id != False">
                                <field name="new_partner_name" placeholder="Company name"
                                       required="not existing_partner_id"/>
                                <field name="new_partner_email" placeholder="accounts@client.com"/>
                                <field name="new_partner_phone" placeholder="+264 …"/>
                                <field name="new_partner_street" placeholder="Physical address"/>
                            </group>
                        </group>
                        <group>
                            <field name="contract_start"/>
                        </group>
                    </div>

                    <!-- ══ Step 2 — Sites ══ -->
                    <div invisible="step != '2_sites'" class="dgs-onboarding__step">
                        <p class="dgs-onboarding__hint">
                            Where will guards be deployed? Add one row per site. You can add
                            more sites later without re-running this.
                        </p>
                        <field name="site_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="site_name" placeholder="e.g. Head Office"/>
                                <field name="code" placeholder="e.g. HQ"/>
                                <field name="location" placeholder="Physical address"/>
                            </list>
                        </field>
                    </div>

                    <!-- ══ Step 3 — Shift requirements ══ -->
                    <div invisible="step != '3_requirements'" class="dgs-onboarding__step">
                        <p class="dgs-onboarding__hint">
                            What must be guarded, and when? Each row is a standing requirement:
                            <em>this many guards, at this post, on this shift</em>. The roster is
                            generated from these rows.
                        </p>
                        <field name="requirement_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="site_line_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="post_type_id" options="{'no_open': True}"/>
                                <field name="shift_template_id" options="{'no_open': True}"/>
                                <field name="guard_count" sum="Guards per day"/>
                                <field name="bill_rate"/>
                                <field name="pay_rate"/>
                            </list>
                        </field>
                        <p class="dgs-onboarding__note">
                            Rates can be left at zero for now — you will still be able to roster.
                            Billing and payroll will flag them as incomplete until they are set.
                        </p>
                    </div>

                    <!-- ══ Step 4 — Billing ══ -->
                    <div invisible="step != '4_billing'" class="dgs-onboarding__step">
                        <p class="dgs-onboarding__hint">
                            How is this client invoiced? A billing plan is created with these
                            settings; you can change any of it afterwards.
                        </p>
                        <group>
                            <group>
                                <field name="billing_mode"/>
                                <field name="billing_start"/>
                            </group>
                            <group>
                                <field name="billing_payment_term_days"/>
                                <field name="billing_vat_rate"/>
                            </group>
                        </group>
                    </div>

                    <!-- ══ Step 5 — Review ══ -->
                    <div invisible="step != '5_confirm'" class="dgs-onboarding__step">
                        <p class="dgs-onboarding__hint">
                            This is everything that will be created. Nothing has been saved yet.
                        </p>

                        <!-- One panel, two meanings: `blocking_html` carries its
                             own lead sentence, and the status strip above it says
                             whether this is a blocker or just worth knowing. -->
                        <div class="dgs-onboarding__panel" invisible="not blocking_html">
                            <div class="dgs-onboarding__status dgs-onboarding__status--blocking"
                                 invisible="is_ready">
                                <i class="fa fa-exclamation-circle me-2" title="Not ready"/>Not ready yet
                            </div>
                            <div class="dgs-onboarding__status dgs-onboarding__status--ok"
                                 invisible="not is_ready">
                                <i class="fa fa-check-circle me-2" title="Ready"/>Ready to create
                            </div>
                            <field name="blocking_html" nolabel="1" readonly="1"/>
                        </div>

                        <div class="dgs-onboarding__panel dgs-onboarding__panel--summary">
                            <field name="summary_html" nolabel="1" readonly="1"/>
                        </div>

                        <group>
                            <field name="generate_first_roster"/>
                            <field name="roster_month" invisible="not generate_first_roster"/>
                        </group>
                    </div>

                    <!-- Running totals, visible from step 2 onwards so the user
                         always knows what they have built so far. -->
                    <div class="dgs-onboarding__tally" invisible="step == '1_client'">
                        <span><field name="site_count" nolabel="1" readonly="1"/> site(s)</span>
                        <span><field name="requirement_count" nolabel="1" readonly="1"/> shift requirement(s)</span>
                        <span><field name="total_guards" nolabel="1" readonly="1"/> guard(s) per day</span>
                    </div>

                </sheet>

                <footer>
                    <button name="action_back" type="object" string="Back"
                            class="btn-secondary" invisible="step == '1_client'"/>
                    <button name="action_next" type="object" string="Continue"
                            class="btn-primary" invisible="step == '5_confirm'"/>
                    <button name="action_confirm" type="object" string="Create client"
                            class="btn-primary" invisible="step != '5_confirm'"
                            readonly="not is_ready"/>
                    <button special="cancel" string="Cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         Roster Setup Health Check Wizard
    ════════════════════════════════════════════════════════════════════ -->

    <record id="view_security_roster_setup_wizard_form" model="ir.ui.view">
        <field name="name">security.roster.setup.wizard.form</field>
        <field name="model">security.roster.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Roster Setup Health Check">
                <sheet>
                    <div class="alert alert-info mb-3" role="status" invisible="issue_ids != []">
                        <i class="fa fa-check-circle me-2" title="All clear"/>
                        <strong>All checks passed.</strong> Your roster configuration looks healthy.
                    </div>
                    <div class="alert alert-warning mb-3" role="alert" invisible="issue_ids == []">
                        <i class="fa fa-exclamation-triangle me-2" title="Issues found"/>
                        <strong><field name="issue_count" nolabel="1" readonly="1"/> issue(s) found.</strong>
                        Review and resolve each item below.
                    </div>

                    <field name="issue_ids" nolabel="1" readonly="1">
                        <list decoration-danger="severity == 'critical'"
                              decoration-warning="severity == 'warning'">
                            <field name="severity" widget="badge"
                                   decoration-danger="severity == 'critical'"
                                   decoration-warning="severity == 'warning'"/>
                            <field name="category" string="Area"/>
                            <field name="title" string="Issue"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_run_check" type="object" string="Run Check"
                            class="btn-primary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions -->

    <record id="action_security_client_onboarding_wizard" model="ir.actions.act_window">
        <field name="name">Onboard New Client</field>
        <field name="res_model">security.client.onboarding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_security_roster_setup_wizard" model="ir.actions.act_window">
        <field name="name">Roster Setup Health Check</field>
        <field name="res_model">security.roster.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu items (Operations > Roster section &amp; Clients &amp; Sites section) -->

    <record id="action_security_client_partner" model="ir.actions.act_window">
        <field name="name">Client Companies</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_company', '=', True)]</field>
        <field name="context">{'default_is_company': True, 'default_customer_rank': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a Client Company!
            </p>
            <p>
                Manage client profiles, contact persons, sites, contracts, and billing plans.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_security_client_partner"
        name="Client Companies"
        parent="security_operations.menu_security_billing_root"
        action="action_security_client_partner"
        sequence="1"
        groups="hr.group_hr_user,security_base.group_security_supervisor"
    />

    <!-- The primary CTA: sequence 0 puts this above every other entry in
         the Clients & Sites menu, per docs/ROSTERING_SIMPLIFICATION_PLAN.md
         Task 3. This is the one supported way to onboard a new client. -->
    <menuitem
        id="menu_security_client_onboarding"
        name="Set up a new client"
        parent="security_operations.menu_security_billing_root"
        action="action_security_client_onboarding_wizard"
        sequence="0"
        groups="hr.group_hr_user,security_base.group_security_supervisor"
    />

    <menuitem
        id="menu_security_roster_setup_check"
        name="Roster Setup Check"
        parent="security_operations.menu_security_roster"
        action="action_security_roster_setup_wizard"
        sequence="36"
        groups="hr.group_hr_user,security_base.group_security_supervisor"
    />

    <menuitem
        id="menu_security_client_onboarding_ops"
        name="Set up a new client"
        parent="security_operations.menu_security_roster"
        action="action_security_client_onboarding_wizard"
        sequence="37"
        groups="hr.group_hr_user,security_base.group_security_supervisor"
    />

</odoo>
