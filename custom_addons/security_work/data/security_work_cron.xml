<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_security_work_materialize" model="ir.cron">
            <field name="name">Work: materialize recurring tasks</field>
            <field name="model_id" ref="model_security_work_schedule_rule"/>
            <field name="state">code</field>
            <field name="code">model.action_materialize_all()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="cron_security_work_overdue_sweep" model="ir.cron">
            <field name="name">Work: sweep overdue tasks</field>
            <field name="model_id" ref="model_security_work_task"/>
            <field name="state">code</field>
            <field name="code">model.action_sweep_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="cron_security_work_purge_evidence" model="ir.cron">
            <field name="name">Work: purge old evidence attachments</field>
            <field name="model_id" ref="model_security_work_checklist_response"/>
            <field name="state">code</field>
            <field name="code">model.action_purge_old_evidence()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
