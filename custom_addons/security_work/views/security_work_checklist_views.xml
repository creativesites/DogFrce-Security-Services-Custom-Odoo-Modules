<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_work_checklist_template_list" model="ir.ui.view">
        <field name="name">security.work.checklist.template.list</field>
        <field name="model">security.work.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="item_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_security_work_checklist_template_form" model="ir.ui.view">
        <field name="name">security.work.checklist.template.form</field>
        <field name="model">security.work.checklist.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Site Visit Inspection"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Items">
                        <field name="item_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="label"/>
                                <field name="item_type"/>
                                <field name="required"/>
                                <field name="help_text"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_security_work_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">security.work.checklist.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Build your first checklist template.</p></field>
    </record>
</odoo>
