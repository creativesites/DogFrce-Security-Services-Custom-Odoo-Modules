<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Reconciliation Rule for Billing <-> Account -->
        <record id="rule_billing_account_invoice" model="security.reconciliation.rule">
            <field name="name">Invoice Reconciliation (DeployGuard &lt;-&gt; Accounting)</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="adapter_code">billing_account_invoice</field>
            <field name="source_model">security.billing.invoice</field>
            <field name="target_model">account.move</field>
            <field name="sync_direction">bidirectional</field>
            <field name="sync_mode">queued</field>
            <field name="conflict_policy">manual</field>
            <field name="handler_model">security.reconciliation.billing.adapter</field>
            <field name="handler_method">_process_reconciliation_job</field>
            <field name="max_attempts">5</field>
            <field name="retry_delay_minutes">5</field>
            <field name="notes">Reconciles custom DeployGuard invoices, client payments, and credit notes with standard Odoo account.move and account.payment records.</field>
        </record>

        <!-- Cron for Nightly Billing Sweep -->
        <record id="ir_cron_reconciliation_billing_sweep" model="ir.cron">
            <field name="name">Reconciliation: Billing &amp; Accounting Nightly Sweep</field>
            <field name="model_id" ref="model_security_reconciliation_billing_adapter"/>
            <field name="state">code</field>
            <field name="code">model._cron_reconciliation_billing_sweep()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
