<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_billing_invoice_reconciliation_form" model="ir.ui.view">
        <field name="name">security.billing.invoice.reconciliation.form</field>
        <field name="model">security.billing.invoice</field>
        <field name="inherit_id" ref="security_billing.view_security_billing_invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_view_odoo_invoice"
                        string="View Odoo Invoice"
                        type="object"
                        class="btn btn-outline-primary"
                        invisible="not move_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Accounting Reconciliation" name="reconciliation_info">
                    <group>
                        <group string="Linked Accounting Move">
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
