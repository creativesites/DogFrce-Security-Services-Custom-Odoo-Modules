<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Primary Operational Roster Workbench: Detailed Post & Guard Grid with multi-filters -->
    <record id="action_roster_board" model="ir.actions.client">
        <field name="name">📅 Roster Workbench</field>
        <field name="tag">security_shift_planner.roster_board</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_roster_board"
        name="📅 Roster Workbench"
        parent="security_operations.menu_security_roster"
        action="action_roster_board"
        sequence="1"
        groups="security_base.group_security_supervisor,security_base.group_security_manager,hr.group_hr_user"
    />

    <!-- 2. Site Coverage Matrix: High-level site fulfillment matrix across 21st-20th cycle -->
    <record id="action_roster_cycle" model="ir.actions.client">
        <field name="name">🏢 Site Coverage Matrix</field>
        <field name="tag">security_shift_planner.roster_cycle</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_roster_cycle"
        name="🏢 Site Coverage Matrix"
        parent="security_operations.menu_security_roster"
        action="action_roster_cycle"
        sequence="2"
        groups="security_base.group_security_supervisor,security_base.group_security_manager,hr.group_hr_user"
    />

    <!-- 3. Auto-Rostering Engine — Automated shift generation & intelligent guard allocation -->
    <record id="action_autorostering_dashboard" model="ir.actions.client">
        <field name="name">🤖 Auto-Roster Engine</field>
        <field name="tag">security_shift_planner.autorostering_dashboard</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_autorostering_dashboard"
        name="🤖 Auto-Roster Engine"
        parent="security_operations.menu_security_roster"
        action="action_autorostering_dashboard"
        sequence="3"
        groups="security_base.group_security_supervisor,security_base.group_security_manager,hr.group_hr_user"
    />

    <!-- Operational quick link in Operations root menu -->
    <menuitem
        id="menu_operations_autoroster_dashboard"
        name="Auto-Roster Engine"
        parent="security_operations.menu_security_operations_root"
        action="action_autorostering_dashboard"
        sequence="7"
        groups="security_base.group_security_supervisor"
    />

    <!-- 4. Weekly Check-in: Ops review, signoffs, and attendance reconciliation -->
    <record id="action_weekly_checkin" model="ir.actions.client">
        <field name="name">📋 Weekly Check-in</field>
        <field name="tag">security_shift_planner.weekly_checkin</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_weekly_checkin"
        name="📋 Weekly Check-in"
        parent="security_operations.menu_security_roster"
        action="action_weekly_checkin"
        sequence="4"
        groups="security_base.group_security_supervisor,security_base.group_security_manager,hr.group_hr_user"
    />
</odoo>
