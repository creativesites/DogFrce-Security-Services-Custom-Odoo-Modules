<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Auto-Rostering Dashboard — Automated shift generation & intelligent guard allocation -->
    <record id="action_autorostering_dashboard" model="ir.actions.client">
        <field name="name">🤖 Auto-Rostering Center</field>
        <field name="tag">security_shift_planner.autorostering_dashboard</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_autorostering_dashboard"
        name="🤖 Auto-Roster Engine"
        parent="security_operations.menu_security_roster"
        action="action_autorostering_dashboard"
        sequence="0"
        groups="hr.group_hr_user"
    />

    <!-- Operational quick link in Operations root menu -->
    <menuitem
        id="menu_operations_autoroster_dashboard"
        name="Auto-Roster Engine"
        parent="security_operations.menu_security_operations_root"
        action="action_autorostering_dashboard"
        sequence="7"
        groups="security_base.group_security_supervisor"
    />

    <!-- Rostering Mega Menu — Executive Command Center (sequence 1) -->
    <record id="action_rostering_mega_menu" model="ir.actions.client">
        <field name="name">⚡ Rostering Mega Menu</field>
        <field name="tag">security_shift_planner.rostering_mega_menu</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_rostering_mega_menu"
        name="⚡ Mega Menu"
        parent="security_operations.menu_security_roster"
        action="action_rostering_mega_menu"
        sequence="1"
        groups="hr.group_hr_user"
    />

    <!-- Rostering Hub — primary rostering workspace (sequence 1 = second in menu) -->
    <record id="action_rostering_hub" model="ir.actions.client">
        <field name="name">Rostering Hub</field>
        <field name="tag">security_shift_planner.rostering_hub</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_rostering_hub"
        name="Rostering Hub"
        parent="security_operations.menu_security_roster"
        action="action_rostering_hub"
        sequence="1"
        groups="hr.group_hr_user"
    />

    <!-- Roster Board — legacy kanban/drag-drop view -->
    <record id="action_roster_board" model="ir.actions.client">
        <field name="name">Roster Board</field>
        <field name="tag">security_shift_planner.roster_board</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_roster_board"
        name="Roster Board"
        parent="security_operations.menu_security_roster"
        action="action_roster_board"
        sequence="2"
        groups="hr.group_hr_user"
    />

    <record id="action_weekly_checkin" model="ir.actions.client">
        <field name="name">Weekly Check-in</field>
        <field name="tag">security_shift_planner.weekly_checkin</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_weekly_checkin"
        name="Weekly Check-in"
        parent="security_operations.menu_security_roster"
        action="action_weekly_checkin"
        sequence="3"
        groups="hr.group_hr_user"
    />
</odoo>
