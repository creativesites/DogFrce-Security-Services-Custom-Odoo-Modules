<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="security_shift_planner.DemandPlanningModal" owl="1">
    <div class="modal d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); z-index: 1060;">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: #ffffff;">
                
                <!-- Modal Header -->
                <div class="modal-header border-bottom px-4 py-3 bg-slate-900 text-white d-flex align-items-center justify-content-between" style="background: #0f172a;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-3 p-2 d-flex align-items-center justify-content-center" style="background: rgba(139, 92, 246, 0.2); color: #c084fc;">
                            <i class="fa fa-calculator fa-lg"/>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 text-white" style="font-size: 16px;">
                                Executive Demand Planning &amp; Deployment Estimator
                            </h5>
                            <div class="text-slate-400" style="font-size: 12px; color: #94a3b8;">
                                Instant contract sizing, headcount relief factors, equipment provisioning, and P&amp;L projection
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" t-on-click="props.closeModal"/>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4" style="max-height: 80vh; overflow-y: auto;">
                    <div class="row g-4">
                        
                        <!-- Left Column: Parameters Input -->
                        <div class="col-lg-5 border-end pe-lg-4">
                            <h6 class="fw-bold text-slate-900 mb-3" style="font-size: 14px;">
                                <i class="fa fa-sliders text-primary me-2"/>1. Contract &amp; Shift Parameters
                            </h6>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Contract Plan Reference</label>
                                <input type="text" class="form-control form-control-sm" t-model="state.title" t-on-input="() => this.calculate()"/>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Target Client</label>
                                    <select class="form-select form-select-sm" t-model="state.partnerId">
                                        <t t-foreach="state.partners" t-as="p" t-key="p.id">
                                            <option t-att-value="p.id" t-esc="p.name"/>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Proposed Site Name</label>
                                    <input type="text" class="form-control form-control-sm" t-model="state.siteName"/>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Site Sector</label>
                                    <select class="form-select form-select-sm" t-model="state.siteType" t-on-change="() => this.calculate()">
                                        <option value="mining">Mining / Heavy Industrial</option>
                                        <option value="industrial">Factory / Warehouse</option>
                                        <option value="commercial">Commercial Office</option>
                                        <option value="residential">Residential Estate</option>
                                        <option value="retail">Retail Mall</option>
                                        <option value="embassy">Embassy / High Security</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Simultaneous Guard Posts</label>
                                    <input type="number" class="form-control form-control-sm fw-bold text-primary" t-model="state.postsCount" t-on-input="() => this.calculate()"/>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Operating Schedule</label>
                                    <select class="form-select form-select-sm" t-model="state.operatingSchedule" t-on-change="() => this.calculate()">
                                        <option value="24_7">24/7 Continuous (168h/wk)</option>
                                        <option value="day_12">Day Only - 12h x 7 Days</option>
                                        <option value="night_12">Night Only - 12h x 7 Days</option>
                                        <option value="business_8">Standard - 8h x 5 Days</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Shift Duration</label>
                                    <select class="form-select form-select-sm" t-model="state.shiftDuration" t-on-change="() => this.calculate()">
                                        <option value="12h">12-Hour Shifts</option>
                                        <option value="8h">8-Hour Shifts</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Guard Shift Rotation</label>
                                    <select class="form-select form-select-sm" t-model="state.rotationPattern" t-on-change="(e) => this.onRotationPatternChange(e.target.value)">
                                        <option value="2_2_2">2 Day / 2 Night / 2 Off</option>
                                        <option value="4_2">4 Days On / 2 Days Off</option>
                                        <option value="6_1">6 Days On / 1 Day Off</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Relief Coverage Multiplier</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm text-primary fw-semibold" t-model="state.reliefFactor" t-on-input="() => this.calculate()"/>
                                </div>
                            </div>

                            <h6 class="fw-bold text-slate-900 mt-4 mb-3" style="font-size: 14px;">
                                <i class="fa fa-money text-success me-2"/>2. Financial Rates (ZMW)
                            </h6>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Post Bill Rate / Hr</label>
                                    <input type="number" step="0.5" class="form-control form-control-sm fw-bold text-success" t-model="state.billRate" t-on-input="() => this.calculate()"/>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Guard Monthly Pay</label>
                                    <input type="number" step="100" class="form-control form-control-sm" t-model="state.guardPay" t-on-input="() => this.calculate()"/>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Supervisor Monthly Pay</label>
                                    <input type="number" step="100" class="form-control form-control-sm" t-model="state.supervisorPay" t-on-input="() => this.calculate()"/>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Vehicle Monthly Cost</label>
                                    <input type="number" step="500" class="form-control form-control-sm" t-model="state.vehicleCost" t-on-input="() => this.calculate()"/>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Live Executive Deployment Projection -->
                        <div class="col-lg-7 ps-lg-4">
                            <h6 class="fw-bold text-slate-900 mb-3" style="font-size: 14px;">
                                <i class="fa fa-bolt text-warning me-2"/>3. Live Deployment &amp; Profitability Projection
                            </h6>

                            <!-- Headline Cards -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <div class="p-3 rounded-3 border" style="background: #f8fafc; border-color: #cbd5e1 !important;">
                                        <div class="text-uppercase fw-semibold" style="font-size: 10px; color: #64748b;">Total Headcount Needed</div>
                                        <div class="d-flex align-items-baseline gap-2 mt-1">
                                            <span class="fw-bold text-primary" style="font-size: 28px;" t-esc="state.results.neededGuards"/>
                                            <span class="text-muted fw-semibold">Guards</span>
                                            <span class="ms-auto text-info fw-bold" style="font-size: 18px;" t-esc="'+ ' + state.results.neededSupervisors"/>
                                            <span class="text-muted small">Sups</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 rounded-3 border" style="background: #f0fdf4; border-color: #bbf7d0 !important;">
                                        <div class="text-uppercase fw-semibold" style="font-size: 10px; color: #166534;">Projected Monthly Profit</div>
                                        <div class="d-flex align-items-baseline gap-2 mt-1">
                                            <span class="fw-bold text-success" style="font-size: 24px;">ZMW <t t-esc="state.results.monthlyProfit.toLocaleString()"/></span>
                                            <span class="badge bg-success text-white ms-auto" style="font-size: 12px;" t-esc="state.results.grossMarginPct + '% Margin'"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Resource Breakdown Matrix -->
                            <div class="p-3 mb-4 rounded-3 border bg-light">
                                <div class="fw-bold text-slate-900 mb-2" style="font-size: 13px;">
                                    Instant Operational Asset Provisioning
                                </div>
                                <div class="row row-cols-2 row-cols-md-3 g-2">
                                    <div class="p-2 bg-white rounded border d-flex align-items-center gap-2">
                                        <i class="fa fa-car text-primary"/>
                                        <div>
                                            <div class="fw-bold" t-esc="state.results.neededVehicles"/>
                                            <div class="text-muted" style="font-size: 10px;">Patrol Vehicles</div>
                                        </div>
                                    </div>
                                    <div class="p-2 bg-white rounded border d-flex align-items-center gap-2">
                                        <i class="fa fa-walkie-talkie text-info"/>
                                        <div>
                                            <div class="fw-bold" t-esc="state.results.neededRadios"/>
                                            <div class="text-muted" style="font-size: 10px;">Two-Way Radios</div>
                                        </div>
                                    </div>
                                    <div class="p-2 bg-white rounded border d-flex align-items-center gap-2">
                                        <i class="fa fa-bolt text-warning"/>
                                        <div>
                                            <div class="fw-bold" t-esc="state.results.neededTorches"/>
                                            <div class="text-muted" style="font-size: 10px;">Torches/Flashlights</div>
                                        </div>
                                    </div>
                                    <div class="p-2 bg-white rounded border d-flex align-items-center gap-2">
                                        <i class="fa fa-video text-danger"/>
                                        <div>
                                            <div class="fw-bold" t-esc="state.results.neededBodycams"/>
                                            <div class="text-muted" style="font-size: 10px;">Body Cameras</div>
                                        </div>
                                    </div>
                                    <div class="p-2 bg-white rounded border d-flex align-items-center gap-2">
                                        <i class="fa fa-vest text-secondary"/>
                                        <div>
                                            <div class="fw-bold" t-esc="state.results.neededUniformKits"/>
                                            <div class="text-muted" style="font-size: 10px;">Uniform Kits</div>
                                        </div>
                                    </div>
                                    <div class="p-2 bg-white rounded border d-flex align-items-center gap-2">
                                        <i class="fa fa-clock-o text-dark"/>
                                        <div>
                                            <div class="fw-bold" t-esc="state.results.monthlyPostHours.toLocaleString()"/>
                                            <div class="text-muted" style="font-size: 10px;">Bill Hours/Mo</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Financial P&amp;L Table -->
                            <div class="table-responsive rounded border">
                                <table class="table table-sm table-striped mb-0" style="font-size: 12px;">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Financial Metric</th>
                                            <th class="text-end">Monthly Value (ZMW)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="fw-semibold">Monthly Bill Revenue</td>
                                            <td class="text-end fw-bold text-success">ZMW <t t-esc="state.results.monthlyRevenue.toLocaleString()"/></td>
                                        </tr>
                                        <tr>
                                            <td>Total Guard &amp; Supervisor Payroll</td>
                                            <td class="text-end text-danger">- ZMW <t t-esc="state.results.monthlyPayroll.toLocaleString()"/></td>
                                        </tr>
                                        <tr>
                                            <td>Equipment &amp; Fleet Operating Cost</td>
                                            <td class="text-end text-danger">- ZMW <t t-esc="state.results.monthlyEquipment.toLocaleString()"/></td>
                                        </tr>
                                        <tr class="table-success fw-bold">
                                            <td>Projected Net Monthly Gross Profit</td>
                                            <td class="text-end text-success fs-6">ZMW <t t-esc="state.results.monthlyProfit.toLocaleString()"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>

                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top px-4 py-3 bg-slate-50 d-flex align-items-center justify-content-between" style="background: #f8fafc;">
                    <span class="small text-slate-500">
                        <i class="fa fa-shield-alt text-primary me-1"/>
                        DogForce Executive Planning Engine
                    </span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary px-3 py-2 fw-semibold" t-on-click="props.closeModal">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-primary px-4 py-2 fw-bold" t-on-click="() => this.saveDemandPlan()" t-att-disabled="state.saving">
                            <i t-att-class="state.saving ? 'fa fa-spinner fa-spin me-2' : 'fa fa-save me-2'"/>
                            Save &amp; Open Full Plan
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</t>

</templates>
