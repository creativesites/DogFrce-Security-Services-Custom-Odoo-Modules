<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="security_shift_planner.RosterCycle" owl="1">
  <div class="rc-root o_action">
    <header class="rc-header">
      <div class="rc-title-row">
        <div>
          <h4 class="rc-title">Roster Board</h4>
          <div class="rc-sub">Operational Cycle (21st to 20th). Interactive site-by-day workbench with live guard allocation.</div>
        </div>
        <div class="rc-cycles">
          <button class="rc-chip" t-att-class="state.showTodayRollCall ? 'active rc-rollcall-active' : ''" t-on-click="() => this.toggleTodayRollCall()" style="font-weight:700;" title="Filter view exclusively to today's roll call and gap dispatch">📋 Today's Roll Call</button>
          <button class="rc-chip" style="background: #2563eb; color: white; font-weight: 600; border-color: #2563eb;" t-on-click="() => this.openSwapModal()" title="One-Click Guard Shift Swap">🔄 Swap Guards</button>
          <t t-foreach="cycles" t-as="c" t-key="c.from">
            <button class="rc-chip" t-att-class="(!state.showTodayRollCall and state.cycle.from === c.from) ? 'active' : ''" t-on-click="() => { this.state.showTodayRollCall = false; this.setCycle(c); }"><t t-esc="c.label"/></button>
          </t>
          <button class="rc-chip" style="background: #0284c7; color: white; font-weight: 600; border-color: #0284c7;" t-on-click="() => this.openScheduleImportWizard()" title="Import Excel Roster to fill and override shifts">📥 Import Excel</button>
        </div>
      </div>

      <div class="rc-summary" t-if="state.data">
        <div class="rc-stat"><div class="rc-num"><t t-esc="state.data.summary.sites"/></div><div class="rc-lbl">Sites</div></div>
        <div class="rc-stat" t-att-class="state.data.summary.unfilled ? 'rc-stat-bad' : ''"><div class="rc-num"><t t-esc="state.data.summary.unfilled"/></div><div class="rc-lbl">Unfilled Shifts</div></div>
        <div class="rc-stat" t-att-class="state.data.summary.clashes ? 'rc-stat-bad' : ''"><div class="rc-num"><t t-esc="state.data.summary.clashes"/></div><div class="rc-lbl">Clashes</div></div>
        <div class="rc-stat"><div class="rc-num"><t t-esc="state.data.summary.slots"/></div><div class="rc-lbl">Total Shifts</div></div>
      </div>

      <div class="rc-filters">
        <input class="rc-search" type="text" placeholder="Search site, client or guard…" t-att-value="state.search" t-on-change="onSearch"/>

        <!-- Site Selector Filter -->
        <select class="rc-select" t-on-change="setSite">
          <option value="all">All Sites</option>
          <t t-foreach="state.sites" t-as="site" t-key="site.id">
            <option t-att-value="site.id" t-att-selected="state.siteId == site.id"><t t-esc="site.name"/></option>
          </t>
        </select>

        <!-- Shift Template Filter -->
        <select class="rc-select" t-on-change="setShiftTemplate">
          <option value="all">All Shifts (Day &amp; Night)</option>
          <t t-foreach="state.shiftTemplates" t-as="st" t-key="st.id">
            <option t-att-value="st.id" t-att-selected="state.shiftTemplate == st.id"><t t-esc="st.name"/></option>
          </t>
        </select>

        <div class="rc-group">
          <t t-foreach="statuses" t-as="s" t-key="s.key">
            <button class="rc-chip" t-att-class="isActive(state.status, s.key)" t-on-click="() => this.setStatus(s.key)"><t t-esc="s.label"/></button>
          </t>
        </div>
        <div class="rc-group">
          <t t-foreach="dayTypes" t-as="d" t-key="d.key">
            <button class="rc-chip" t-att-class="isActive(state.dayType, d.key)" t-on-click="() => this.setDayType(d.key)"><t t-esc="d.label"/></button>
          </t>
        </div>
      </div>
    </header>

    <div class="rc-body" t-if="state.loading and !state.data"><div class="rc-loading">Loading operational roster…</div></div>

    <main class="rc-main" t-if="state.data">
      <!-- ── Today's Roll Call & Live Gap Dispatch Dedicated View ── -->
      <t t-if="state.showTodayRollCall and state.todayRollCallData">
        <div class="rc-rollcall-dashboard p-3 bg-white border rounded-3 mb-3 shadow-sm">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 pb-3 border-bottom">
            <div>
              <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success text-white px-2 py-1" style="font-size:12px; font-weight:700;">🟢 TODAY'S ROLL CALL</span>
                <h4 class="mb-0 fw-bold" style="color:#0f172a;"><t t-esc="state.todayRollCallData.date"/> Shift Deployment</h4>
              </div>
              <div class="text-muted small mt-1">Live operational dispatch status across all client posts.</div>
            </div>

            <!-- KPI Pill Strip -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <div class="rc-stat py-1 px-3">
                <div class="rc-lbl">Total Posts Today</div>
                <div class="rc-num fs-5"><t t-esc="state.todayRollCallData.total"/></div>
              </div>
              <div class="rc-stat py-1 px-3" style="border-color:#bbf7d0; background:#f0fdf4;">
                <div class="rc-lbl text-success">Assigned On Duty</div>
                <div class="rc-num fs-5 text-success"><t t-esc="state.todayRollCallData.assigned"/></div>
              </div>
              <div class="rc-stat py-1 px-3" style="border-color:#fca5a5; background:#fef2f2;">
                <div class="rc-lbl text-danger">Critical Open Gaps</div>
                <div class="rc-num fs-5 text-danger"><t t-esc="state.todayRollCallData.unassigned"/></div>
              </div>
              <div class="rc-stat py-1 px-3">
                <div class="rc-lbl">Fulfillment Rate</div>
                <div class="rc-num fs-5"><t t-esc="state.todayRollCallData.fulfillment_rate"/>%</div>
              </div>
            </div>
          </div>

          <!-- Roll Call Slots Table -->
          <div class="table-responsive mt-3">
            <table class="table table-hover align-middle mb-0" style="font-size:12px;">
              <thead class="table-light">
                <tr>
                  <th style="min-width:180px;">Site / Client</th>
                  <th style="min-width:140px;">Post</th>
                  <th style="min-width:120px;">Shift Time</th>
                  <th style="min-width:240px;">Guard Status</th>
                  <th style="min-width:180px; text-align:right;">One-Click Action</th>
                </tr>
              </thead>
              <tbody>
                <t t-if="!state.todayRollCallData.slots or state.todayRollCallData.slots.length === 0">
                  <tr>
                    <td colspan="5" class="text-center text-muted py-4">No scheduled shifts found for today.</td>
                  </tr>
                </t>
                <t t-foreach="state.todayRollCallData.slots" t-as="slot" t-key="slot.id">
                  <tr t-att-style="'background:' + (slot.employee_id ? '#ffffff' : '#fff5f5')">
                    <td>
                      <div class="fw-bold text-dark"><t t-esc="slot.site_name"/></div>
                      <div class="text-muted small"><t t-esc="slot.client_name"/></div>
                    </td>
                    <td>
                      <div class="fw-semibold text-dark"><t t-esc="slot.post_name"/></div>
                    </td>
                    <td>
                      <div class="badge bg-light text-dark border">
                        <t t-esc="slot.shift_template_name"/> (<t t-esc="slot.start_hour"/>:00–<t t-esc="slot.end_hour"/>:00)
                      </div>
                    </td>
                    <td>
                      <t t-if="slot.employee_id">
                        <div class="d-flex align-items-center gap-2">
                          <span class="badge" style="background:#dcfce7; color:#15803d; font-weight:700;">🟢 ASSIGNED</span>
                          <div>
                            <span class="fw-bold text-dark"><t t-esc="slot.employee_name"/></span>
                            <span t-if="slot.employee_code and slot.employee_code !== '—'" class="badge bg-light text-muted border ms-1"><t t-esc="slot.employee_code"/></span>
                            <span class="badge bg-secondary ms-1"><t t-esc="slot.employee_grade"/></span>
                          </div>
                        </div>
                      </t>
                      <t t-else="">
                        <div class="d-flex align-items-center gap-2">
                          <span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:700;">🔴 UNASSIGNED CRITICAL GAP</span>
                          <span class="text-danger small fst-italic">Requires immediate relief guard dispatch</span>
                        </div>
                      </t>
                    </td>
                    <td class="text-end">
                      <t t-if="slot.employee_id">
                        <button class="btn btn-sm btn-outline-primary py-1 px-2"
                                style="font-size:11px;"
                                t-on-click="() => this.openSwapModal(slot)"
                                title="Swap this guard with another post">
                          <i class="fa fa-exchange me-1"/> Swap Shift
                        </button>
                      </t>
                      <t t-else="">
                        <button class="btn btn-sm btn-danger py-1 px-3 fw-bold shadow-sm"
                                style="font-size:11px;"
                                t-on-click="() => this.openDispatchReliefModal(slot)"
                                title="Open Candidate Pool to dispatch relief guard">
                          <i class="fa fa-life-ring me-1"/> Dispatch Relief Guard
                        </button>
                      </t>
                    </td>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>
        </div>
      </t>

      <!-- ── Standard Multi-Day Cycle Grid Matrix ── -->
      <t t-elif="state.data.rows.length === 0">
        <div class="rc-empty-state">No sites match the selected filters for this cycle.</div>
      </t>
      <t t-elif="state.data.rows.length">
        <div class="rc-grid-wrap">
          <table class="rc-grid">
            <thead>
              <tr>
                <th class="rc-site-col">Site / Client</th>
                <t t-foreach="state.data.days" t-as="day" t-key="day.date">
                  <th t-att-class="'rc-day rc-day-' + day.kind"><div><t t-esc="day.dow"/></div><div class="rc-daynum"><t t-esc="day.date.slice(8,10)"/></div></th>
                </t>
                <th class="rc-tot">Filled</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="state.data.rows" t-as="row" t-key="row.site_id">
                <tr>
                  <td class="rc-site-col">
                    <div class="rc-site-name rc-clickable" t-on-click="() => this.focusSite(row.site_id)" title="Show only this site's full cycle"><t t-esc="row.site_name"/></div>
                    <div class="rc-site-open" t-on-click="() => this.openSite(row.site_id)" title="Open the client site record">Open record ↗</div>
                    <div class="rc-client"><t t-esc="row.client"/></div>
                  </td>
                  <t t-foreach="state.data.days" t-as="day" t-key="day.date">
                    <td t-att-class="cellClass(row.cells[day.date], day)"
                        t-on-click="() => this.openDayDrawer(row, day)"
                        t-att-title="row.cells[day.date] and row.cells[day.date].total ? 'Click to inspect &amp; assign guards (' + row.site_name + ' on ' + day.date + ')' : ''">
                      <t t-esc="cellText(row.cells[day.date])"/>
                    </td>
                  </t>
                  <td class="rc-tot"><t t-esc="row.total - row.unfilled"/> / <t t-esc="row.total"/></td>
                </tr>
              </t>
            </tbody>
          </table>
        </div>
        <div class="rc-pager">
          <span class="rc-lbl">Page <t t-esc="state.page"/> of <t t-esc="pages"/> · <t t-esc="state.data.total_sites"/> sites</span>
          <div class="rc-group">
            <button class="rc-chip" t-att-disabled="state.page &lt;= 1" t-on-click="() => this.goPage(-1)">Previous</button>
            <button class="rc-chip" t-att-disabled="state.page &gt;= pages" t-on-click="() => this.goPage(1)">Next</button>
          </div>
        </div>
      </t>
    </main>

    <!-- Slide-Over Interactive Slot Assignment Drawer -->
    <div class="rc-drawer-overlay" t-if="state.selectedDay" t-on-click.self="closeDrawer">
      <div class="rc-drawer">
        <header class="rc-drawer-header">
          <div>
            <div class="rc-drawer-badge"><t t-esc="state.selectedDay.dow"/> · <t t-esc="state.selectedDay.shift_date"/></div>
            <h5 class="rc-drawer-title"><t t-esc="state.selectedDay.site_name"/></h5>
            <div class="rc-drawer-client"><t t-esc="state.selectedDay.client_name"/></div>
          </div>
          <button class="rc-drawer-close" t-on-click="closeDrawer">✕</button>
        </header>

        <div class="rc-drawer-body">
          <t t-if="state.loadingDay">
            <div class="rc-loading">Loading shift slots &amp; guard pool…</div>
          </t>

          <t t-if="!state.loadingDay and state.dayData">
            <t t-if="!state.dayData.slots or state.dayData.slots.length === 0">
              <div class="rc-empty-state">No active shift slots found for this site on this date.</div>
            </t>

            <t t-foreach="state.dayData.slots" t-as="slot" t-key="slot.id">
              <div class="rc-slot-card" t-att-class="slot.employee ? 'rc-slot-assigned' : 'rc-slot-gap'">
                <div class="rc-slot-header">
                  <div>
                    <span class="rc-slot-post"><t t-esc="slot.post_name"/></span>
                    <span class="rc-slot-shift"><t t-esc="slot.shift_template_name"/> (<t t-esc="slot.start_hour"/>:00 – <t t-esc="slot.end_hour"/>:00)</span>
                  </div>
                  <div>
                    <span t-if="!slot.employee" class="rc-badge-pill rc-badge-unfilled">🔴 Unfilled Gap</span>
                    <span t-if="slot.employee and slot.is_relief" class="rc-badge-pill rc-badge-relief">Relief Guard</span>
                    <span t-if="slot.employee and !slot.is_relief" class="rc-badge-pill rc-badge-filled">🟢 Filled</span>
                  </div>
                </div>

                <!-- Assigned Guard Section -->
                <div class="rc-slot-guard-row" t-if="slot.employee">
                  <div class="rc-guard-avatar">🛡️</div>
                  <div class="rc-guard-info">
                    <div class="rc-guard-name">
                      <t t-esc="slot.employee.name"/>
                      <span class="rc-badge-id" t-if="slot.employee.code"><t t-esc="slot.employee.code"/></span>
                      <span class="rc-badge-grade"><t t-esc="slot.employee.grade"/></span>
                    </div>

                    <!-- Namibian Operational Skills Pills -->
                    <div class="rc-guard-skills">
                      <span class="rc-skill-tag" t-att-class="slot.employee.can_read ? 'skill-good' : 'skill-bad'">
                        <t t-esc="slot.employee.can_read ? '📖 Reads: Yes' : '📖 Cannot Read'"/>
                      </span>
                      <span class="rc-skill-tag" t-att-class="slot.employee.can_write ? 'skill-good' : 'skill-bad'">
                        <t t-esc="slot.employee.can_write ? '✍️ Writes (' + slot.employee.writes_neatly + ')' : '✍️ Cannot Write'"/>
                      </span>
                      <span class="rc-skill-tag skill-lang">
                        🗣️ Eng: <t t-esc="slot.employee.english"/>
                      </span>
                      <span class="rc-skill-tag skill-lang" t-if="slot.employee.afrikaans !== 'none'">
                        🗣️ Afr: <t t-esc="slot.employee.afrikaans"/>
                      </span>
                      <span class="rc-skill-tag skill-smartness">
                        ⭐ Smartness: <t t-esc="slot.employee.smartness"/>/5
                      </span>
                    </div>
                  </div>
                  <div class="rc-guard-actions">
                    <button class="rc-btn-sm" style="background:#e0f2fe; color:#0369a1; border-color:#bae6fd;" t-on-click="() => this.openSwapModal(slot)" title="Swap this guard with another shift">Swap</button>
                    <button class="rc-btn-sm" t-on-click="() => this.toggleAssignDrawer(slot.id)">Replace</button>
                    <button class="rc-btn-sm rc-btn-danger" t-on-click="() => this.clearSlot(slot.id)">Clear</button>
                  </div>
                </div>

                <!-- Unassigned Prompt -->
                <div class="rc-slot-unassigned-row" t-if="!slot.employee and state.activeSlotId !== slot.id">
                  <div class="rc-unassigned-msg">No guard assigned to this shift.</div>
                  <button class="rc-btn rc-btn-primary" t-on-click="() => this.toggleAssignDrawer(slot.id)">
                    ⚡ Assign Guard from Pool
                  </button>
                </div>

                <!-- Guard Allocation Selector (Opens when slot is active) -->
                <div class="rc-pool-panel" t-if="state.activeSlotId === slot.id">
                  <div class="rc-pool-header">
                    <div class="rc-pool-tabs">
                      <button class="rc-pool-tab" t-att-class="state.poolTab === 'regular' ? 'active' : ''" t-on-click="() => this.setPoolTab('regular')">
                        Site Pool (<t t-esc="slot.regular_guards.length"/>)
                      </button>
                      <button class="rc-pool-tab" t-att-class="state.poolTab === 'relief' ? 'active' : ''" t-on-click="() => this.setPoolTab('relief')">
                        Relief Pool (<t t-esc="slot.relief_guards.length"/>)
                      </button>
                    </div>
                    <input class="rc-pool-search" type="text" placeholder="Search guard in pool…" t-att-value="state.poolSearch" t-on-input="onPoolSearch"/>
                  </div>

                  <div class="rc-pool-list">
                    <t t-set="guards" t-value="this.getPoolGuards(slot)"/>
                    <t t-if="!guards or guards.length === 0">
                      <div class="rc-pool-empty">No guards available matching search in this pool.</div>
                    </t>
                    <t t-foreach="guards" t-as="g" t-key="g.id">
                      <div class="rc-pool-item" t-att-class="g.is_eligible ? '' : 'item-warning'">
                        <div class="rc-pool-item-info">
                          <div class="rc-pool-item-title">
                            <span class="rc-item-name"><t t-esc="g.name"/></span>
                            <span class="rc-badge-id" t-if="g.code"><t t-esc="g.code"/></span>
                            <span class="rc-badge-grade"><t t-esc="g.grade"/></span>
                            <span t-if="!g.is_eligible" class="rc-badge-conflict">⚠️ Warning</span>
                          </div>

                          <!-- Guard Namibian Skills Mini-Strip -->
                          <div class="rc-guard-skills">
                            <span class="rc-skill-tag" t-att-class="g.can_read ? 'skill-good' : 'skill-bad'">
                              <t t-esc="g.can_read ? 'Read: Yes' : 'Read: No'"/>
                            </span>
                            <span class="rc-skill-tag skill-lang">
                              Eng: <t t-esc="g.english"/>
                            </span>
                            <span class="rc-skill-tag skill-smartness">
                              Smart: <t t-esc="g.smartness"/>/5
                            </span>
                          </div>

                          <!-- Conflicts / warnings -->
                          <div class="rc-conflict-reasons" t-if="g.reasons and g.reasons.length">
                            <t t-foreach="g.reasons" t-as="r" t-key="r">
                              <div class="rc-reason">• <t t-esc="r"/></div>
                            </t>
                          </div>
                        </div>

                        <button class="rc-btn-assign" t-on-click="() => this.assignGuard(slot.id, g.id, g.name)">
                          Assign
                        </button>
                      </div>
                    </t>
                  </div>
                </div>
              </div>
            </t>
          </t>
        </div>
      </div>
    </div>

    <!-- Manager Override Modal -->
    <div class="rc-override-modal-backdrop" t-if="state.overrideModal and state.overrideModal.visible" t-on-click.self="closeOverrideModal">
      <div class="rc-override-modal">
        <div class="rc-override-modal-header">
          <h5 class="rc-override-modal-title">⚠️ Manager Override Required</h5>
          <button class="rc-drawer-close" t-on-click="closeOverrideModal">✕</button>
        </div>
        <div class="rc-override-modal-body">
          <p>Assigning <b><t t-esc="state.overrideModal.guardName"/></b> has the following warnings / constraints:</p>
          <div class="rc-conflict-reasons-box">
            <t t-foreach="state.overrideModal.reasons" t-as="r" t-key="r">
              <div class="rc-reason-item">⚠️ <t t-esc="r"/></div>
            </t>
          </div>
          <div class="rc-override-field">
            <label class="rc-field-label">Override Reason (Required for Audit Trail):</label>
            <input type="text" class="rc-input-override" placeholder="e.g. Approved by Operations Manager due to relief shortage"
                   t-att-value="state.overrideModal.reasonInput"
                   t-on-input="(ev) => this.state.overrideModal.reasonInput = ev.target.value"/>
          </div>
        </div>
        <div class="rc-override-modal-footer">
          <button class="rc-btn rc-btn-secondary" t-on-click="closeOverrideModal">Cancel</button>
          <button class="rc-btn rc-btn-primary" t-on-click="submitOverride">Confirm Override</button>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         ONE-CLICK GUARD SHIFT SWAP MODAL
         ═══════════════════════════════════════════════════════════ -->
    <div class="rc-override-modal-backdrop" t-if="state.swapModal.visible" t-on-click.self="closeSwapModal">
      <div class="rc-override-modal" style="width: 660px; max-width: 95vw;">
        <div class="rc-override-modal-header">
          <div class="d-flex align-items-center gap-2">
            <span class="badge" style="background:#e0f2fe; color:#0284c7; font-size:11px; font-weight:700;">🔄 GUARD SWAP</span>
            <h5 class="rc-override-modal-title mb-0">One-Click Guard Shift Swap</h5>
          </div>
          <button class="rc-drawer-close" t-on-click="closeSwapModal">✕</button>
        </div>

        <div class="rc-override-modal-body d-flex flex-column gap-3">
          <!-- Error banner -->
          <div t-if="state.swapModal.error" class="alert alert-danger py-2 px-3 mb-0" style="font-size:12px;">
            <i class="fa fa-exclamation-circle me-1"/>
            <span t-esc="state.swapModal.error"/>
          </div>

          <!-- Slot Comparison Row -->
          <div class="row g-2">
            <div class="col-12 col-md-5">
              <div class="p-2 border rounded" style="background:#f8fafc; font-size:12px;">
                <div class="fw-bold text-primary mb-1">SLOT A (SOURCE)</div>
                <select class="form-select form-select-sm mb-2" t-on-change="onSelectSwapSlotA">
                  <t t-foreach="assignedSlotsForSwap" t-as="s" t-key="s.id">
                    <option t-att-value="s.id" t-att-selected="state.swapModal.slotAId === s.id">
                      <t t-esc="s.shift_date"/> · <t t-esc="s.site_name"/> · <t t-esc="s.employee_name"/> (<t t-esc="s.post_name"/>)
                    </option>
                  </t>
                </select>
                <t t-if="state.swapModal.slotA">
                  <div class="fw-bold"><t t-esc="state.swapModal.slotA.employee_name"/></div>
                  <div class="text-muted small"><t t-esc="state.swapModal.slotA.site_name"/> · <t t-esc="state.swapModal.slotA.post_name"/></div>
                  <div class="text-muted small"><t t-esc="state.swapModal.slotA.shift_label"/></div>
                </t>
              </div>
            </div>

            <div class="col-12 col-md-2 d-flex flex-column align-items-center justify-content-center text-center">
              <div class="fs-4 text-primary">⇄</div>
              <div class="text-muted small fw-bold" style="font-size:10px;">SWAP</div>
            </div>

            <div class="col-12 col-md-5">
              <div class="p-2 border rounded" style="background:#f8fafc; font-size:12px;">
                <div class="fw-bold text-success mb-1">SLOT B (TARGET)</div>
                <select class="form-select form-select-sm mb-2" t-on-change="onSelectSwapSlotB">
                  <option value="">— Pick Slot B to swap with —</option>
                  <t t-foreach="eligibleSlotBCandidates" t-as="s" t-key="s.id">
                    <option t-att-value="s.id" t-att-selected="state.swapModal.slotBId === s.id">
                      <t t-esc="s.shift_date"/> · <t t-esc="s.site_name"/> · <t t-esc="s.employee_name"/> (<t t-esc="s.post_name"/>)
                    </option>
                  </t>
                </select>
                <t t-if="state.swapModal.slotB">
                  <div class="fw-bold"><t t-esc="state.swapModal.slotB.employee_name"/></div>
                  <div class="text-muted small"><t t-esc="state.swapModal.slotB.site_name"/> · <t t-esc="state.swapModal.slotB.post_name"/></div>
                  <div class="text-muted small"><t t-esc="state.swapModal.slotB.shift_label"/></div>
                </t>
                <t t-else="">
                  <div class="text-muted small fst-italic py-2 text-center">Select target shift</div>
                </t>
              </div>
            </div>
          </div>

          <!-- Pre-validation review -->
          <t t-if="state.swapModal.validating">
            <div class="p-2 bg-light border rounded text-center text-muted" style="font-size:11px;">
              <i class="fa fa-spinner fa-spin me-1 text-primary"/> Pre-validating turnaround rest &amp; grade requirements…
            </div>
          </t>
          <t t-elif="state.swapModal.preValidation and state.swapModal.preValidation.status === 'success'">
            <div class="p-2 border rounded"
                 t-att-style="'background:' + (state.swapModal.preValidation.requires_override ? '#fffbeb; border-color:#fef08a !important;' : '#f0fdf4; border-color:#bbf7d0 !important;')">
              <div class="d-flex align-items-center justify-content-between mb-1" style="font-size:11px;">
                <span class="fw-bold" t-att-style="'color:' + (state.swapModal.preValidation.requires_override ? '#b45309;' : '#15803d;')">
                  <i t-att-class="state.swapModal.preValidation.requires_override ? 'fa fa-exclamation-triangle' : 'fa fa-check-circle'"/>
                  <t t-if="state.swapModal.preValidation.can_swap_cleanly">Full Compliance: Turnaround rest &amp; grade met</t>
                  <t t-else="">Manager Override Required</t>
                </span>
                <span class="badge" t-att-style="'background:' + (state.swapModal.preValidation.requires_override ? '#fde68a; color:#92400e;' : '#dcfce7; color:#166534;')">
                  <t t-if="state.swapModal.preValidation.can_swap_cleanly">PASS</t>
                  <t t-else="">OVERRIDE</t>
                </span>
              </div>
              <div class="d-flex justify-content-between small py-1 border-bottom" style="font-size:10px;">
                <span><b><t t-esc="state.swapModal.preValidation.guard_a.name"/></b> ➔ <t t-esc="state.swapModal.preValidation.guard_a.to_slot.post_name"/></span>
                <span>
                  <span t-if="state.swapModal.preValidation.guard_a.grade_ok" class="badge bg-success text-white me-1">Grade Met</span>
                  <span t-else="" class="badge bg-danger text-white me-1">Grade Mismatch</span>
                  <span t-if="state.swapModal.preValidation.guard_a.rest_ok" class="badge bg-success text-white">12h Rest OK</span>
                  <span t-else="" class="badge bg-warning text-dark">Rest Warning</span>
                </span>
              </div>
              <div class="d-flex justify-content-between small py-1" style="font-size:10px;">
                <span><b><t t-esc="state.swapModal.preValidation.guard_b.name"/></b> ➔ <t t-esc="state.swapModal.preValidation.guard_b.to_slot.post_name"/></span>
                <span>
                  <span t-if="state.swapModal.preValidation.guard_b.grade_ok" class="badge bg-success text-white me-1">Grade Met</span>
                  <span t-else="" class="badge bg-danger text-white me-1">Grade Mismatch</span>
                  <span t-if="state.swapModal.preValidation.guard_b.rest_ok" class="badge bg-success text-white">12h Rest OK</span>
                  <span t-else="" class="badge bg-warning text-dark">Rest Warning</span>
                </span>
              </div>
            </div>
          </t>

          <!-- Audit Reason Input -->
          <div class="rc-override-field">
            <label class="rc-field-label">Manager Audit Reason (Required for Compliance):</label>
            <div class="d-flex gap-1 flex-wrap mb-2">
              <button class="rc-btn-sm" t-on-click="() => this.setSwapReason('Mutual swap request')">Mutual swap request</button>
              <button class="rc-btn-sm" t-on-click="() => this.setSwapReason('Medical reallocation')">Medical reallocation</button>
              <button class="rc-btn-sm" t-on-click="() => this.setSwapReason('Client request')">Client request</button>
              <button class="rc-btn-sm" t-on-click="() => this.setSwapReason('Transport / logistical issue')">Transport / logistical issue</button>
            </div>
            <input type="text" class="rc-input-override"
                   placeholder="Enter swap reason (e.g. Mutual swap requested by guards)…"
                   t-att-value="state.swapModal.reason"
                   t-on-input="(ev) => { this.state.swapModal.reason = ev.target.value; }"/>
          </div>
        </div>

        <div class="rc-override-modal-footer">
          <button class="rc-btn rc-btn-secondary" t-on-click="closeSwapModal">Cancel</button>
          <button class="rc-btn rc-btn-primary"
                  t-on-click="confirmExecuteSwap"
                  t-att-disabled="!state.swapModal.slotAId or !state.swapModal.slotBId or !state.swapModal.reason or state.swapModal.submitting">
            <i t-att-class="state.swapModal.submitting ? 'fa fa-spinner fa-spin me-1' : 'fa fa-exchange me-1'"/>
            <t t-if="state.swapModal.submitting">Executing Swap…</t>
            <t t-else="">Execute Atomic Swap</t>
          </button>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         CANDIDATE POOL RELIEF DISPATCH MODAL
         ═══════════════════════════════════════════════════════════ -->
    <div class="rc-override-modal-backdrop" t-if="state.candidatePoolModal.visible" t-on-click.self="closeCandidatePoolModal">
      <div class="rc-override-modal" style="width: 680px; max-width: 95vw;">
        <div class="rc-override-modal-header">
          <div>
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-danger text-white" style="font-size:10px; font-weight:700;">⚡ RELIEF DISPATCH</span>
              <h5 class="rc-override-modal-title mb-0">Dispatch Relief Guard to Open Gap</h5>
            </div>
            <t t-if="state.candidatePoolModal.slot">
              <div class="text-muted small mt-1">
                <b><t t-esc="state.candidatePoolModal.slot.site_name"/></b> · <t t-esc="state.candidatePoolModal.slot.post_name"/> · <t t-esc="state.candidatePoolModal.slot.shift_template_name"/>
              </div>
            </t>
          </div>
          <button class="rc-drawer-close" t-on-click="closeCandidatePoolModal">✕</button>
        </div>

        <div class="rc-override-modal-body d-flex flex-column gap-3">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-2 border-bottom">
            <div class="rc-pool-tabs">
              <button class="rc-pool-tab" t-att-class="state.candidatePoolModal.poolTab === 'relief' ? 'active' : ''"
                      t-on-click="() => { state.candidatePoolModal.poolTab = 'relief'; }">
                Relief Pool (<t t-esc="state.candidatePoolModal.reliefGuards.length"/>)
              </button>
              <button class="rc-pool-tab" t-att-class="state.candidatePoolModal.poolTab === 'regular' ? 'active' : ''"
                      t-on-click="() => { state.candidatePoolModal.poolTab = 'regular'; }">
                Site Team (<t t-esc="state.candidatePoolModal.regularGuards.length"/>)
              </button>
            </div>
            <input class="rc-pool-search" type="text" placeholder="Filter guard name or code…"
                   t-att-value="state.candidatePoolModal.searchQuery"
                   t-on-input="(ev) => { state.candidatePoolModal.searchQuery = ev.target.value; }"/>
          </div>

          <!-- Candidates List -->
          <div style="max-height: 320px; overflow-y: auto;" class="d-flex flex-column gap-2">
            <t t-if="state.candidatePoolModal.loading">
              <div class="py-4 text-center text-muted">
                <i class="fa fa-spinner fa-spin me-1 text-primary"/> Loading candidate guard pool…
              </div>
            </t>
            <t t-elif="candidatesForDispatch.length === 0">
              <div class="py-3 text-center text-muted fst-italic">No guards found in this pool.</div>
            </t>
            <t t-else="">
              <t t-foreach="candidatesForDispatch" t-as="g" t-key="g.id">
                <div class="p-2 border rounded d-flex align-items-center justify-content-between gap-2"
                     t-att-style="'background:' + (g.is_eligible === false ? '#fffbeb' : '#ffffff')">
                  <div>
                    <div class="d-flex align-items-center gap-2">
                      <span class="fw-bold"><t t-esc="g.name"/></span>
                      <span t-if="g.code and g.code !== '—'" class="rc-badge-id"><t t-esc="g.code"/></span>
                      <span class="rc-badge-grade"><t t-esc="g.grade"/></span>
                      <span t-if="g.is_eligible === false" class="badge bg-warning text-dark" style="font-size:9px;">⚠️ Warning</span>
                    </div>
                    <div class="d-flex gap-1 flex-wrap mt-1">
                      <span class="badge bg-light text-muted border py-0 px-1" style="font-size:9px;"><t t-esc="g.can_read ? '📖 Read: Yes' : '📖 No Read'"/></span>
                      <span class="badge bg-light text-muted border py-0 px-1" style="font-size:9px;">Eng: <t t-esc="g.english"/></span>
                      <span class="badge bg-light text-muted border py-0 px-1" style="font-size:9px;">⭐ <t t-esc="g.smartness"/>/5</span>
                    </div>
                    <t t-if="g.reasons and g.reasons.length">
                      <div class="text-danger small mt-1" style="font-size:10px;">
                        <t t-foreach="g.reasons" t-as="r" t-key="r">
                          <div>• <t t-esc="r"/></div>
                        </t>
                      </div>
                    </t>
                  </div>
                  <button class="rc-btn rc-btn-primary" style="padding: 4px 12px; font-size: 11px;"
                          t-on-click="() => this.dispatchCandidateGuard(g.id, g.name)"
                          t-att-disabled="state.candidatePoolModal.submitting">
                    Dispatch
                  </button>
                </div>
              </t>
            </t>
          </div>

          <!-- Dispatch Override Box -->
          <t t-if="state.candidatePoolModal.overrideModal and state.candidatePoolModal.overrideModal.visible">
            <div class="p-2 border rounded bg-light border-warning">
              <div class="fw-bold text-warning small mb-1">⚠️ Manager Override Required for <t t-esc="state.candidatePoolModal.overrideModal.guardName"/></div>
              <div class="d-flex gap-2">
                <input type="text" class="rc-input-override form-control-sm" placeholder="Reason for override…"
                       t-att-value="state.candidatePoolModal.overrideModal.reasonInput"
                       t-on-input="(ev) => { state.candidatePoolModal.overrideModal.reasonInput = ev.target.value; }"/>
                <button class="rc-btn rc-btn-primary" t-on-click="submitDispatchOverride">Confirm</button>
                <button class="rc-btn rc-btn-secondary" t-on-click="closeDispatchOverride">Cancel</button>
              </div>
            </div>
          </t>
        </div>

        <div class="rc-override-modal-footer">
          <button class="rc-btn rc-btn-secondary" t-on-click="closeCandidatePoolModal">Close</button>
        </div>
      </div>
    </div>
  </div>
</t>
</templates>
