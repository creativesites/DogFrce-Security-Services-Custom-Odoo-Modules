<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client Action for Interactive Workforce Dashboard -->
    <record id="action_workforce_dashboard" model="ir.actions.client">
        <field name="name">Workforce Dashboard</field>
        <field name="tag">security_base.workforce_dashboard</field>
        <field name="target">current</field>
    </record>

    <!-- Client Action for Workforce Mega Menu -->
    <record id="action_workforce_mega_menu" model="ir.actions.client">
        <field name="name">Workforce Command Center</field>
        <field name="tag">security_base.workforce_mega_menu</field>
        <field name="target">fullscreen</field>
    </record>

    <!-- Client Action for Main DogForce OS Home Command Center -->
    <record id="action_deployguard_main_command_center" model="ir.actions.client">
        <field name="name">DogForce OS Home</field>
        <field name="tag">deployguard.main_command_center</field>
        <field name="target">fullscreen</field>
    </record>

    <!-- Root Menu Item for Workforce Command Center -->
    <menuitem id="menu_security_workforce_root"
              name="Workforce"
              web_icon="security_base,static/description/icon.png"
              sequence="5"
              groups="base.group_user"/>

    <menuitem id="menu_security_workforce_dashboard"
              name="⚡ Dashboard"
              parent="menu_security_workforce_root"
              action="action_workforce_dashboard"
              sequence="0"/>

    <menuitem id="menu_security_workforce_mega_menu"
              name="⚡ Command Center"
              parent="menu_security_workforce_root"
              action="action_workforce_mega_menu"
              sequence="1"/>

    <menuitem id="menu_security_workforce_directory"
              name="Guards Directory"
              parent="menu_security_workforce_root"
              action="hr.open_view_employee_list_my"
              sequence="10"/>

    <menuitem id="menu_security_workforce_grades"
              name="Guard Grades"
              parent="menu_security_workforce_root"
              action="action_security_grade"
              sequence="15"/>

    <menuitem id="menu_security_workforce_certifications"
              name="Certifications &amp; Vetting"
              parent="menu_security_workforce_root"
              action="action_security_certification"
              sequence="20"/>

</odoo>
