<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_security_base" model="ir.ui.view">
        <field name="name">hr.employee.form.security.base</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Security Profile" invisible="not security_guard">
                    <notebook>
                        <!-- Tab 1: Guard Details -->
                        <page string="Details">
                            <group>
                                <group string="Classification">
                                    <field name="employee_code" string="Employee ID" placeholder="e.g. G-001"/>
                                    <field name="security_guard"/>
                                    <field name="security_grade_id"/>
                                    <field name="security_home_location"/>
                                    <field name="security_medical_fitness_grade"/>
                                </group>
                                <group string="Pay Rate">
                                    <field name="security_hourly_rate"/>
                                    <field name="security_effective_hourly_rate" readonly="1"/>
                                </group>
                            </group>
                            <group string="Disqualification">
                                <group>
                                    <field name="security_disqualified"/>
                                    <field name="security_disqualification_reason_id" invisible="not security_disqualified"/>
                                </group>
                                <group>
                                    <field name="security_disqualification_note" invisible="not security_disqualified"/>
                                </group>
                            </group>
                            <group string="Emergency Contact">
                                <field name="security_emergency_contact_name"/>
                                <field name="security_emergency_contact_relationship"/>
                                <field name="security_emergency_contact_phone"/>
                            </group>
                        </page>

                        <!-- Tab 2: Guard Skills & Suitability (Namibian Setup) -->
                        <page string="Guard Skills &amp; Suitability">
                            <group string="Operational Skills (Namibian Context)">
                                <group string="Literacy &amp; Handwriting">
                                    <field name="security_can_read"/>
                                    <field name="security_can_write"/>
                                    <field name="security_writes_neatly"/>
                                </group>
                                <group string="Languages &amp; Alertness">
                                    <field name="security_english_level"/>
                                    <field name="security_afrikaans_level"/>
                                    <field name="security_smartness_rating"/>
                                </group>
                            </group>
                            <group string="Post Suitability &amp; Notes">
                                <field name="security_skills_notes" placeholder="Notes on post suitability (e.g. suitable for clinic, executive reception, night patrol)..."/>
                            </group>
                            <group string="Additional Languages &amp; Attributes">
                                <group string="Other Languages">
                                    <field name="security_language_ids" widget="many2many_tags" nolabel="1"/>
                                </group>
                                <group string="Attributes">
                                    <field name="security_attribute_ids" widget="many2many_tags" nolabel="1"/>
                                </group>
                            </group>
                            <group string="Certifications (Secondary)" groups="base.group_no_one,security_base.group_security_manager">
                                <field name="security_certification_ids" widget="many2many_tags" nolabel="1"/>
                                <field name="security_certification_detail_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="certification_id"/>
                                        <field name="issue_date"/>
                                        <field name="expiry_date"/>
                                        <field name="document_ref"/>
                                        <field name="verified"/>
                                        <field name="is_expired" readonly="1" decoration-danger="is_expired"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <!-- Tab 3: Reliability -->
                        <page string="Reliability">
                            <group>
                                <group>
                                    <field name="security_reliability_score" widget="reliability_gauge"/>
                                    <field name="security_reliability_adjustment_total" readonly="1"/>
                                </group>
                            </group>
                            <field name="security_reliability_adjustment_ids">
                                <list editable="bottom">
                                    <field name="adjustment_date"/>
                                    <field name="reason"/>
                                    <field name="score_delta"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>


                    </notebook>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Inherit Employee List View to show Employee ID and Guard Status -->
    <record id="view_employee_tree_security_base" model="ir.ui.view">
        <field name="name">hr.employee.list.security.base</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="employee_code" string="Employee ID" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="security_guard" string="Guard" optional="show" widget="boolean_toggle"/>
                <field name="security_grade_id" string="Grade" optional="show"/>
                <field name="security_can_read" string="Reads" optional="hide"/>
                <field name="security_english_level" string="English" optional="hide"/>
                <field name="security_smartness_rating" string="Smartness" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Employee Search View for Employee ID and Security Guard Filter -->
    <record id="view_employee_search_security_base" model="ir.ui.view">
        <field name="name">hr.employee.search.security.base</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">['|', ('name', 'ilike', self), ('employee_code', 'ilike', self)]</attribute>
            </xpath>
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Security Guards" name="filter_security_guards" domain="[('security_guard', '=', True)]"/>
                <filter string="Can Read" name="filter_can_read" domain="[('security_can_read', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
