<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_training_competency_list" model="ir.ui.view">
        <field name="name">security.training.competency.list</field>
        <field name="model">security.training.competency</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="employee_id"/>
                <field name="course_id"/>
                <field name="course_version_id"/>
                <field name="granted_at"/>
                <field name="evidence_certification_id"/>
            </list>
        </field>
    </record>

    <record id="action_security_training_competency" model="ir.actions.act_window">
        <field name="name">Competencies</field>
        <field name="res_model">security.training.competency</field>
        <field name="view_mode">list</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No competencies granted yet.</p></field>
    </record>
</odoo>
