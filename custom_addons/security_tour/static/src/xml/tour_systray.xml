<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="security_tour.TourSystray" owl="1">
        <div class="o_tour_systray_item dropdown" title="Take a DeployGuard Tour">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" role="button" t-on-click="toggleDropdown">
                <i class="fa fa-compass o_tour_systray_icon text-primary"/>
                <span class="d-none d-md-inline fw-semibold small">Product Tours</span>
            </a>
            <div t-if="state.open" class="dropdown-menu dropdown-menu-end show o_tour_dropdown_menu p-2 shadow-lg border-0 mt-2">
                <div class="px-2 py-1 mb-1 border-bottom d-flex align-items-center justify-content-between">
                    <span class="fw-bold small text-dark"><i class="fa fa-map-signs text-primary me-1"/>DeployGuard Tours</span>
                    <span class="badge bg-primary rounded-pill">Interactive</span>
                </div>
                <t t-foreach="state.tours" t-as="tour" t-key="tour.id">
                    <a class="dropdown-item rounded p-2 d-flex align-items-start gap-2 mb-1" href="#" t-on-click="() => this.launchTour(tour.technical_name)">
                        <i t-att-class="'fa ' + tour.icon_class + ' mt-1 text-primary'"/>
                        <div class="flex-grow-1">
                            <div class="fw-bold small text-dark d-flex align-items-center justify-content-between">
                                <span><t t-esc="tour.name"/></span>
                                <t t-if="tour.done">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 9px;"><i class="fa fa-check me-1"/>Done</span>
                                </t>
                            </div>
                            <div class="text-muted" style="font-size: 11px; line-height: 1.3;"><t t-esc="tour.description"/></div>
                            <div class="text-primary mt-1" style="font-size: 10px; font-weight: 600;">
                                <i class="fa fa-clock-o me-1"/><t t-esc="tour.estimated_minutes"/> mins · <t t-esc="tour.step_count"/> steps
                            </div>
                        </div>
                    </a>
                </t>
            </div>
        </div>
    </t>
</templates>
