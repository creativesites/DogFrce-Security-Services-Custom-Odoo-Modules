<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Client-site records are visible only in companies the current user may access. -->
        <record id="security_client_site_company_rule" model="ir.rule">
            <field name="name">Client Sites: multi-company isolation</field>
            <field name="model_id" ref="model_security_client_site"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
