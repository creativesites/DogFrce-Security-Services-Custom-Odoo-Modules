<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_roster_reject_wizard_form" model="ir.ui.view">
        <field name="name">security.roster.reject.wizard.form</field>
        <field name="model">security.roster.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Roster Batch">
                <sheet>
                    <group>
                        <field name="batch_id" readonly="1" options="{'no_open': True}"/>
                        <field name="rejection_reason" placeholder="Enter reason for rejecting this roster..." required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_rejection" type="object" string="Reject Roster" class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_security_roster_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Roster Batch</field>
        <field name="res_model">security.roster.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
