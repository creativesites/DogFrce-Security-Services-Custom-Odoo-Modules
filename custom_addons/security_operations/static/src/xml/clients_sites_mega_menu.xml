<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="security_operations.ClientsSitesMegaMenu" owl="1">
  <div class="rmm-overlay" t-on-click.self="() => this.close()" tabindex="0">
    <div class="rmm-container">

      <!-- Header -->
      <div class="rmm-header">
        <div class="rmm-brand">
          <div class="rmm-brand-badge">
            <i class="fa fa-building me-2"/><t t-esc="companyName"/> Clients &amp; Sites
          </div>
          <div>
            <h2 class="rmm-title">Clients &amp; Sites</h2>
            <div class="rmm-subtitle">Four destinations. Setting up a new client always starts from the button below.</div>
          </div>
        </div>

        <button class="rmm-close-btn" t-on-click="() => this.close()" title="Close (Esc)">
          <i class="fa fa-times"/>
        </button>
      </div>

      <!-- Primary action — the one supported way to onboard a new client.
           See docs/ROSTERING_SIMPLIFICATION_PLAN.md Task 3: a wizard already
           does the whole chain end to end; this is the button that makes it
           the obvious first move instead of one card among many. -->
      <div class="rmm-primary-cta">
        <button class="rmm-primary-cta-btn" t-on-click="() => this.openAction('security_client_onboarding.action_security_client_onboarding_wizard')">
          <i class="fa fa-plus-circle me-2"/>Set up a new client
        </button>
        <span class="rmm-primary-cta-hint">Client, sites, shift requirements, billing and the first roster — one flow.</span>
      </div>

      <!-- Main Body — four destinations, no launchpad -->
      <div class="rmm-body">
        <div class="rmm-card-grid">

          <div class="rmm-card" t-on-click="() => this.openAction('security_client_onboarding.action_security_client_partner')">
            <div class="rmm-card-icon icon-blue"><i class="fa fa-address-book-o"/></div>
            <div class="rmm-card-content">
              <div class="rmm-card-header">
                <span class="rmm-card-title">Clients</span>
              </div>
              <div class="rmm-card-desc">Client companies — open one to see every site, contract and shift under it.</div>
            </div>
          </div>

          <div class="rmm-card" t-on-click="() => this.openAction('security_operations.action_security_client_site')">
            <div class="rmm-card-icon icon-emerald"><i class="fa fa-map-marker"/></div>
            <div class="rmm-card-content">
              <div class="rmm-card-header">
                <span class="rmm-card-title">Sites</span>
              </div>
              <div class="rmm-card-desc">Every deployment site, grouped by client. Coverage, risk and contract status at a glance.</div>
            </div>
          </div>

          <div class="rmm-card" t-on-click="() => this.openAction('security_operations.action_security_client_contract')">
            <div class="rmm-card-icon icon-purple"><i class="fa fa-file-text-o"/></div>
            <div class="rmm-card-content">
              <div class="rmm-card-header">
                <span class="rmm-card-title">Contracts &amp; Tenders</span>
              </div>
              <div class="rmm-card-desc">Service agreements, renewal dates and which sites each one covers.</div>
            </div>
          </div>

          <div class="rmm-card" t-on-click="() => this.openAction('security_operations.action_security_shift_requirement')">
            <div class="rmm-card-icon icon-amber"><i class="fa fa-clock-o"/></div>
            <div class="rmm-card-content">
              <div class="rmm-card-header">
                <span class="rmm-card-title">Shift Requirements</span>
              </div>
              <div class="rmm-card-desc">What must be guarded, when, and at what rate — the data the roster is generated from.</div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</t>
</templates>
