<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="security_billing.DocumentDesigner" owl="1">
        <div class="doc-designer-container o_content d-flex flex-column h-100 w-100 overflow-hidden" style="background: var(--ds-bg, #F8FAFC);">

            <!-- ═══════════════════════════════════════════════════════════
                 TOP APPLICATION BAR — Clean Studio Header & Flow
                 ═══════════════════════════════════════════════════════════ -->
            <header class="doc-designer-header d-flex align-items-center justify-content-between px-4 py-2.5 bg-white border-bottom flex-wrap gap-3" style="z-index: 20; min-height: 56px;">
                <!-- Left: Flow Navigation, Doc Type, Template Switcher -->
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 px-3"
                            t-on-click="onBackToBilling"
                            title="Return to Billing Command Center">
                        <i class="fa fa-arrow-left"/>
                        <span>Back to Billing</span>
                    </button>

                    <div class="vr mx-1" style="height: 24px; opacity: 0.2;"/>

                    <!-- Document Type Selector (Pill group) -->
                    <div class="btn-group btn-group-sm doc-type-group" role="group">
                        <button type="button"
                                class="btn"
                                t-att-class="state.documentType === 'invoice' ? 'btn-primary fw-semibold' : 'btn-outline-secondary'"
                                t-on-click="() => this.setDocumentType('invoice')">
                            <i class="fa fa-file-text-o me-1.5"/> Invoice
                        </button>
                        <button type="button"
                                class="btn"
                                t-att-class="state.documentType === 'quotation' ? 'btn-primary fw-semibold' : 'btn-outline-secondary'"
                                t-on-click="() => this.setDocumentType('quotation')">
                            <i class="fa fa-file-o me-1.5"/> Quotation
                        </button>
                    </div>

                    <div class="vr mx-1" style="height: 24px; opacity: 0.2;"/>

                    <!-- Template Selector Dropdown -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small fw-semibold text-uppercase" style="font-size: 11px;">Template:</span>
                        <select class="form-select form-select-sm doc-template-select"
                                style="min-width: 200px; font-weight: 600;"
                                t-on-change="onTemplateSelect">
                            <t t-foreach="state.availableTemplates" t-as="tmpl" t-key="tmpl.id">
                                <option t-att-value="tmpl.id" t-att-selected="state.templateId === tmpl.id">
                                    <t t-esc="tmpl.name"/> (<t t-esc="tmpl.base_layout"/>)
                                </option>
                            </t>
                            <option value="new">+ Create New Template...</option>
                        </select>
                    </div>

                    <!-- Template Name Field -->
                    <div class="d-flex align-items-center">
                        <input type="text"
                               class="form-control form-control-sm doc-name-input"
                               style="width: 180px; font-size: 12.5px;"
                               placeholder="Template Name…"
                               t-model="state.templateName"
                               t-on-change="triggerPreviewUpdate"/>
                    </div>
                </div>

                <!-- Center: Zoom & Viewport Scale Controls -->
                <div class="d-flex align-items-center gap-1">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-light border" t-on-click="zoomOut" title="Zoom Out (–)">
                            <i class="fa fa-search-minus"/>
                        </button>
                        <button class="btn btn-light border fw-bold text-dark px-2" style="min-width: 58px;" t-on-click="zoomReset" title="Reset Zoom to 100%">
                            <t t-esc="state.zoomScale"/>%
                        </button>
                        <button class="btn btn-light border" t-on-click="zoomIn" title="Zoom In (+)">
                            <i class="fa fa-search-plus"/>
                        </button>
                    </div>
                    <button class="btn btn-sm btn-light border ms-1" t-on-click="zoomFit" title="Fit to Screen (80%)">
                        <i class="fa fa-arrows-alt me-1"/> Fit
                    </button>
                </div>

                <!-- Right: Action Buttons -->
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-light border text-muted px-3" t-on-click="resetTemplate" title="Discard unsaved changes">
                        <i class="fa fa-undo me-1"/> Reset
                    </button>
                    <button class="btn btn-sm btn-outline-secondary px-3" t-on-click="openPdfPreview" title="View PDF Print Layout">
                        <i class="fa fa-file-pdf-o me-1"/> PDF Preview
                    </button>
                    <button class="btn btn-sm text-white px-4 fw-semibold shadow-sm"
                            style="background: var(--ds-accent, #1B3A6B); border-color: var(--ds-accent, #1B3A6B);"
                            t-on-click="saveTemplate"
                            t-att-disabled="state.isSaving">
                        <i t-att-class="state.isSaving ? 'fa fa-spinner fa-spin me-1' : 'fa fa-save me-1'"/>
                        <t t-esc="state.isSaving ? 'Saving…' : 'Save Template'"/>
                    </button>
                </div>
            </header>

            <!-- ═══════════════════════════════════════════════════════════
                 STUDIO WORKSPACE — Left Inspector + Right Live Canvas
                 ═══════════════════════════════════════════════════════════ -->
            <div class="d-flex flex-row flex-grow-1 overflow-hidden h-100 w-100">

                <!-- LEFT PANEL: 3-Tab Studio Inspector -->
                <div class="doc-designer-sidebar d-flex flex-column h-100 bg-white border-end shadow-sm"
                     style="width: 380px; min-width: 380px; z-index: 10;">
                    
                    <!-- Segmented Inspector Tabs -->
                    <div class="doc-inspector-tabs d-flex border-bottom bg-light px-2 pt-2 gap-1" style="flex-shrink: 0;">
                        <button class="doc-tab-pill flex-fill text-center py-2 px-1 border-0 rounded-top"
                                t-att-class="{ 'is-active bg-white text-primary fw-bold border-bottom-0 shadow-xs': state.activeDrawerTab === 'style', 'text-muted': state.activeDrawerTab !== 'style' }"
                                t-on-click="() => this.setDrawerTab('style')">
                            <i class="fa fa-paint-brush me-1"/> Style &amp; Theme
                        </button>
                        <button class="doc-tab-pill flex-fill text-center py-2 px-1 border-0 rounded-top"
                                t-att-class="{ 'is-active bg-white text-primary fw-bold border-bottom-0 shadow-xs': state.activeDrawerTab === 'blocks', 'text-muted': state.activeDrawerTab !== 'blocks' }"
                                t-on-click="() => this.setDrawerTab('blocks')">
                            <i class="fa fa-th-list me-1"/> Section Order
                        </button>
                        <button class="doc-tab-pill flex-fill text-center py-2 px-1 border-0 rounded-top"
                                t-att-class="{ 'is-active bg-white text-primary fw-bold border-bottom-0 shadow-xs': state.activeDrawerTab === 'content', 'text-muted': state.activeDrawerTab !== 'content' }"
                                t-on-click="() => this.setDrawerTab('content')">
                            <i class="fa fa-sliders me-1"/> Content &amp; Rules
                        </button>
                    </div>

                    <!-- Inspector Content Container -->
                    <div class="flex-grow-1 overflow-auto p-3">

                        <!-- ── TAB 1: STYLE & THEME ── -->
                        <div t-if="state.activeDrawerTab === 'style'">
                            
                            <!-- Style Presets -->
                            <div class="mb-4 p-3 rounded border bg-light">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <label class="form-label fw-bold small text-uppercase text-muted mb-0">
                                        <i class="fa fa-magic text-primary me-1"/> Quick Design Presets
                                    </label>
                                    <span t-if="state.selectedPreset" class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 10px;">
                                        Active Preset
                                    </span>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button class="btn btn-xs d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill shadow-xs"
                                            t-att-class="state.selectedPreset === 'corporate_navy' ? 'btn-primary text-white border-primary fw-semibold' : 'btn-outline-secondary bg-white text-dark'"
                                            t-on-click="() => this.applyPreset('corporate_navy')">
                                        <span class="badge rounded-circle" style="background:#1B3A6B; width:10px; height:10px; padding:0;"/>
                                        <span>Corporate Navy</span>
                                        <i t-if="state.selectedPreset === 'corporate_navy'" class="fa fa-check small ms-1"/>
                                    </button>
                                    <button class="btn btn-xs d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill shadow-xs"
                                            t-att-class="state.selectedPreset === 'emerald_guard' ? 'btn-primary text-white border-primary fw-semibold' : 'btn-outline-secondary bg-white text-dark'"
                                            t-on-click="() => this.applyPreset('emerald_guard')">
                                        <span class="badge rounded-circle" style="background:#0D7A4E; width:10px; height:10px; padding:0;"/>
                                        <span>Emerald Guard</span>
                                        <i t-if="state.selectedPreset === 'emerald_guard'" class="fa fa-check small ms-1"/>
                                    </button>
                                    <button class="btn btn-xs d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill shadow-xs"
                                            t-att-class="state.selectedPreset === 'slate_minimal' ? 'btn-primary text-white border-primary fw-semibold' : 'btn-outline-secondary bg-white text-dark'"
                                            t-on-click="() => this.applyPreset('slate_minimal')">
                                        <span class="badge rounded-circle" style="background:#475569; width:10px; height:10px; padding:0;"/>
                                        <span>Slate Minimal</span>
                                        <i t-if="state.selectedPreset === 'slate_minimal'" class="fa fa-check small ms-1"/>
                                    </button>
                                    <button class="btn btn-xs d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill shadow-xs"
                                            t-att-class="state.selectedPreset === 'tactical_dark' ? 'btn-primary text-white border-primary fw-semibold' : 'btn-outline-secondary bg-white text-dark'"
                                            t-on-click="() => this.applyPreset('tactical_dark')">
                                        <span class="badge rounded-circle" style="background:#1e293b; width:10px; height:10px; padding:0;"/>
                                        <span>Tactical Dark</span>
                                        <i t-if="state.selectedPreset === 'tactical_dark'" class="fa fa-check small ms-1"/>
                                    </button>
                                </div>
                            </div>

                            <!-- Layout & Typography Settings -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                                    <i class="fa fa-sliders text-primary me-1"/> Layout &amp; Typography
                                </h6>
                                
                                <div class="mb-3">
                                    <label class="form-label small text-muted mb-1">Base Layout Structure</label>
                                    <select class="form-select form-select-sm designer-input" t-model="state.templateData.base_layout" t-on-change="onLayoutChange">
                                        <option value="modern">Modern (Crisp borders, clean spacing)</option>
                                        <option value="corporate">Classic Corporate (Formal grid layout)</option>
                                        <option value="minimalist">Minimalist (Subtle rules, open whitespace)</option>
                                        <option value="bold">Bold (Strong accents, boxed cards)</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small text-muted mb-1">Font Family</label>
                                    <select class="form-select form-select-sm designer-input" t-model="state.templateData.font_family" t-on-change="onFontChange">
                                        <option value="Inter">Inter (Professional Clean)</option>
                                        <option value="Roboto">Roboto (Crisp Geometry)</option>
                                        <option value="system-ui">System UI (Native OS Fonts)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Color Palette -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                                    <i class="fa fa-eyedropper text-primary me-1"/> Brand Colors
                                </h6>

                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Primary Color</label>
                                        <div class="d-flex align-items-center gap-1.5">
                                            <input type="color" class="form-control form-control-color p-0.5 border rounded" style="height: 32px; width: 38px; cursor:pointer;" t-model="state.templateData.primary_color" t-on-input="(ev) => this.onColorInput('primary_color', ev.target.value)" t-on-change="triggerPreviewUpdate"/>
                                            <input type="text" maxlength="7" class="form-control form-control-sm font-monospace text-uppercase" style="width: 82px;" t-model="state.templateData.primary_color" t-on-input="(ev) => this.onColorInput('primary_color', ev.target.value)" t-on-change="triggerPreviewUpdate"/>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Secondary Color</label>
                                        <div class="d-flex align-items-center gap-1.5">
                                            <input type="color" class="form-control form-control-color p-0.5 border rounded" style="height: 32px; width: 38px; cursor:pointer;" t-model="state.templateData.secondary_color" t-on-input="(ev) => this.onColorInput('secondary_color', ev.target.value)" t-on-change="triggerPreviewUpdate"/>
                                            <input type="text" maxlength="7" class="form-control form-control-sm font-monospace text-uppercase" style="width: 82px;" t-model="state.templateData.secondary_color" t-on-input="(ev) => this.onColorInput('secondary_color', ev.target.value)" t-on-change="triggerPreviewUpdate"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Header BG</label>
                                        <div class="d-flex align-items-center gap-1.5">
                                            <input type="color" class="form-control form-control-color p-0.5 border rounded" style="height: 32px; width: 38px; cursor:pointer;" t-model="state.templateData.header_bg_color" t-on-input="(ev) => this.onColorInput('header_bg_color', ev.target.value)" t-on-change="triggerPreviewUpdate"/>
                                            <input type="text" maxlength="7" class="form-control form-control-sm font-monospace text-uppercase" style="width: 82px;" t-model="state.templateData.header_bg_color" t-on-input="(ev) => this.onColorInput('header_bg_color', ev.target.value)" t-on-change="triggerPreviewUpdate"/>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Header Text</label>
                                        <div class="d-flex align-items-center gap-1.5">
                                            <input type="color" class="form-control form-control-color p-0.5 border rounded" style="height: 32px; width: 38px; cursor:pointer;" t-model="state.templateData.header_text_color" t-on-input="(ev) => this.onColorInput('header_text_color', ev.target.value)" t-on-change="triggerPreviewUpdate"/>
                                            <input type="text" maxlength="7" class="form-control form-control-sm font-monospace text-uppercase" style="width: 82px;" t-model="state.templateData.header_text_color" t-on-input="(ev) => this.onColorInput('header_text_color', ev.target.value)" t-on-change="triggerPreviewUpdate"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Fast Palette Swatches -->
                                <div class="p-2 border rounded bg-light mt-2">
                                    <div class="small text-muted mb-1.5 fw-semibold" style="font-size: 11px;">Quick Brand Swatches</div>
                                    <div class="d-flex gap-1.5 flex-wrap">
                                        <button type="button" class="btn btn-xs border px-2 py-1 bg-white d-flex align-items-center gap-1 rounded shadow-xs" t-on-click="() => this.setBrandPalette('#1B3A6B', '#0D1117', '#1B3A6B', '#FFFFFF')">
                                            <span style="width:10px;height:10px;border-radius:2px;background:#1B3A6B;display:inline-block;"/> Navy
                                        </button>
                                        <button type="button" class="btn btn-xs border px-2 py-1 bg-white d-flex align-items-center gap-1 rounded shadow-xs" t-on-click="() => this.setBrandPalette('#0D7A4E', '#064E3B', '#0D7A4E', '#FFFFFF')">
                                            <span style="width:10px;height:10px;border-radius:2px;background:#0D7A4E;display:inline-block;"/> Emerald
                                        </button>
                                        <button type="button" class="btn btn-xs border px-2 py-1 bg-white d-flex align-items-center gap-1 rounded shadow-xs" t-on-click="() => this.setBrandPalette('#475569', '#0F172A', '#334155', '#FFFFFF')">
                                            <span style="width:10px;height:10px;border-radius:2px;background:#475569;display:inline-block;"/> Slate
                                        </button>
                                        <button type="button" class="btn btn-xs border px-2 py-1 bg-white d-flex align-items-center gap-1 rounded shadow-xs" t-on-click="() => this.setBrandPalette('#0F172A', '#000000', '#1E293B', '#FFFFFF')">
                                            <span style="width:10px;height:10px;border-radius:2px;background:#0F172A;display:inline-block;"/> Dark
                                        </button>
                                        <button type="button" class="btn btn-xs border px-2 py-1 bg-white d-flex align-items-center gap-1 rounded shadow-xs" t-on-click="() => this.setBrandPalette('#B91C1C', '#450A0A', '#991B1B', '#FFFFFF')">
                                            <span style="width:10px;height:10px;border-radius:2px;background:#B91C1C;display:inline-block;"/> Red
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Logo & Branding -->
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                                    <i class="fa fa-building text-primary me-1"/> Logo &amp; Header
                                </h6>
                                
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="docShowLogo" t-model="state.templateData.show_company_logo" t-on-change="triggerPreviewUpdate"/>
                                    <label class="form-check-label small fw-semibold" for="docShowLogo">Show Company Logo</label>
                                </div>

                                <t t-if="state.templateData.show_company_logo">
                                    <div class="mb-3 ps-3 border-start border-2 ms-1">
                                        <div class="d-flex justify-content-between mb-1">
                                            <label class="form-label small text-muted mb-0">Logo Height</label>
                                            <span class="small fw-bold text-dark"><t t-esc="state.templateData.logo_height"/>px</span>
                                        </div>
                                        <input type="range" class="form-range" min="40" max="140" step="10" t-model="state.templateData.logo_height" t-on-input="triggerPreviewUpdate"/>
                                    </div>
                                    
                                    <div class="mb-3 ps-3 border-start border-2 ms-1">
                                        <label class="form-label small text-muted mb-1">Logo Alignment</label>
                                        <select class="form-select form-select-sm designer-input" t-model="state.templateData.logo_alignment" t-on-change="triggerPreviewUpdate">
                                            <option value="left">Left Aligned</option>
                                            <option value="center">Centered</option>
                                            <option value="right">Right Aligned</option>
                                        </select>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- ── TAB 2: SECTION ORDER ── -->
                        <div t-if="state.activeDrawerTab === 'blocks'">
                            <div class="mb-3">
                                <h6 class="fw-bold mb-1 text-dark">
                                    <i class="fa fa-th-list text-primary me-1"/> Section Arrangement
                                </h6>
                                <p class="small text-muted mb-3">Drag to reorder sections, or use the arrow buttons. Click any section in the live preview to highlight it here.</p>
                            </div>

                            <div class="doc-builder-blocks" t-ref="sortableList">
                                <t t-foreach="state.templateData.blocks" t-as="block" t-key="block">
                                    <div class="doc-builder-block d-flex align-items-center mb-2 p-2.5 border rounded bg-white shadow-xs" t-att-data-block="block">
                                        <div class="doc-drag-handle me-2 text-muted drag-handle" style="cursor: grab; padding: 4px;" title="Drag to reorder">
                                            <i class="fa fa-grip-vertical"/>
                                        </div>
                                        <div class="flex-grow-1">
                                            <span class="fw-semibold small text-dark"><t t-esc="this.getBlockLabel(block)"/></span>
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            <button class="btn btn-xs btn-light border py-0 px-1"
                                                    t-on-click="() => this.moveBlockUp(block_index)"
                                                    t-att-disabled="block_index === 0"
                                                    title="Move Up">
                                                <i class="fa fa-arrow-up text-muted" style="font-size: 10px;"/>
                                            </button>
                                            <button class="btn btn-xs btn-light border py-0 px-1"
                                                    t-on-click="() => this.moveBlockDown(block_index)"
                                                    t-att-disabled="block_index === state.templateData.blocks.length - 1"
                                                    title="Move Down">
                                                <i class="fa fa-arrow-down text-muted" style="font-size: 10px;"/>
                                            </button>
                                            <span class="badge bg-light text-muted border ms-1" style="font-size: 10px;">
                                                <i class="fa fa-eye text-success"/>
                                            </span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- ── TAB 3: CONTENT & RULES ── -->
                        <div t-if="state.activeDrawerTab === 'content'">
                            <div class="mb-4">
                                <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                                    <i class="fa fa-sliders text-primary me-1"/> Display Options
                                </h6>
                                
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="docShowTerms" t-model="state.templateData.show_payment_terms" t-on-change="triggerPreviewUpdate"/>
                                    <label class="form-check-label small fw-semibold" for="docShowTerms">Show Payment Terms</label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="docShowBank" t-model="state.templateData.show_bank_details" t-on-change="triggerPreviewUpdate"/>
                                    <label class="form-check-label small fw-semibold" for="docShowBank">Show Bank &amp; Settlement Details</label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="docShowTaxCol" t-model="state.templateData.show_tax_column" t-on-change="triggerPreviewUpdate"/>
                                    <label class="form-check-label small fw-semibold" for="docShowTaxCol">Show Standalone VAT Column</label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="docShowWatermark" t-model="state.templateData.show_watermark" t-on-change="triggerPreviewUpdate"/>
                                    <label class="form-check-label small fw-semibold" for="docShowWatermark">Show Draft Watermark</label>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark">
                                    <i class="fa fa-pencil text-primary me-1"/> Labels &amp; Custom Notes
                                </h6>

                                <div class="mb-3">
                                    <label class="form-label small text-muted mb-1">Override 'Billed To' Header Label</label>
                                    <input type="text" class="form-control form-control-sm designer-input" placeholder="e.g. Invoice To / Client Details" t-model="state.templateData.label_billed_to" t-on-input="triggerPreviewUpdate"/>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small text-muted mb-1">Custom Footer / Thank-you Note</label>
                                    <textarea class="form-control form-control-sm designer-input" rows="3" placeholder="e.g. Thank you for choosing DogForce Security Services." t-model="state.templateData.custom_footer_note" t-on-input="triggerPreviewUpdate"/>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- RIGHT PANEL: Live Document Canvas Preview -->
                <div class="flex-grow-1 d-flex flex-column bg-white h-100 position-relative" style="overflow-y: auto;">
                    
                    <!-- Toolbar overlay -->
                    <div class="doc-preview-toolbar d-flex align-items-center justify-content-between p-2.5 px-4 bg-white border-bottom shadow-xs" style="z-index: 5;">
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-muted small fw-bold text-uppercase d-flex align-items-center gap-2">
                                <i class="fa fa-desktop text-primary"/> Live Document Preview
                            </span>
                            <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 11px;">
                                A4 Portrait (210 × 297 mm)
                            </span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 text-uppercase" style="font-size: 10.5px; font-weight: 600;">
                                <t t-esc="state.documentType === 'invoice' ? 'Invoice' : 'Quotation'"/>
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-secondary shadow-xs rounded-circle bg-white" t-on-click="refreshPreview" title="Force Refresh">
                                <i class="fa fa-refresh" t-att-class="{'fa-spin': state.isLoading}"/>
                            </button>
                        </div>
                    </div>

                    <!-- Preview Canvas Container -->
                    <div class="flex-grow-1 d-flex justify-content-center p-4 doc-preview-container pcc-preview-container" style="min-height: calc(100vh - 120px);">
                        
                        <!-- Loading spinner overlay -->
                        <div t-if="state.isLoading" class="position-absolute w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(255,255,255,0.7); z-index: 10; top: 0; left: 0; backdrop-filter: blur(3px); transition: all 0.3s;">
                            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">Loading…</span>
                            </div>
                        </div>

                        <!-- Scalable Paper Sheet -->
                        <div class="doc-paper-sheet pcc-paper-sheet shadow border bg-white position-relative my-3"
                             t-attf-style="width: 21cm; min-height: 29.7cm; padding: 1.2cm 1.5cm; border-radius: 4px; transition: transform 0.2s ease-out; transform-origin: top center; transform: scale({{ state.zoomScale / 100 }});">
                            
                            <t t-if="state.previewHtml" t-out="state.previewHtml" class="w-100 h-100"/>
                            
                            <t t-if="state.errorMsg">
                                <div class="alert alert-danger m-4">
                                    <i class="fa fa-exclamation-triangle me-2"/> <t t-esc="state.errorMsg"/>
                                </div>
                            </t>

                            <t t-if="!state.previewHtml and !state.isLoading and !state.errorMsg">
                                <div class="text-center text-muted mt-5 pt-5">
                                    <i class="fa fa-file-text-o fa-3x mb-3 opacity-25"/>
                                    <h5>Preview Unavailable</h5>
                                    <p class="small">Adjust a setting to generate the live preview.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
