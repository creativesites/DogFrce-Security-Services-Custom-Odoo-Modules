<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="security_billing.DocumentDesigner" owl="1">
        <div class="doc-designer-container o_content d-flex flex-column h-100 w-100 bg-light">
            <!-- Header Tabs and save toolbar -->
            <div class="designer-tabs d-flex justify-content-between align-items-center bg-dark shadow-md" style="height: 52px; z-index: 10;">
                <div class="d-flex h-100">
                    <div class="designer-tab d-flex align-items-center px-4 cursor-pointer fw-bold border-end border-secondary" t-att-class="state.documentType === 'invoice' ? 'active bg-white text-dark' : 'text-white-50'" t-on-click="() => this.setDocumentType('invoice')">
                        <i class="fa fa-file-text me-2"></i> Invoice Template
                    </div>
                    <div class="designer-tab d-flex align-items-center px-4 cursor-pointer fw-bold border-end border-secondary" t-att-class="state.documentType === 'quotation' ? 'active bg-white text-dark' : 'text-white-50'" t-on-click="() => this.setDocumentType('quotation')">
                        <i class="fa fa-file-o me-2"></i> Quotation Template
                    </div>
                </div>
                <div class="pe-3 d-flex gap-2">
                    <button class="btn btn-sm btn-outline-danger px-3 shadow-sm rounded-pill fw-bold" t-on-click="resetTemplate">
                        <i class="fa fa-undo"></i> Reset
                    </button>
                    <button class="btn btn-sm btn-success px-4 fw-bold shadow-sm rounded-pill" t-on-click="saveTemplate">
                        <i t-att-class="state.isLoading ? 'fa fa-spinner fa-spin' : 'fa fa-save'"/> Save Template
                    </button>
                </div>
            </div>

            <div class="d-flex flex-row flex-grow-1 overflow-hidden h-100 w-100">
                <!-- Left Sidebar Settings -->
                <div class="designer-sidebar d-flex flex-column h-100 shadow-lg" style="width: 390px; min-width: 390px; background: #ffffff; border-right: 1px solid #e2e8f0; z-index: 9; overflow-y: auto;">
                    
                    <!-- Quick Presets -->
                    <div class="settings-group p-3 border-bottom">
                        <label class="form-label fw-bold small text-uppercase text-muted mb-2"><i class="fa fa-magic text-success me-1"/> Quick Presets</label>
                        <div class="d-flex flex-wrap gap-1.5">
                            <button class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill bg-white shadow-sm" t-on-click="() => this.applyPreset('slate')">
                                <span class="badge rounded-circle" style="background:#475569; width:10px; height:10px; padding:0;"/> Slate
                            </button>
                            <button class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill bg-white shadow-sm" t-on-click="() => this.applyPreset('emerald')">
                                <span class="badge rounded-circle" style="background:#10b981; width:10px; height:10px; padding:0;"/> Emerald
                            </button>
                            <button class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill bg-white shadow-sm" t-on-click="() => this.applyPreset('midnight')">
                                <span class="badge rounded-circle" style="background:#2563eb; width:10px; height:10px; padding:0;"/> Midnight
                            </button>
                            <button class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill bg-white shadow-sm" t-on-click="() => this.applyPreset('tactical')">
                                <span class="badge rounded-circle" style="background:#1e293b; width:10px; height:10px; padding:0;"/> Tactical
                            </button>
                        </div>
                    </div>

                    <!-- Layout & Styling -->
                    <div class="settings-group p-3 border-bottom">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="fa fa-sliders text-success me-1"/> Layout &amp; Styles</h6>
                        
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1">Base Layout Structure</label>
                            <select class="form-select form-select-sm designer-input" t-model="state.templateData.base_layout" t-on-change="triggerPreviewUpdate">
                                <option value="modern">Modern (Thin lines, sleek)</option>
                                <option value="classic">Classic Corporate (Grids, formal)</option>
                                <option value="minimalist">Minimalist (Subtle, elegant)</option>
                                <option value="bold">Bold (Strong accents, cards)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1">Typography</label>
                            <select class="form-select form-select-sm designer-input" t-model="state.templateData.font_family" t-on-change="triggerPreviewUpdate">
                                <option value="Inter">Inter (Modern)</option>
                                <option value="Roboto">Roboto (Clean)</option>
                                <option value="system-ui">System UI (Native)</option>
                            </select>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Primary Color</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="color" class="form-control form-control-color p-1 border rounded" style="height: 32px; width: 42px; cursor:pointer;" t-model="state.templateData.primary_color" t-on-change="triggerPreviewUpdate"/>
                                    <span class="small text-muted font-monospace" t-esc="state.templateData.primary_color"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Secondary Color</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="color" class="form-control form-control-color p-1 border rounded" style="height: 32px; width: 42px; cursor:pointer;" t-model="state.templateData.secondary_color" t-on-change="triggerPreviewUpdate"/>
                                    <span class="small text-muted font-monospace" t-esc="state.templateData.secondary_color"/>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Table Header BG</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="color" class="form-control form-control-color p-1 border rounded" style="height: 32px; width: 42px; cursor:pointer;" t-model="state.templateData.header_bg_color" t-on-change="triggerPreviewUpdate"/>
                                    <span class="small text-muted font-monospace" t-esc="state.templateData.header_bg_color"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Table Header Text</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="color" class="form-control form-control-color p-1 border rounded" style="height: 32px; width: 42px; cursor:pointer;" t-model="state.templateData.header_text_color" t-on-change="triggerPreviewUpdate"/>
                                    <span class="small text-muted font-monospace" t-esc="state.templateData.header_text_color"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Branding Toggles & Sliders -->
                    <div class="settings-group p-3 border-bottom">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="fa fa-building text-success me-1"/> Logo &amp; Branding</h6>
                        
                        <div class="form-check form-switch mb-2.5">
                            <input class="form-check-input" type="checkbox" id="showLogo" t-model="state.templateData.show_company_logo" t-on-change="triggerPreviewUpdate"/>
                            <label class="form-check-label small" for="showLogo">Show Company Logo</label>
                        </div>

                        <t t-if="state.templateData.show_company_logo">
                            <div class="mb-3 ps-2 border-start border-light-dark ms-1">
                                <label class="form-label small text-muted mb-1">Logo Height (<span t-esc="state.templateData.logo_height"/>px)</label>
                                <input type="range" class="form-range" min="40" max="140" step="10" t-model="state.templateData.logo_height" t-on-input="triggerPreviewUpdate"/>
                            </div>
                            
                            <div class="mb-3 ps-2 border-start border-light-dark ms-1">
                                <label class="form-label small text-muted mb-1">Logo Alignment</label>
                                <select class="form-select form-select-sm designer-input" t-model="state.templateData.logo_alignment" t-on-change="triggerPreviewUpdate">
                                    <option value="left">Left Aligned</option>
                                    <option value="center">Centered</option>
                                    <option value="right">Right Aligned</option>
                                </select>
                            </div>
                        </t>

                        <div class="form-check form-switch mb-2.5">
                            <input class="form-check-input" type="checkbox" id="showTaxCol" t-model="state.templateData.show_tax_column" t-on-change="triggerPreviewUpdate"/>
                            <label class="form-check-label small" for="showTaxCol">Show Standalone VAT Column</label>
                        </div>

                        <div class="form-check form-switch mb-2.5">
                            <input class="form-check-input" type="checkbox" id="showWatermark" t-model="state.templateData.show_watermark" t-on-change="triggerPreviewUpdate"/>
                            <label class="form-check-label small" for="showWatermark">Draft Watermark</label>
                        </div>
                    </div>

                    <!-- Content Toggles -->
                    <div class="settings-group p-3 border-bottom">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="fa fa-list-ul text-success me-1"/> Content Options</h6>
                        
                        <div class="form-check form-switch mb-2.5">
                            <input class="form-check-input" type="checkbox" id="showTerms" t-model="state.templateData.show_payment_terms" t-on-change="triggerPreviewUpdate"/>
                            <label class="form-check-label small" for="showTerms">Show Payment Terms</label>
                        </div>
                        <div class="form-check form-switch mb-2.5">
                            <input class="form-check-input" type="checkbox" id="showBank" t-model="state.templateData.show_bank_details" t-on-change="triggerPreviewUpdate"/>
                            <label class="form-check-label small" for="showBank">Show Bank Details</label>
                        </div>

                        <div class="mt-3">
                            <label class="form-label small text-muted mb-1">Override 'Billed To' Label</label>
                            <input type="text" class="form-control form-control-sm designer-input" placeholder="e.g. Invoice To" t-model="state.templateData.label_billed_to" t-on-input="triggerPreviewUpdate"/>
                        </div>

                        <div class="mt-3">
                            <label class="form-label small text-muted mb-1">Custom Note / Thank-you message</label>
                            <textarea class="form-control form-control-sm designer-input" rows="2" placeholder="Thank you for your business!" t-model="state.templateData.custom_footer_note" t-on-input="triggerPreviewUpdate"/>
                        </div>
                    </div>

                    <!-- Block Ordering -->
                    <div class="settings-group p-3 mb-4">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="fa fa-th-list text-success me-1"/> Layout Builder</h6>
                        <p class="small text-muted mb-3">Drag to reorder sections. Use the handle on the left.</p>
                        
                        <div class="pcc-builder-blocks" t-ref="sortableList">
                            <t t-foreach="state.templateData.blocks" t-as="block" t-key="block">
                                <div class="pcc-builder-block d-flex align-items-center mb-2 p-2.5 border rounded bg-white shadow-sm" t-att-data-block="block">
                                    <div class="pcc-drag-handle me-3 text-muted drag-handle" style="cursor: grab; padding: 5px;">
                                        <i class="fa fa-grip-vertical"/>
                                    </div>
                                    <div class="flex-grow-1">
                                        <span class="fw-bold small text-dark text-capitalize"><t t-esc="block.replace('_', ' ')"/></span>
                                    </div>
                                    <div>
                                        <i class="fa fa-eye text-success small"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Right Live Preview Panel -->
                <div class="flex-grow-1 d-flex flex-column bg-white h-100 position-relative" style="overflow-y: auto;">
                    <!-- Toolbar overlay -->
                    <div class="pcc-preview-toolbar d-flex align-items-center justify-content-between p-2.5 px-4 shadow-sm" style="background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); z-index: 5; border-bottom: 1px solid #e2e8f0;">
                        <div class="text-muted small fw-bold text-uppercase d-flex align-items-center gap-2"><i class="fa fa-desktop text-success"/> Live Canvas Preview</div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-primary px-3 shadow-sm rounded-pill fw-bold" t-on-click="openPdfPreview" title="Open PDF Report">
                                <i class="fa fa-file-pdf-o me-1"/> PDF Preview
                            </button>
                            <button class="btn btn-sm btn-outline-secondary shadow-sm rounded-circle bg-white" t-on-click="refreshPreview" title="Force Refresh">
                                <i class="fa fa-refresh" t-att-class="{'fa-spin': state.isLoading}"/>
                            </button>
                        </div>
                    </div>

                    <!-- Preview Canvas -->
                    <div class="flex-grow-1 d-flex justify-content-center p-4 pcc-preview-container" style="background: #ffffff; min-height: calc(100vh - 120px);">
                        
                        <!-- Loading spinner -->
                        <div t-if="state.isLoading" class="position-absolute w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(255,255,255,0.7); z-index: 10; top: 0; left: 0; backdrop-filter: blur(3px); transition: all 0.3s;">
                            <div class="spinner-border text-success" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>

                        <!-- The paper sheet -->
                        <div class="pcc-paper-sheet shadow border bg-white position-relative my-3" style="width: 21cm; min-height: 29.7cm; padding: 1.2cm 1.5cm; border-radius: 4px; transition: all 0.3s ease;">
                            
                            <t t-if="state.previewHtml" t-out="state.previewHtml" class="w-100 h-100"></t>
                            
                            <t t-if="state.errorMsg">
                                <div class="alert alert-danger m-4">
                                    <i class="fa fa-exclamation-triangle me-2"></i> <t t-esc="state.errorMsg"/>
                                </div>
                            </t>

                            <t t-if="!state.previewHtml and !state.isLoading and !state.errorMsg">
                                <div class="text-center text-muted mt-5 pt-5">
                                    <i class="fa fa-file-text-o fa-3x mb-3 opacity-25"/>
                                    <h5>Preview Unavailable</h5>
                                    <p class="small">Change a setting to generate the preview.</p>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
