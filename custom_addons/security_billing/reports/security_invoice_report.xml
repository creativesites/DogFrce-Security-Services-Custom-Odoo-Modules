<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_security_invoice" model="ir.actions.report">
        <field name="name">Security Invoice</field>
        <field name="model">security.billing.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">security_billing.report_security_invoice</field>
        <field name="report_file">security_billing.report_security_invoice</field>
        <field name="binding_model_id" ref="model_security_billing_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Modular sub-templates for Document Designer -->

    <template id="report_document_header">
        <div class="row mb-4 border-bottom pb-3 align-items-center">
            <div t-attf-class="col-12 d-flex justify-content-{{ tmpl_settings.get('logo_alignment') }} mb-3" t-if="tmpl_settings.get('show_company_logo')">
                <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" t-attf-style="max-height: {{ tmpl_settings.get('logo_height') }}px;" alt="Logo"/>
            </div>
            <div class="col-12 d-flex justify-content-between align-items-center">
                <h2 class="doc-primary fw-bold text-uppercase mb-0" style="letter-spacing: 1px;">
                    <t t-if="doc._name == 'security.billing.invoice'">Tax Invoice</t>
                    <t t-else="">Quotation</t>
                </h2>
                <span class="badge doc-bg-primary text-white p-2 text-uppercase" style="font-size: 11px;">
                    <t t-esc="doc.state"/>
                </span>
            </div>
        </div>
    </template>

    <template id="report_document_client_info">
        <div class="row mb-4 align-items-start">
            <div class="col-6">
                <h5 class="doc-secondary fw-bold border-bottom pb-1 mb-2"><t t-esc="tmpl_settings.get('label_billed_to')"/></h5>
                <t t-if="doc.partner_id">
                    <div class="fw-bold"><span t-esc="doc.partner_id.name"/></div>
                    <div t-if="doc.partner_id.street"><span t-esc="doc.partner_id.street"/></div>
                    <div t-if="doc.partner_id.city"><span t-esc="doc.partner_id.city"/></div>
                    <div t-if="doc.partner_id.phone"><span t-esc="doc.partner_id.phone"/></div>
                    <div t-if="doc.partner_id.vat">VAT: <span t-esc="doc.partner_id.vat"/></div>
                </t>
                <t t-else="">
                    <div class="fw-bold text-muted">Valued Customer</div>
                </t>
            </div>
            <div class="col-6 text-end">
                <h5 class="doc-secondary fw-bold border-bottom pb-1 mb-2">Document Details</h5>
                <table class="table table-sm table-borderless small w-100">
                    <tr><td class="text-muted text-end">Reference:</td><td class="fw-bold text-end"><span t-esc="doc.name"/></td></tr>
                    <t t-if="doc._name == 'security.billing.invoice'">
                        <tr><td class="text-muted text-end">Date:</td><td class="text-end">
                            <span t-esc="doc.invoice_date"/>
                        </td></tr>
                        <tr><td class="text-muted text-end">Due Date:</td><td class="fw-bold text-danger text-end">
                            <span t-esc="doc.due_date or doc.invoice_date_due"/>
                        </td></tr>
                    </t>
                    <t t-else="">
                        <tr><td class="text-muted text-end">Date:</td><td class="text-end">
                            <span t-esc="doc.date_order"/>
                        </td></tr>
                        <tr><td class="text-muted text-end">Valid Until:</td><td class="text-end">
                            <span t-esc="doc.validity_date"/>
                        </td></tr>
                    </t>
                </table>
            </div>
        </div>
    </template>

    <template id="report_document_line_items">
        <table class="table table-sm o_main_table mb-4">
            <thead t-attf-style="background-color: {{ tmpl_settings.get('header_bg_color') }} !important; color: {{ tmpl_settings.get('header_text_color') }} !important;">
                <tr>
                    <th class="py-2" t-attf-style="color: {{ tmpl_settings.get('header_text_color') }} !important; background-color: {{ tmpl_settings.get('header_bg_color') }} !important;">Description</th>
                    <th class="text-end py-2" t-attf-style="color: {{ tmpl_settings.get('header_text_color') }} !important; background-color: {{ tmpl_settings.get('header_bg_color') }} !important;">Qty</th>
                    <th class="text-end py-2" t-attf-style="color: {{ tmpl_settings.get('header_text_color') }} !important; background-color: {{ tmpl_settings.get('header_bg_color') }} !important;">Rate</th>
                    <th t-if="tmpl_settings.get('show_tax_column')" class="text-end py-2" t-attf-style="color: {{ tmpl_settings.get('header_text_color') }} !important; background-color: {{ tmpl_settings.get('header_bg_color') }} !important;">Tax</th>
                    <th class="text-end py-2" t-attf-style="color: {{ tmpl_settings.get('header_text_color') }} !important; background-color: {{ tmpl_settings.get('header_bg_color') }} !important;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <t t-if="doc._name == 'security.billing.invoice'">
                    <tr t-foreach="doc.line_ids or doc.invoice_line_ids" t-as="line">
                        <td class="py-2"><span t-esc="line.name"/></td>
                        <td class="text-end py-2"><span t-esc="line.quantity"/></td>
                        <td class="text-end py-2">
                            <span t-esc="line.price_unit or line.unit_price"/>
                        </td>
                        <td t-if="tmpl_settings.get('show_tax_column')" class="text-end py-2">
                            <span t-esc="', '.join([t.name for t in line.tax_ids]) if line.tax_ids else 'VAT 15%'"/>
                        </td>
                        <td class="text-end py-2 fw-bold">
                            <span t-esc="line.price_subtotal or line.subtotal"/>
                        </td>
                    </tr>
                </t>
                <t t-else="">
                    <tr t-foreach="doc.order_line" t-as="line">
                        <td class="py-2"><span t-esc="line.name"/></td>
                        <td class="text-end py-2">
                            <span t-esc="line.product_uom_qty or line.quantity"/>
                        </td>
                        <td class="text-end py-2"><span t-esc="line.price_unit"/></td>
                        <td t-if="tmpl_settings.get('show_tax_column')" class="text-end py-2">
                            <span t-esc="', '.join([t.name for t in line.tax_ids]) if line.tax_ids else 'VAT 15%'"/>
                        </td>
                        <td class="text-end py-2 fw-bold"><span t-esc="line.price_subtotal"/></td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>

    <template id="report_document_totals">
        <div class="row mb-5">
            <div class="col-6">
                <!-- Custom Footer Note / Thank You message -->
                <div t-if="tmpl_settings.get('custom_footer_note')" class="p-3 border rounded shadow-sm bg-light text-muted small" t-attf-style="border-left: 4px solid {{ tmpl_settings.get('primary_color') }} !important;">
                    <i class="fa fa-info-circle me-1 doc-primary"/> <t t-esc="tmpl_settings.get('custom_footer_note')"/>
                </div>
            </div>
            <div class="col-6">
                <table class="table table-sm table-borderless">
                    <t t-if="doc._name == 'security.billing.invoice'">
                        <tr>
                            <td class="text-muted">Subtotal</td>
                            <td class="text-end">
                                <span t-esc="doc.subtotal_amount"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted border-bottom pb-2">VAT</td>
                            <td class="text-end border-bottom pb-2">
                                <span t-esc="doc.vat_amount"/>
                            </td>
                        </tr>
                        <tr>
                            <td class="fs-5 fw-bold doc-primary pt-2">Total</td>
                            <td class="fs-5 fw-bold text-end pt-2">
                                <span t-esc="doc.total_amount"/>
                            </td>
                        </tr>
                    </t>
                    <t t-else="">
                        <tr><td class="text-muted">Subtotal</td><td class="text-end"><span t-esc="doc.amount_untaxed"/></td></tr>
                        <tr><td class="text-muted border-bottom pb-2">VAT</td><td class="text-end border-bottom pb-2"><span t-esc="doc.amount_tax"/></td></tr>
                        <tr><td class="fs-5 fw-bold doc-primary pt-2">Total</td><td class="fs-5 fw-bold text-end pt-2"><span t-esc="doc.amount_total"/></td></tr>
                    </t>
                </table>
            </div>
        </div>
    </template>

    <template id="report_document_terms">
        <div t-if="tmpl_settings.get('show_payment_terms')" class="mb-4">
            <h6 class="fw-bold doc-secondary">Payment Terms</h6>
            <p class="small text-muted">
                <span t-if="doc.note" t-field="doc.note"/>
                <span t-else="">Payment is due within 30 days from the invoice date. Please make deposits to our bank account below.</span>
            </p>
        </div>
        
        <div t-if="tmpl_settings.get('show_bank_details')" class="card bg-light border-0 p-3 small mb-4">
            <h6 class="fw-bold doc-secondary mb-2">Banking Details</h6>
            <div class="row">
                <div class="col-6">
                    <div><strong>Bank:</strong> First National Bank (Namibia)</div>
                    <div><strong>Account Name:</strong> <span t-esc="res_company.name"/></div>
                </div>
                <div class="col-6">
                    <div><strong>Account Number:</strong> 6288192312</div>
                    <div><strong>Branch Code:</strong> 280172</div>
                </div>
            </div>
        </div>
    </template>

    <template id="report_document_footer">
        <div class="text-center small text-muted border-top pt-3 mt-5">
            <p class="mb-1"><span t-esc="res_company.name"/> | <span t-esc="res_company.street or 'Independence Ave'"/>, <span t-esc="res_company.city or 'Windhoek'"/>, <span t-esc="res_company.country_id.name or 'Namibia'"/></p>
            <p class="mb-0">Tel: <span t-esc="res_company.phone or '+264 61 290 2000'"/> | Email: <span t-esc="res_company.email or 'accounts@dogforce.com.na'"/> | Web: <span t-esc="res_company.website or 'www.dogforce.com.na'"/></p>
        </div>
    </template>


    <!-- Main dynamic template for Invoices -->
    <template id="report_security_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    
                    <t t-set="tmpl_data" t-value="template_data or {}"/>
                    <t t-set="tmpl_id" t-value="doc.template_id or False"/>
                    <t t-set="tmpl_settings" t-value="{
                        'font_family': tmpl_data.get('font_family') or (tmpl_id and tmpl_id.font_family) or 'Inter',
                        'primary_color': tmpl_data.get('primary_color') or (tmpl_id and tmpl_id.primary_color) or '#10b981',
                        'secondary_color': tmpl_data.get('secondary_color') or (tmpl_id and tmpl_id.secondary_color) or '#0f172a',
                        'base_layout': tmpl_data.get('base_layout') or (tmpl_id and tmpl_id.base_layout) or 'modern',
                        'show_payment_terms': tmpl_data.get('show_payment_terms', True) if 'show_payment_terms' in tmpl_data else (tmpl_id.show_payment_terms if tmpl_id else True),
                        'show_bank_details': tmpl_data.get('show_bank_details', True) if 'show_bank_details' in tmpl_data else (tmpl_id.show_bank_details if tmpl_id else True),
                        'show_company_logo': tmpl_data.get('show_company_logo', True) if 'show_company_logo' in tmpl_data else (tmpl_id.show_company_logo if tmpl_id else True),
                        'show_watermark': tmpl_data.get('show_watermark', False) if 'show_watermark' in tmpl_data else (tmpl_id.show_watermark if tmpl_id else False),
                        'show_tax_column': tmpl_data.get('show_tax_column', True) if 'show_tax_column' in tmpl_data else (tmpl_id.show_tax_column if tmpl_id else True),
                        'logo_height': tmpl_data.get('logo_height') or (tmpl_id and tmpl_id.logo_height) or 60,
                        'logo_alignment': tmpl_data.get('logo_alignment') or (tmpl_id and tmpl_id.logo_alignment) or 'left',
                        'custom_footer_note': tmpl_data.get('custom_footer_note') or (tmpl_id and tmpl_id.custom_footer_note) or '',
                        'header_bg_color': tmpl_data.get('header_bg_color') or (tmpl_id and tmpl_id.header_bg_color) or '#1e293b',
                        'header_text_color': tmpl_data.get('header_text_color') or (tmpl_id and tmpl_id.header_text_color) or '#ffffff',
                        'label_billed_to': tmpl_data.get('label_billed_to') or (tmpl_id and tmpl_id.label_billed_to) or 'Billed To',
                        'blocks': tmpl_data.get('blocks') or (tmpl_id and tmpl_id.block_order and json.loads(tmpl_id.block_order)) or ['header', 'client_info', 'line_items', 'totals', 'terms', 'footer']
                    }"/>

                    <style>
                        .doc-page {
                            font-family: '<t t-esc="tmpl_settings.get('font_family')"/>', Helvetica, Arial, sans-serif;
                            color: #334155;
                            font-size: 14px;
                            line-height: 1.5;
                        }
                        .doc-primary { color: <t t-esc="tmpl_settings.get('primary_color')"/> !important; }
                        .doc-bg-primary { background-color: <t t-esc="tmpl_settings.get('primary_color')"/> !important; }
                        .doc-secondary { color: <t t-esc="tmpl_settings.get('secondary_color')"/> !important; }
                        .doc-bg-secondary { background-color: <t t-esc="tmpl_settings.get('secondary_color')"/> !important; }
                        
                        /* Interactive designer style wrappers */
                        .preview-block-wrapper {
                            transition: all 0.2s ease;
                            border: 2px solid transparent;
                            border-radius: 4px;
                            cursor: pointer;
                        }
                        .preview-block-wrapper:hover {
                            border-color: rgba(16, 185, 129, 0.4) !important;
                            background: rgba(16, 185, 129, 0.01);
                        }
                        
                        /* Base layout variants */
                        .layout-corporate .table {
                            border: 1px solid #94a3b8 !important;
                        }
                        .layout-corporate th {
                            border: 1px solid #cbd5e1 !important;
                            background-color: <t t-esc="tmpl_settings.get('header_bg_color')"/> !important;
                            color: <t t-esc="tmpl_settings.get('header_text_color')"/> !important;
                        }
                        .layout-corporate .card, .layout-corporate .border {
                            border: 1px solid #cbd5e1 !important;
                            border-radius: 4px !important;
                        }
                        
                        .layout-minimalist .card {
                            background: transparent !important;
                            border: none !important;
                            padding: 0 !important;
                        }
                        .layout-minimalist .border {
                            border: none !important;
                            border-bottom: 1px solid #e2e8f0 !important;
                            border-radius: 0 !important;
                        }
                        .layout-minimalist .table, .layout-minimalist td, .layout-minimalist th {
                            border: none !important;
                            border-bottom: 1px solid #e2e8f0 !important;
                        }
                        .layout-minimalist th {
                            background: transparent !important;
                            color: #0f172a !important;
                            font-weight: bold !important;
                        }
                        
                        .layout-bold th {
                            background-color: <t t-esc="tmpl_settings.get('primary_color')"/> !important;
                            color: white !important;
                        }
                        .layout-bold .card {
                            border-left: 5px solid <t t-esc="tmpl_settings.get('primary_color')"/> !important;
                            border-radius: 4px;
                        }
                        .layout-bold .table {
                            border: 2px solid <t t-esc="tmpl_settings.get('primary_color')"/> !important;
                        }
                    </style>

                    <div t-attf-class="page doc-page position-relative layout-{{ tmpl_settings.get('base_layout') }}">
                        <t t-if="tmpl_settings.get('show_watermark')">
                            <div class="position-absolute w-100 h-100 d-flex justify-content-center align-items-center" style="z-index:-1; opacity:0.04; font-size:120px; font-weight:bold; transform:rotate(-45deg);">
                                DRAFT
                            </div>
                        </t>

                        <t t-foreach="tmpl_settings.get('blocks')" t-as="block">
                            <div t-att-data-block-id="block" class="preview-block-wrapper">
                                <t t-if="block == 'header'"><t t-call="security_billing.report_document_header"/></t>
                                <t t-if="block == 'client_info'"><t t-call="security_billing.report_document_client_info"/></t>
                                <t t-if="block == 'line_items'"><t t-call="security_billing.report_document_line_items"/></t>
                                <t t-if="block == 'totals'"><t t-call="security_billing.report_document_totals"/></t>
                                <t t-if="block == 'terms'"><t t-call="security_billing.report_document_terms"/></t>
                                <t t-if="block == 'footer'"><t t-call="security_billing.report_document_footer"/></t>
                            </div>
                        </t>
                    </div>

                </t>
            </t>
        </t>
    </template>
</odoo>
