        <!-- Multi-Company Tenant Isolation Rule for Security Notifications -->
        <record id="security_notification_comp_rule" model="ir.rule">
            <field name="name">Security Notification Multi-Company Rule</field>
            <field name="model_id" ref="model_security_notification"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
