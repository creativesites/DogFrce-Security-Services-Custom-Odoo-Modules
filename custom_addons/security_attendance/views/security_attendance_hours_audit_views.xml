<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      HR hours equity audit. Read-only lens onto security.attendance.record,
      never changes a roster or attendance record. See
      docs/ROSTERING_SIMPLIFICATION_PLAN.md §3/A7b.
    -->

    <record id="view_security_attendance_hours_audit_form" model="ir.ui.view">
        <field name="name">security.attendance.hours.audit.form</field>
        <field name="model">security.attendance.hours.audit</field>
        <field name="arch" type="xml">
            <form string="HR Hours Equity Audit">
                <sheet>
                    <div class="oe_title">
                        <h1>HR Hours Equity Audit</h1>
                        <p class="text-muted">
                            Total payable hours per guard over a period, compared against the
                            team average. This never changes a roster or attendance record —
                            it is a read-only check for HR.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="site_id"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="status" invisible="not line_ids">
                        Team average: <field name="average_payable_hours" nolabel="1" readonly="1" widget="float" digits="[16,1]"/> hours.
                        <field name="over_count" nolabel="1" readonly="1"/> guard(s) over the band,
                        <field name="under_count" nolabel="1" readonly="1"/> under.
                    </div>

                    <field name="line_ids" nolabel="1">
                        <list create="0" edit="0" delete="0" default_order="payable_hours desc">
                            <field name="employee_id"/>
                            <field name="payable_hours" sum="Total"/>
                            <field name="variance_pct" string="Variance vs. avg (%)"/>
                            <field name="flag" widget="badge"
                                   decoration-danger="flag == 'over'"
                                   decoration-warning="flag == 'under'"
                                   decoration-success="flag == 'normal'"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_run" type="object" string="Run Audit" class="btn-primary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- date_from/date_to default on the wizard's Python fields (first of
         the current month, today) rather than here — no risk of relying on
         relativedelta being in the act_window context eval globals. -->
    <record id="action_security_attendance_hours_audit" model="ir.actions.act_window">
        <field name="name">HR Hours Equity Audit</field>
        <field name="res_model">security.attendance.hours.audit</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_security_attendance_hours_audit"
        name="HR Hours Equity Audit"
        parent="security_base.menu_security_root"
        action="action_security_attendance_hours_audit"
        sequence="45"
        groups="security_base.group_security_hr_payroll_officer,security_base.group_security_manager,security_base.group_security_owner"
    />
</odoo>
