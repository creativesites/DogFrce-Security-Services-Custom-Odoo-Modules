<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="security_attendance.AttendanceSummaryGrid">
<div class="ag-root o_action" style="height:100%;overflow-y:auto;">

    <t t-if="state.loading">
        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:400px;gap:16px;color:#64748b;">
            <div class="spinner-border text-success" style="width: 3rem; height: 3rem; border-width: 0.25em;"/>
            <span class="fs-5 fw-semibold" style="letter-spacing:-0.01em;">Loading Attendance Matrix…</span>
        </div>
    </t>

    <t t-elif="state.data">
        <t t-set="d" t-value="state.data"/>

        <!-- Header Banner -->
        <div class="ag-header">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="ag-title-icon">
                        <i class="fa fa-calendar-check-o"/>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h3 class="m-0 text-white fw-bold" style="letter-spacing:-0.02em;">Attendance Summary Grid</h3>
                            <div class="ag-live-indicator">
                                <span class="ag-live-dot"/>Live Sync
                            </div>
                        </div>
                        <span style="color:rgba(255,255,255,0.7);font-size:13px;">
                            Operational Attendance &amp; Guard Compliance Matrix for <strong class="text-white"><t t-esc="d.month_label"/></strong>
                        </span>
                    </div>
                </div>

                <!-- Controls & Filters -->
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <!-- Site selector -->
                    <select class="ag-select-site"
                            t-on-change="(e) => this.setSite(e.target.value)">
                        <option value="">🏢 All Security Sites</option>
                        <t t-foreach="d.sites" t-as="site" t-key="site.id">
                            <option t-att-value="site.id"
                                    t-att-selected="state.filterSiteId == site.id">
                                <t t-esc="site.name"/>
                            </option>
                        </t>
                    </select>

                    <!-- Month Nav Bar -->
                    <div class="d-flex align-items-center rounded-3 p-1" style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);">
                        <button class="ag-control-btn py-1 px-2 border-0" t-on-click="prevMonth" title="Previous Month">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <span class="text-white fw-bold px-3" style="font-size:13px;min-width:110px;text-align:center;">
                            <t t-esc="d.month_label"/>
                        </span>
                        <button class="ag-control-btn py-1 px-2 border-0" t-on-click="nextMonth" title="Next Month">
                            <i class="fa fa-chevron-right"/>
                        </button>
                    </div>

                    <!-- Today / Reset button -->
                    <button class="ag-control-btn" t-on-click="goToday" title="Current Month">
                        <i class="fa fa-calendar me-1"/>Current
                    </button>

                    <!-- Export button -->
                    <button class="ag-control-btn" style="background:#10b981;border-color:#10b981;" t-on-click="exportCsv" title="Export CSV Report">
                        <i class="fa fa-download me-1"/>Export CSV
                    </button>
                </div>
            </div>
        </div>

        <div class="p-4">
            <!-- Executive KPI Cards -->
            <div class="row g-3 mb-4">
                <!-- Scheduled -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="ag-kpi-card ag-kpi-border-blue">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="ag-kpi-label">Scheduled Slots</span>
                            <div class="ag-kpi-icon-wrapper ag-kpi-icon-blue">
                                <i class="fa fa-calendar"/>
                            </div>
                        </div>
                        <div class="ag-kpi-value"><t t-esc="d.totals.scheduled"/></div>
                        <span class="text-muted" style="font-size:12px;">Assigned guard shifts</span>
                    </div>
                </div>

                <!-- Present -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="ag-kpi-card ag-kpi-border-emerald">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="ag-kpi-label">Present Turnout</span>
                            <div class="ag-kpi-icon-wrapper ag-kpi-icon-emerald">
                                <i class="fa fa-user-check"/>
                            </div>
                        </div>
                        <div class="ag-kpi-value text-success"><t t-esc="d.totals.present"/></div>
                        <span class="text-muted" style="font-size:12px;">Verified guard check-ins</span>
                    </div>
                </div>

                <!-- Absent -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="ag-kpi-card ag-kpi-border-amber">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="ag-kpi-label">Absences</span>
                            <div class="ag-kpi-icon-wrapper ag-kpi-icon-amber">
                                <i class="fa fa-user-times"/>
                            </div>
                        </div>
                        <div class="ag-kpi-value text-warning"><t t-esc="d.totals.absent"/></div>
                        <span class="text-muted" style="font-size:12px;">Excused / unexcused</span>
                    </div>
                </div>

                <!-- AWOL -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="ag-kpi-card ag-kpi-border-rose">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="ag-kpi-label">AWOL Violations</span>
                            <div class="ag-kpi-icon-wrapper ag-kpi-icon-rose">
                                <i class="fa fa-exclamation-triangle"/>
                            </div>
                        </div>
                        <div class="ag-kpi-value text-danger"><t t-esc="d.totals.awol"/></div>
                        <span class="text-muted" style="font-size:12px;">Unexplained no-shows</span>
                    </div>
                </div>

                <!-- Compliance Rate -->
                <div class="col-12 col-sm-6 col-xl">
                    <div class="ag-kpi-card ag-kpi-border-purple">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="ag-kpi-label">Compliance Rate</span>
                            <div class="ag-kpi-icon-wrapper ag-kpi-icon-purple">
                                <i class="fa fa-shield"/>
                            </div>
                        </div>
                        <div class="d-flex align-items-baseline gap-2">
                            <div class="ag-kpi-value" style="color:#7c3aed;"><t t-esc="d.totals.compliance_rate"/>%</div>
                            <t t-if="d.totals.compliance_rate >= 95">
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2" style="font-size:10px;">Excellent</span>
                            </t>
                            <t t-elif="d.totals.compliance_rate >= 85">
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2" style="font-size:10px;">Good</span>
                            </t>
                            <t t-else="">
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2" style="font-size:10px;">Attention</span>
                            </t>
                        </div>
                        <span class="text-muted" style="font-size:12px;">Monthly attendance SLA</span>
                    </div>
                </div>
            </div>

            <!-- Calendar Matrix Grid Card -->
            <div class="ag-card-container mb-4">
                <div class="ag-card-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa fa-calendar-o text-muted fs-5"/>
                        <h5 class="m-0 fw-bold text-slate-800" style="letter-spacing:-0.01em;">Monthly Attendance Matrix</h5>
                        <span class="badge bg-light text-secondary border px-2 py-1 ms-2" style="font-size:11px;">
                            <t t-esc="d.month_label"/>
                        </span>
                    </div>
                    <span class="text-muted" style="font-size:12px;">
                        <i class="fa fa-info-circle me-1"/>Click any day cell to view daily operational details
                    </span>
                </div>
                <div class="p-3">
                    <!-- Day Header Columns -->
                    <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:6px;">
                        <t t-foreach="['Mon','Tue','Wed','Thu','Fri','Sat','Sun']" t-as="dow" t-key="dow">
                            <div class="text-center text-slate-600 fw-bold py-2 rounded-2" style="background:#f1f5f9;font-size:11px;letter-spacing:0.05em;text-transform:uppercase;">
                                <t t-esc="dow"/>
                            </div>
                        </t>
                    </div>

                    <!-- Calendar Week Rows -->
                    <t t-foreach="calendarGrid" t-as="week" t-key="week_index">
                        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:6px;">
                            <t t-foreach="week" t-as="cell" t-key="cell_index">
                                <t t-if="!cell">
                                    <div class="ag-day-cell ag-day-empty"/>
                                </t>
                                <t t-else="">
                                    <div t-att-class="'ag-day-cell ' + dayClass(cell) + (cell.date === d.today_str ? ' ag-day-today' : '')"
                                         t-on-click="() => this.openDayModal(cell)">
                                        
                                        <!-- Header row in day cell -->
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="fw-bold fs-6" style="line-height:1;"><t t-esc="cell.day"/></span>
                                            <t t-if="cell.date === d.today_str">
                                                <span class="ag-today-badge">TODAY</span>
                                            </t>
                                        </div>

                                        <!-- Day stats summary -->
                                        <t t-if="cell.scheduled > 0">
                                            <div class="d-flex flex-column gap-1">
                                                <div class="d-flex align-items-center justify-content-between gap-1 flex-wrap">
                                                    <span class="ag-chip-badge ag-chip-green">
                                                        <i class="fa fa-check me-1"/>
                                                        <t t-esc="cell.present"/>/<t t-esc="cell.scheduled"/>
                                                    </span>
                                                    <t t-if="cell.awol > 0">
                                                        <span class="ag-chip-badge ag-chip-red">
                                                            <i class="fa fa-warning me-1"/>
                                                            <t t-esc="cell.awol"/>
                                                        </span>
                                                    </t>
                                                </div>

                                                <!-- Progress Bar -->
                                                <t t-if="cell.pct !== null">
                                                    <div class="ag-progress-track mt-1">
                                                        <div t-att-class="'h-100 rounded-2 ' + pctBar(cell.pct)"
                                                             t-att-style="'width:' + cell.pct + '%'"/>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="text-muted small italic" style="font-size:11px;">No Shifts</div>
                                        </t>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </t>

                    <!-- Legend Footer -->
                    <div class="d-flex align-items-center gap-4 mt-3 pt-3 border-top flex-wrap px-2">
                        <span class="text-muted fw-semibold" style="font-size:12px;">Legend:</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle" style="width:10px;height:10px;background:#10b981;"/>
                            <span style="font-size:12px;color:#475569;">≥ 90% Presence Rate</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle" style="width:10px;height:10px;background:#f59e0b;"/>
                            <span style="font-size:12px;color:#475569;">60–89% Presence Rate</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle" style="width:10px;height:10px;background:#ef4444;"/>
                            <span style="font-size:12px;color:#475569;">&lt; 60% Presence Rate</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle" style="width:10px;height:10px;background:#cbd5e1;"/>
                            <span style="font-size:12px;color:#475569;">Pending / Unmarked</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Site Breakdown Table Card -->
            <div class="ag-card-container">
                <div class="ag-card-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa fa-building-o text-muted fs-5"/>
                        <h5 class="m-0 fw-bold text-slate-800" style="letter-spacing:-0.01em;">Site Attendance Summary</h5>
                        <span class="badge bg-light text-secondary border px-2 py-1 ms-2" style="font-size:11px;">
                            <t t-esc="filteredSiteSummary.length"/> Sites Active
                        </span>
                    </div>

                    <!-- Search Input -->
                    <div class="position-relative">
                        <i class="fa fa-search position-absolute text-muted" style="left:10px;top:50%;transform:translateY(-50%);font-size:12px;"/>
                        <input type="text"
                               class="ag-search-input ps-4"
                               placeholder="Filter site name…"
                               t-model="state.siteSearchTerm"/>
                    </div>
                </div>

                <div class="p-0 table-responsive">
                    <t t-if="filteredSiteSummary.length === 0">
                        <div class="text-center text-muted py-5">
                            <i class="fa fa-building fa-2x mb-2 text-slate-300 d-block"/>
                            No security sites matching search criteria for <t t-esc="d.month_label"/>.
                        </div>
                    </t>
                    <t t-else="">
                        <table class="ag-table">
                            <thead>
                                <tr>
                                    <th>Security Client Site</th>
                                    <th class="text-end">Scheduled Shifts</th>
                                    <th class="text-end">Present</th>
                                    <th class="text-end">Absent</th>
                                    <th class="text-end">AWOL</th>
                                    <th class="text-center" style="min-width:180px;">Presence Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="filteredSiteSummary" t-as="s" t-key="s.id">
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-slate-800"><t t-esc="s.name"/></div>
                                        </td>
                                        <td class="text-end fw-semibold text-slate-700"><t t-esc="s.scheduled"/></td>
                                        <td class="text-end fw-bold text-success"><t t-esc="s.present"/></td>
                                        <td class="text-end text-amber-600"><t t-esc="s.absent"/></td>
                                        <td t-att-class="'text-end fw-bold ' + (s.awol > 0 ? 'text-danger' : 'text-slate-400')">
                                            <t t-esc="s.awol"/>
                                        </td>
                                        <td>
                                            <t t-if="s.pct !== null">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div style="flex:1;height:8px;background:#e2e8f0;border-radius:4px;overflow:hidden;">
                                                        <div t-att-class="'h-100 ' + pctBar(s.pct)"
                                                             t-att-style="'width:' + s.pct + '%'"/>
                                                    </div>
                                                    <span class="fw-bold" style="min-width:40px;text-align:right;font-size:12px;">
                                                        <t t-esc="s.pct"/>%
                                                    </span>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted small">—</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </div>
        </div>

        <!-- Interactive Day Modal Drawer -->
        <t t-if="state.activeDayModal">
            <t t-set="mCell" t-value="state.activeDayModal"/>
            <div class="ag-modal-backdrop" t-on-click.self="closeDayModal">
                <div class="ag-modal-dialog">
                    <div class="p-4 bg-slate-900 text-white d-flex align-items-center justify-content-between" style="background:linear-gradient(135deg, #0f172a, #1e293b);">
                        <div class="d-flex align-items-center gap-3">
                            <div class="ag-title-icon" style="width:38px;height:38px;font-size:16px;">
                                <i class="fa fa-calendar-day"/>
                            </div>
                            <div>
                                <h5 class="m-0 fw-bold text-white"><t t-esc="mCell.weekday"/>, <t t-esc="mCell.date"/></h5>
                                <span style="font-size:12px;color:rgba(255,255,255,0.7);">Daily Attendance Breakdown</span>
                            </div>
                        </div>
                        <button class="btn-close btn-close-white" t-on-click="closeDayModal"/>
                    </div>

                    <div class="p-4">
                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <div class="p-3 rounded-3 border bg-light">
                                    <div class="text-muted small fw-bold text-uppercase">Scheduled Guards</div>
                                    <div class="fs-3 fw-bold text-slate-800"><t t-esc="mCell.scheduled"/></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-3 border bg-emerald-50" style="background:#ecfdf5;border-color:#a7f3d0;">
                                    <div class="text-success small fw-bold text-uppercase">Present Turnout</div>
                                    <div class="fs-3 fw-bold text-success"><t t-esc="mCell.present"/></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-3 border bg-amber-50" style="background:#fffbeb;border-color:#fde68a;">
                                    <div class="text-amber-700 small fw-bold text-uppercase">Absences</div>
                                    <div class="fs-3 fw-bold text-amber-600"><t t-esc="mCell.absent"/></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded-3 border bg-rose-50" style="background:#fef2f2;border-color:#fecaca;">
                                    <div class="text-danger small fw-bold text-uppercase">AWOL Violations</div>
                                    <div class="fs-3 fw-bold text-danger"><t t-esc="mCell.awol"/></div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-2">
                            <button class="btn btn-primary w-100 py-2 fw-semibold" t-on-click="() => this.openPostingConsole(mCell.date)">
                                <i class="fa fa-desktop me-2"/>Open Supervisor Posting Console
                            </button>
                            <button class="btn btn-outline-secondary w-100 py-2 fw-semibold" t-on-click="() => this.openAttendanceRecords(mCell.date)">
                                <i class="fa fa-list me-2"/>View Attendance Records (<t t-esc="mCell.date"/>)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </t>
</div>
</t>
</templates>
