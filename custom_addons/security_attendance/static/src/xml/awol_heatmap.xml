<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t t-name="security_attendance.AWOLHeatmap">
<div class="o_awol_heatmap d-flex flex-column h-100 overflow-hidden" style="background: var(--ds-bg); font-family: var(--ds-font);">

    <!-- ═══════════════════════════════════════════════════════════
         PAGE HEADER — Clean Corporate Light
         ═══════════════════════════════════════════════════════════ -->
    <header class="awh-page-header d-flex align-items-center justify-content-between px-4 py-3 bg-white border-bottom flex-wrap gap-3">
        <div class="d-flex flex-column">
            <div class="awh-eyebrow">ATTENDANCE INTELLIGENCE</div>
            <div class="d-flex align-items-center gap-2 mt-1">
                <i class="fa fa-th text-primary fs-5" style="color: var(--ds-accent) !important;"/>
                <h3 class="awh-title mb-0 fw-bold">Attendance &amp; AWOL Heatmap</h3>
                <span class="badge bg-danger-subtle text-danger border px-2 py-1 ms-1" style="font-size: 11px;">
                    Pattern Analysis
                </span>
            </div>
            <div class="awh-subtitle text-muted mt-1 small">
                Visual absence frequency &amp; shift adherence over the last <strong class="text-dark"><t t-esc="state.dayRange"/> days</strong>
            </div>
        </div>

        <!-- Controls Row -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Day Range Selector -->
            <div class="btn-group btn-group-sm">
                <t t-foreach="[7, 14, 30, 60]" t-as="r" t-key="r">
                    <button t-att-class="'btn ' + (state.dayRange === r ? 'btn-primary text-white fw-bold' : 'btn-outline-secondary')"
                            style="background-color: state.dayRange === r ? 'var(--ds-accent)' : ''; border-color: state.dayRange === r ? 'var(--ds-accent)' : '';"
                            t-on-click="() => this.setDayRange(r)">
                        <t t-esc="r"/>d
                    </button>
                </t>
            </div>

            <!-- Guard search -->
            <div class="position-relative" style="width: 170px;">
                <input type="text"
                       class="form-control form-control-sm awh-search-input"
                       placeholder="Search guard…"
                       t-on-input="onGuardSearchInput"/>
            </div>

            <!-- Site filter -->
            <select class="form-select form-select-sm awh-select-site" style="min-width: 150px;"
                    t-on-change="onFilterSiteChange">
                <option value="">🏢 All Sites</option>
                <t t-foreach="state.sites" t-as="site" t-key="site.id">
                    <option t-att-value="site.id"><t t-esc="site.name"/></option>
                </t>
            </select>

            <!-- Export CSV -->
            <button class="btn btn-sm btn-outline-secondary px-3" t-on-click="exportCsv" title="Export CSV">
                <i class="fa fa-download me-1"/> Export CSV
            </button>
        </div>
    </header>

    <!-- Legend + totals bar -->
    <div class="awh-legend bg-white px-4 py-2 d-flex align-items-center gap-3 border-bottom flex-wrap" style="font-size: 12px;">
        <div class="d-flex align-items-center gap-1">
            <span class="badge rounded-circle p-1" style="background:#16a34a; width:10px; height:10px; display:inline-block;"/>
            <span class="text-muted">Present:</span>
            <strong class="text-success"><t t-esc="countByStatus('present')"/></strong>
        </div>
        <div class="d-flex align-items-center gap-1">
            <span class="badge rounded-circle p-1" style="background:#d97706; width:10px; height:10px; display:inline-block;"/>
            <span class="text-muted">Absent:</span>
            <strong class="text-warning"><t t-esc="countByStatus('absent')"/></strong>
        </div>
        <div class="d-flex align-items-center gap-1">
            <span class="badge rounded-circle p-1" style="background:#dc2626; width:10px; height:10px; display:inline-block;"/>
            <span class="text-muted">AWOL:</span>
            <strong class="text-danger"><t t-esc="countByStatus('awol')"/></strong>
        </div>
        <div class="d-flex align-items-center gap-1">
            <span class="badge rounded-circle p-1 border" style="background:#e2e8f0; width:10px; height:10px; display:inline-block;"/>
            <span class="text-muted">No Record</span>
        </div>
        <div class="ms-auto text-muted small">
            <strong><t t-esc="visibleGuards.length"/></strong> guard(s)
            <t t-if="state.filterSiteId"> · filtered by site</t>
        </div>
    </div>

    <!-- Loading -->
    <t t-if="state.loading">
        <div style="display:flex;justify-content:center;align-items:center;flex:1;gap:12px;color:#64748b;">
            <div class="spinner-border spinner-border-sm text-primary" role="status"/>
            Loading heatmap…
        </div>
    </t>

    <!-- Grid -->
    <t t-else="">
        <div class="awh-grid" style="flex:1;overflow:auto;padding:16px;">
            <t t-if="visibleGuards.length === 0">
                <div style="text-align:center;color:#64748b;padding:48px;">
                    <i class="fa fa-search fa-2x mb-3 d-block"/>
                    No guards match the current filters.
                </div>
            </t>
            <t t-else="">
            <table style="border-collapse:collapse;font-size:11px;min-width:100%;">
                <thead>
                    <tr>
                        <th style="position:sticky;left:0;background:white;z-index:2;padding:4px 8px;text-align:left;min-width:160px;border-bottom:2px solid #e2e8f0;color:#64748b;font-weight:600;">Guard</th>
                        <t t-foreach="dateHeaders" t-as="dh" t-key="dh.date">
                            <th style="padding:2px 1px;text-align:center;min-width:22px;border-bottom:2px solid #e2e8f0;color:#94a3b8;font-weight:500;white-space:nowrap;font-size:10px;">
                                <t t-esc="dh.label"/>
                            </th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="visibleGuards" t-as="guard" t-key="guard.id">
                        <tr>
                            <td style="position:sticky;left:0;background:white;z-index:1;padding:3px 8px;white-space:nowrap;border-bottom:1px solid #f1f5f9;font-weight:500;color:#1e293b;">
                                <t t-esc="guard.name"/>
                            </td>
                            <t t-foreach="state.days" t-as="day" t-key="day">
                                <td t-att-title="getCellTooltip(guard.id, day)"
                                    t-on-click="() => this.openRecord(guard.id, day)"
                                    t-att-style="'width:22px;height:22px;border-radius:3px;cursor:pointer;background:' + getCellColor(guard.id, day) + ';border-bottom:1px solid #f1f5f9;'">
                                </td>
                            </t>
                        </tr>
                    </t>
                    <!-- Summary row: daily attendance % -->
                    <tr style="border-top:2px solid #e2e8f0;">
                        <td style="position:sticky;left:0;background:#f8fafc;z-index:1;padding:4px 8px;font-weight:700;font-size:11px;color:#475569;">
                            Daily %
                        </td>
                        <t t-foreach="state.days" t-as="day" t-key="day">
                            <td t-att-title="'Coverage on ' + day"
                                t-att-style="'width:22px;height:22px;border-radius:3px;background:' + getDaySummary(day).color + ';opacity:0.85;'">
                                <t t-set="summary" t-value="getDaySummary(day)"/>
                            </td>
                        </t>
                    </tr>
                </tbody>
            </table>
            </t>
        </div>
    </t>
</div>
</t>
</templates>
