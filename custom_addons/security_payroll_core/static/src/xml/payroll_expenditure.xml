<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="security_payroll_core.PayrollExpenditure">
    <div class="o_payroll_command_center d-flex h-100 overflow-hidden">

        <!-- ===== LEFT SIDEBAR — PERIOD LIST ===== -->
        <div class="o_pcc_sidebar d-flex flex-column" style="width:280px; min-width:280px; overflow-y:auto;">

            <div class="p-4 border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa fa-calendar text-emerald" style="color:#10b981;"/>
                        <strong class="text-white text-uppercase" style="font-size:12px;letter-spacing:0.05em;">Expenditure Periods</strong>
                    </div>
                    <span class="badge bg-dark border border-secondary text-white-50 px-2 py-1" style="font-size:10px;">
                        <t t-esc="state.periods.length"/> Periods
                    </span>
                </div>
                
                <!-- Period Search Box -->
                <div class="position-relative mt-2">
                    <input type="text"
                           class="pcc-sidebar-search"
                           placeholder="Filter period name…"
                           t-model="state.periodSearchTerm"/>
                </div>
            </div>

            <t t-if="filteredPeriods.length === 0">
                <div class="text-center text-muted p-4 small" style="color:rgba(255,255,255,0.5) !important;">
                    <i class="fa fa-calendar-times-o fa-2x mb-2 d-block"/>
                    No matching payroll periods found.
                </div>
            </t>

            <div class="p-2">
                <t t-foreach="filteredPeriods" t-as="period" t-key="period.id">
                    <div t-att-class="'o_period_item ' + (state.selectedPeriodId === period.id ? 'is-active' : '')"
                         t-on-click="() => this.selectPeriod(period.id)">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="fw-bold text-white" style="font-size: 14px;"><t t-esc="period.name"/></span>
                            <span t-att-class="'badge pcc-badge ' + periodStateBadgeClass(period.state)">
                                <t t-esc="period.state"/>
                            </span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between mt-2" style="font-size:12px;color:rgba(255,255,255,0.7);">
                            <span style="font-size:11px;color:rgba(255,255,255,0.5);">Total Net</span>
                            <span class="fw-bold text-white">
                                <t t-esc="formatCurrency(period.total_net_pay)"/>
                            </span>
                        </div>
                    </div>
                </t>
            </div>

        </div>
        <!-- END SIDEBAR -->

        <!-- ===== MAIN CONTENT AREA ===== -->
        <div class="o_pcc_main flex-grow-1 d-flex flex-column overflow-hidden">

            <!-- Executive Header Banner -->
            <div class="o_pcc_header">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="ag-title-icon">
                            <i class="fa fa-line-chart"/>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h3 class="m-0 text-white fw-bold" style="letter-spacing:-0.02em;">Payroll Expenditure &amp; Analytics</h3>
                                <div class="ag-live-indicator">
                                    <span class="ag-live-dot"/>Live Expenditure Audit
                                </div>
                            </div>
                            <span style="color:rgba(255,255,255,0.7);font-size:13px;">
                                <t t-if="selectedPeriod">
                                    Expenditure Analysis Period: <strong class="text-white"><t t-esc="selectedPeriod.name"/></strong>
                                    (<t t-esc="selectedPeriod.date_from"/> to <t t-esc="selectedPeriod.date_to"/>)
                                </t>
                                <t t-else="">
                                    Select a payroll period from the left panel
                                </t>
                            </span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <t t-if="selectedPeriod">
                            <button class="pcc-top-btn"
                                    t-on-click="openPeriod"
                                    title="Open Period Form">
                                <i class="fa fa-external-link me-1"/>Period Form
                            </button>
                            <button class="pcc-top-btn"
                                    t-on-click="exportExpenditureCsv"
                                    style="background:#10b981;border-color:#10b981;"
                                    title="Export Expenditure CSV">
                                <i class="fa fa-download me-1"/>Export CSV
                            </button>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Loading Spinner -->
            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center flex-grow-1">
                    <div class="text-center py-5">
                        <div class="spinner-border text-success mb-3" style="width: 3rem; height: 3rem; border-width:0.25em;"/>
                        <p class="text-muted fw-semibold">Compiling payroll expenditure metrics…</p>
                    </div>
                </div>
            </t>

            <t t-else="">
                <div class="o_pcc_scroll_area flex-grow-1 overflow-auto p-4">

                    <!-- ===== STATS BAR — 5 CARDS ===== -->
                    <div class="row g-3 mb-4">

                        <!-- Gross Earnings Card -->
                        <div class="col-12 col-sm-6 col-xl">
                            <div class="pcc-stat-card pcc-border-blue">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="pcc-stat-lbl">Total Gross Payroll</span>
                                    <div class="pcc-stat-icon" style="color:#3b82f6;"><i class="fa fa-money fs-5"/></div>
                                </div>
                                <div class="pcc-stat-val text-primary"><t t-esc="formatCurrency(state.totals.gross)"/></div>
                                <div class="d-flex align-items-center gap-1 mt-1">
                                    <t t-if="grossChangePct !== null">
                                        <span t-att-class="'badge px-2 py-1 ' + (grossChangePct >= 0 ? 'bg-danger text-white' : 'bg-success text-white')" style="font-size:10px;">
                                            <i t-att-class="'fa me-1 ' + (grossChangePct >= 0 ? 'fa-arrow-up' : 'fa-arrow-down')"/>
                                            <t t-esc="formatPct(grossChangePct)"/>
                                        </span>
                                        <span class="text-muted" style="font-size:11px;">vs prev period</span>
                                    </t>
                                    <t t-else="">
                                        <span class="text-muted" style="font-size:11px;">Base period data</span>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Net Payroll Card -->
                        <div class="col-12 col-sm-6 col-xl">
                            <div class="pcc-stat-card pcc-border-emerald" style="background:#f0fdf4;">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="pcc-stat-lbl" style="color:#047857;">Total Net Payroll</span>
                                    <div class="pcc-stat-icon" style="color:#059669;"><i class="fa fa-check-circle fs-5"/></div>
                                </div>
                                <div class="pcc-stat-val text-success"><t t-esc="formatCurrency(state.totals.net)"/></div>
                                <div class="d-flex align-items-center gap-1 mt-1">
                                    <t t-if="netChangePct !== null">
                                        <span t-att-class="'badge px-2 py-1 ' + (netChangePct >= 0 ? 'bg-danger text-white' : 'bg-success text-white')" style="font-size:10px;">
                                            <i t-att-class="'fa me-1 ' + (netChangePct >= 0 ? 'fa-arrow-up' : 'fa-arrow-down')"/>
                                            <t t-esc="formatPct(netChangePct)"/>
                                        </span>
                                        <span class="text-muted" style="font-size:11px;">vs prev period</span>
                                    </t>
                                    <t t-else="">
                                        <span class="text-muted" style="font-size:11px;">Disbursed net pay</span>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Normal Hours -->
                        <div class="col-12 col-sm-6 col-xl">
                            <div class="pcc-stat-card pcc-border-slate">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="pcc-stat-lbl">Scheduled Hours</span>
                                    <div class="pcc-stat-icon" style="color:#64748b;"><i class="fa fa-clock-o fs-5"/></div>
                                </div>
                                <div class="pcc-stat-val"><t t-esc="formatHours(state.totals.normal_hrs)"/> <span style="font-size:14px;color:#64748b;">hrs</span></div>
                                <span class="text-muted" style="font-size:11px;">Standard roster hours</span>
                            </div>
                        </div>

                        <!-- Premium Hours -->
                        <div class="col-12 col-sm-6 col-xl">
                            <div class="pcc-stat-card pcc-border-warning">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="pcc-stat-lbl">Premium Hours</span>
                                    <div class="pcc-stat-icon" style="color:#f59e0b;"><i class="fa fa-star fs-5"/></div>
                                </div>
                                <div class="pcc-stat-val text-warning"><t t-esc="formatHours(state.totals.premium_hrs)"/> <span style="font-size:14px;color:#f59e0b;">hrs</span></div>
                                <span class="text-muted" style="font-size:11px;">Weekend, PH &amp; Night hours</span>
                            </div>
                        </div>

                        <!-- Overtime Hours -->
                        <div class="col-12 col-sm-6 col-xl">
                            <div class="pcc-stat-card pcc-border-purple">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="pcc-stat-lbl">Overtime (OT)</span>
                                    <div class="pcc-stat-icon" style="color:#8b5cf6;"><i class="fa fa-bolt fs-5"/></div>
                                </div>
                                <div class="pcc-stat-val text-purple" style="color:#8b5cf6;"><t t-esc="formatHours(state.totals.overtime_hrs)"/> <span style="font-size:14px;color:#8b5cf6;">hrs</span></div>
                                <span class="text-muted" style="font-size:11px;">Extra OT shift hours</span>
                            </div>
                        </div>

                    </div>
                    <!-- END STATS BAR -->

                    <!-- ===== TAB NAVIGATION ===== -->
                    <ul class="nav pcc-nav-tabs mb-4">
                        <li class="nav-item">
                            <button t-att-class="'nav-link' + (state.activeTab === 'by_employee' ? ' active' : '')"
                                    t-on-click="() => this.setTab('by_employee')">
                                <i class="fa fa-users me-2"/>Employee Breakdown
                                <span class="badge bg-secondary ms-2 rounded-pill">
                                    <t t-esc="filteredEmployees.length"/>
                                </span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button t-att-class="'nav-link' + (state.activeTab === 'summary' ? ' active' : '')"
                                    t-on-click="() => this.setTab('summary')">
                                <i class="fa fa-bar-chart me-2"/>Period Variance Summary
                            </button>
                        </li>
                    </ul>

                    <!-- ===== BY EMPLOYEE TAB ===== -->
                    <t t-if="state.activeTab === 'by_employee'">
                        <div class="pcc-card">
                            <div class="pcc-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-table text-primary"/>
                                    <span>Guard &amp; Staff Expenditure Directory</span>
                                    <span class="badge bg-light text-secondary border px-2 py-1 ms-2" style="font-size:11px;">
                                        <t t-esc="filteredEmployees.length"/> Employees
                                    </span>
                                </div>

                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <!-- Search Box -->
                                    <div class="position-relative">
                                        <i class="fa fa-search position-absolute text-muted" style="left:10px;top:50%;transform:translateY(-50%);font-size:12px;"/>
                                        <input type="text"
                                               class="pcc-search-input ps-4"
                                               placeholder="Filter guard name or grade…"
                                               t-model="state.employeeSearchTerm"/>
                                    </div>

                                    <!-- Filter Pills -->
                                    <div class="d-flex align-items-center gap-1">
                                        <button t-att-class="'pcc-filter-pill ' + (state.employeeFilter === 'all' ? 'is-active' : '')"
                                                t-on-click="() => this.setEmployeeFilter('all')">
                                            All
                                        </button>
                                        <button t-att-class="'pcc-filter-pill ' + (state.employeeFilter === 'ot' ? 'is-active' : '')"
                                                t-on-click="() => this.setEmployeeFilter('ot')">
                                            Overtime
                                        </button>
                                        <button t-att-class="'pcc-filter-pill ' + (state.employeeFilter === 'premium' ? 'is-active' : '')"
                                                t-on-click="() => this.setEmployeeFilter('premium')">
                                            Premium Hrs
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="p-0 pcc-table-wrapper table-responsive">
                                <t t-if="filteredEmployees.length === 0">
                                    <div class="text-center text-muted p-5">
                                        <i class="fa fa-users fa-3x mb-3 text-slate-300 d-block"/>
                                        No employee expenditure records matching the filter criteria.
                                    </div>
                                </t>
                                <t t-else="">
                                    <table class="pcc-table">
                                        <thead>
                                            <tr>
                                                <th>Guard / Employee Name</th>
                                                <th>Grade</th>
                                                <th class="text-end">Gross Earnings</th>
                                                <th class="text-end">Net Pay</th>
                                                <th class="text-end">Normal Hrs</th>
                                                <th class="text-end">Saturday</th>
                                                <th class="text-end">Sunday</th>
                                                <th class="text-end">Holiday</th>
                                                <th class="text-end">Night Shift</th>
                                                <th class="text-end">Overtime</th>
                                                <th class="text-center">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="filteredEmployees" t-as="emp" t-key="emp_index">
                                                <tr>
                                                    <td class="fw-bold text-slate-900">
                                                        <t t-esc="emp.name"/>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-light text-slate-700 border px-2 py-1" style="font-size:11px;">
                                                            <t t-esc="emp.grade"/>
                                                        </span>
                                                    </td>
                                                    <td class="text-end fw-semibold text-primary">
                                                        <t t-esc="formatCurrency(emp.gross)"/>
                                                    </td>
                                                    <td class="text-end fw-bold text-success">
                                                        <t t-esc="formatCurrency(emp.net)"/>
                                                    </td>
                                                    <td class="text-end text-slate-700 fw-semibold">
                                                        <t t-esc="formatHours(emp.normal_hrs)"/>
                                                    </td>
                                                    <td class="text-end text-slate-600">
                                                        <t t-esc="formatHours(emp.sat_hrs)"/>
                                                    </td>
                                                    <td class="text-end text-slate-600">
                                                        <t t-esc="formatHours(emp.sun_hrs)"/>
                                                    </td>
                                                    <td class="text-end text-slate-600">
                                                        <t t-esc="formatHours(emp.ph_hrs)"/>
                                                    </td>
                                                    <td class="text-end text-slate-600">
                                                        <t t-esc="formatHours(emp.night_hrs)"/>
                                                    </td>
                                                    <td class="text-end fw-bold text-warning">
                                                        <t t-esc="formatHours(emp.ot_hrs)"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-att-class="'badge px-2 py-1 ' + stateBadgeClass(emp.state)">
                                                            <t t-esc="emp.state"/>
                                                        </span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td colspan="2" class="fw-bold">Totals</td>
                                                <td class="text-end fw-bold text-primary">
                                                    <t t-esc="formatCurrency(state.totals.gross)"/>
                                                </td>
                                                <td class="text-end fw-bold text-success">
                                                    <t t-esc="formatCurrency(state.totals.net)"/>
                                                </td>
                                                <td class="text-end fw-bold">
                                                    <t t-esc="formatHours(state.totals.normal_hrs)"/>
                                                </td>
                                                <td colspan="4" class="text-end">
                                                    <span class="text-muted fw-normal me-1">Premium Total:</span>
                                                    <span class="fw-bold text-warning"><t t-esc="formatHours(state.totals.premium_hrs)"/> hrs</span>
                                                </td>
                                                <td class="text-end fw-bold text-warning">
                                                    <t t-esc="formatHours(state.totals.overtime_hrs)"/>
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </t>
                            </div>
                        </div>
                    </t>
                    <!-- END BY EMPLOYEE TAB -->

                    <!-- ===== SUMMARY TAB ===== -->
                    <t t-if="state.activeTab === 'summary'">
                        <div class="row g-4 mb-4">

                            <!-- Gross Earnings Card -->
                            <div class="col-12 col-md-6">
                                <div class="pcc-card h-100 p-4 d-flex flex-column align-items-center justify-content-center text-center">
                                    <div class="text-muted fw-bold text-uppercase mb-2" style="font-size:11px;letter-spacing:0.05em;">
                                        <i class="fa fa-money me-2 text-primary"/>Total Gross Earnings Variance
                                    </div>
                                    <div class="fw-bold text-slate-900 mb-2" style="font-size:32px;letter-spacing:-0.02em;">
                                        <t t-esc="formatCurrency(state.totals.gross)"/>
                                    </div>
                                    <t t-if="grossChangePct !== null">
                                        <div class="d-flex align-items-center gap-2">
                                            <span t-att-class="'badge px-2 py-1 ' + (grossChangePct >= 0 ? 'bg-danger text-white' : 'bg-success text-white')" style="font-size:12px;">
                                                <i t-att-class="'fa me-1 ' + (grossChangePct >= 0 ? 'fa-arrow-up' : 'fa-arrow-down')"/>
                                                <t t-esc="formatPct(grossChangePct)"/>
                                            </span>
                                            <span class="text-muted small">vs prior period (<t t-esc="formatCurrency(state.prevTotals.gross)"/>)</span>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <span class="text-muted small">No prior period comparison data available</span>
                                    </t>
                                </div>
                            </div>

                            <!-- Net Pay Card -->
                            <div class="col-12 col-md-6">
                                <div class="pcc-card h-100 p-4 d-flex flex-column align-items-center justify-content-center text-center">
                                    <div class="text-muted fw-bold text-uppercase mb-2" style="font-size:11px;letter-spacing:0.05em;">
                                        <i class="fa fa-check-circle me-2 text-success"/>Total Net Pay Variance
                                    </div>
                                    <div class="fw-bold text-success mb-2" style="font-size:32px;letter-spacing:-0.02em;">
                                        <t t-esc="formatCurrency(state.totals.net)"/>
                                    </div>
                                    <t t-if="netChangePct !== null">
                                        <div class="d-flex align-items-center gap-2">
                                            <span t-att-class="'badge px-2 py-1 ' + (netChangePct >= 0 ? 'bg-danger text-white' : 'bg-success text-white')" style="font-size:12px;">
                                                <i t-att-class="'fa me-1 ' + (netChangePct >= 0 ? 'fa-arrow-up' : 'fa-arrow-down')"/>
                                                <t t-esc="formatPct(netChangePct)"/>
                                            </span>
                                            <span class="text-muted small">vs prior period (<t t-esc="formatCurrency(state.prevTotals.net)"/>)</span>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <span class="text-muted small">No prior period comparison data available</span>
                                    </t>
                                </div>
                            </div>

                        </div>

                        <!-- Period-over-Period Comparison Table -->
                        <t t-if="previousPeriod">
                            <div class="pcc-card">
                                <div class="pcc-card-header d-flex align-items-center gap-2">
                                    <i class="fa fa-exchange text-primary"/>
                                    <span>Period-over-Period Financial Variance Analysis</span>
                                </div>
                                <div class="p-0 pcc-table-wrapper">
                                    <table class="pcc-table">
                                        <thead>
                                            <tr>
                                                <th>Expenditure Metric</th>
                                                <th class="text-end">
                                                    Current: <t t-esc="selectedPeriod ? selectedPeriod.name : 'Current'"/>
                                                </th>
                                                <th class="text-end">
                                                    Previous: <t t-esc="previousPeriod.name"/>
                                                </th>
                                                <th class="text-end">Variance Change (%)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="fw-bold text-slate-800">Total Gross Earnings</td>
                                                <td class="text-end fw-bold text-primary">
                                                    <t t-esc="formatCurrency(state.totals.gross)"/>
                                                </td>
                                                <td class="text-end text-slate-600">
                                                    <t t-esc="formatCurrency(state.prevTotals.gross)"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-att-class="'badge px-2 py-1 ' + (grossChangePct !== null ? (grossChangePct >= 0 ? 'bg-danger text-white' : 'bg-success text-white') : 'bg-secondary text-white')">
                                                        <t t-esc="formatPct(grossChangePct)"/>
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="fw-bold text-slate-800">Total Net Disbursed Pay</td>
                                                <td class="text-end fw-bold text-success">
                                                    <t t-esc="formatCurrency(state.totals.net)"/>
                                                </td>
                                                <td class="text-end text-slate-600">
                                                    <t t-esc="formatCurrency(state.prevTotals.net)"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-att-class="'badge px-2 py-1 ' + (netChangePct !== null ? (netChangePct >= 0 ? 'bg-danger text-white' : 'bg-success text-white') : 'bg-secondary text-white')">
                                                        <t t-esc="formatPct(netChangePct)"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>

                    </t>
                    <!-- END SUMMARY TAB -->

                </div>
            </t>
            <!-- END MAIN CONTENT -->

        </div>
        <!-- END MAIN AREA -->

    </div>
</t>

</templates>
