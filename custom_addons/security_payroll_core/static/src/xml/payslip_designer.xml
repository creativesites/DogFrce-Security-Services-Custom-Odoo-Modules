<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="security_payroll_core.PayslipDesigner" owl="1">
        <div class="o_payslip_designer o_content d-flex h-100 w-100 overflow-hidden bg-light">
            <!-- LEFT PANEL: Settings & Drag-and-Drop (sidebar) -->
            <div class="pcc-designer-sidebar d-flex flex-column h-100 shadow-lg" style="width: 390px; min-width: 390px; background: #ffffff; border-right: 1px solid #e2e8f0; z-index: 10;">
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between" style="background: #0f172a; color: #ffffff;">
                    <h5 class="m-0 fw-bold text-white" style="color: #ffffff !important;"><i class="fa fa-paint-brush me-2 text-success"/> Payslip Designer</h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-light px-3 shadow-sm rounded-pill fw-bold" t-on-click="resetTemplate">
                            <i class="fa fa-undo"/> Reset
                        </button>
                        <button class="btn btn-sm btn-success px-3 fw-bold shadow-sm rounded-pill" t-on-click="saveTemplate">
                            <i t-att-class="state.isSaving ? 'fa fa-spinner fa-spin' : 'fa fa-save'"/> Save
                        </button>
                    </div>
                </div>
                
                <div class="flex-grow-1 overflow-auto p-3">
                    
                    <!-- Basic Info -->
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase text-muted mb-2">Template Name</label>
                        <input type="text" class="form-control form-control-sm designer-input" t-model="state.name" t-on-change="_triggerPreview"/>
                    </div>

                    <!-- Style Presets -->
                    <div class="mb-4 bg-light p-2.5 rounded border border-light shadow-sm-inset">
                        <label class="form-label fw-bold small text-uppercase text-muted mb-2"><i class="fa fa-magic text-success me-1"/> Quick Presets</label>
                        <div class="d-flex flex-wrap gap-1.5">
                            <button class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill bg-white shadow-sm" t-on-click="() => this.applyPreset('slate')">
                                <span class="badge rounded-circle" style="background:#475569; width:10px; height:10px; padding:0;"/> Slate
                            </button>
                            <button class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill bg-white shadow-sm" t-on-click="() => this.applyPreset('emerald')">
                                <span class="badge rounded-circle" style="background:#10b981; width:10px; height:10px; padding:0;"/> Emerald
                            </button>
                            <button class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill bg-white shadow-sm" t-on-click="() => this.applyPreset('midnight')">
                                <span class="badge rounded-circle" style="background:#2563eb; width:10px; height:10px; padding:0;"/> Midnight
                            </button>
                            <button class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1.5 px-2.5 py-1.5 small rounded-pill bg-white shadow-sm" t-on-click="() => this.applyPreset('tactical')">
                                <span class="badge rounded-circle" style="background:#1e293b; width:10px; height:10px; padding:0;"/> Tactical
                            </button>
                        </div>
                    </div>

                    <!-- Theme Settings -->
                    <div class="mb-4">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="fa fa-sliders text-success me-1"/> Layout &amp; Styles</h6>
                        
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1">Base Layout Structure</label>
                            <select class="form-select form-select-sm designer-input" t-model="state.base_layout" t-on-change="_triggerPreview">
                                <option value="modern">Modern (Thin lines, sleek)</option>
                                <option value="corporate">Classic Corporate (Grids, formal)</option>
                                <option value="minimalist">Minimalist (Subtle, elegant)</option>
                                <option value="bold">Bold (Strong accents, cards)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1">Font Family</label>
                            <select class="form-select form-select-sm designer-input" t-model="state.font_family" t-on-change="_triggerPreview">
                                <option value="Inter">Inter (Modern)</option>
                                <option value="Roboto">Roboto (Clean)</option>
                                <option value="system-ui">System UI (Native)</option>
                            </select>
                        </div>
                        
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Primary Color</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="color" class="form-control form-control-color p-1 border rounded" style="height: 32px; width: 42px; cursor:pointer;" t-model="state.primary_color" t-on-change="_triggerPreview"/>
                                    <span class="small text-muted font-monospace" t-esc="state.primary_color"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Secondary Color</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="color" class="form-control form-control-color p-1 border rounded" style="height: 32px; width: 42px; cursor:pointer;" t-model="state.secondary_color" t-on-change="_triggerPreview"/>
                                    <span class="small text-muted font-monospace" t-esc="state.secondary_color"/>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Table Header BG</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="color" class="form-control form-control-color p-1 border rounded" style="height: 32px; width: 42px; cursor:pointer;" t-model="state.header_bg_color" t-on-change="_triggerPreview"/>
                                    <span class="small text-muted font-monospace" t-esc="state.header_bg_color"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Table Header Text</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="color" class="form-control form-control-color p-1 border rounded" style="height: 32px; width: 42px; cursor:pointer;" t-model="state.header_text_color" t-on-change="_triggerPreview"/>
                                    <span class="small text-muted font-monospace" t-esc="state.header_text_color"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Content Options -->
                    <div class="mb-4">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="fa fa-list-ul text-success me-1"/> Content Options</h6>
                        
                        <div class="form-check form-switch mb-2.5">
                            <input class="form-check-input" type="checkbox" id="tgg_attendance" t-model="state.show_attendance_metrics" t-on-change="_triggerPreview"/>
                            <label class="form-check-label small" for="tgg_attendance">Show Attendance Summary</label>
                        </div>
                        <div class="form-check form-switch mb-2.5">
                            <input class="form-check-input" type="checkbox" id="tgg_leave" t-model="state.show_leave_balances" t-on-change="_triggerPreview"/>
                            <label class="form-check-label small" for="tgg_leave">Show Leave Balances</label>
                        </div>
                        <div class="form-check form-switch mb-2.5">
                            <input class="form-check-input" type="checkbox" id="tgg_ytd" t-model="state.show_ytd" t-on-change="_triggerPreview"/>
                            <label class="form-check-label small" for="tgg_ytd">Show Year-To-Date (YTD) Totals</label>
                        </div>
                        <div class="form-check form-switch mb-2.5">
                            <input class="form-check-input" type="checkbox" id="tgg_admin_sig" t-model="state.show_admin_signature" t-on-change="_triggerPreview"/>
                            <label class="form-check-label small" for="tgg_admin_sig">Show Admin Signature</label>
                        </div>
                        <div class="form-check form-switch mb-2.5">
                            <input class="form-check-input" type="checkbox" id="tgg_guard_sig" t-model="state.show_guard_signature" t-on-change="_triggerPreview"/>
                            <label class="form-check-label small" for="tgg_guard_sig">Show Guard Signature</label>
                        </div>
                        
                        <div class="mt-3">
                            <label class="form-label small text-muted mb-1">Override 'Payslip' Label</label>
                            <input type="text" class="form-control form-control-sm designer-input" placeholder="e.g. Salary Statement" t-model="state.label_payslip" t-on-input="_triggerPreview"/>
                        </div>

                        <div class="mt-3">
                            <label class="form-label small text-muted mb-1">Company Announcement Banner</label>
                            <textarea class="form-control form-control-sm designer-input" rows="2" placeholder="e.g. Wishing all guards a safe holiday season!" t-model="state.announcement_text" t-on-input="_triggerPreview"/>
                        </div>
                    </div>

                    <!-- Block Builder (Drag & Drop) -->
                    <div class="mb-4">
                        <h6 class="fw-bold mb-3 border-bottom pb-2 text-dark"><i class="fa fa-th-list text-success me-1"/> Layout Builder</h6>
                        <p class="small text-muted mb-3">Drag to reorder sections. Use the handle on the left.</p>
                        
                        <div class="pcc-builder-blocks" t-ref="sortableContainer">
                            <t t-foreach="state.blocks" t-as="block" t-key="block.id">
                                <div class="pcc-builder-block d-flex align-items-center mb-2 p-2.5 border rounded bg-white shadow-sm" t-att-data-id="block.id">
                                    <div class="pcc-drag-handle me-3 text-muted" style="cursor: grab; padding: 5px;">
                                        <i class="fa fa-grip-vertical"/>
                                    </div>
                                    <div class="flex-grow-1">
                                        <span class="fw-bold small text-dark"><t t-esc="block.label"/></span>
                                    </div>
                                    <div>
                                        <i class="fa fa-eye text-success small"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL: Live Preview -->
            <div class="flex-grow-1 d-flex flex-column bg-white h-100 position-relative">
                <!-- Toolbar overlay -->
                <div class="pcc-preview-toolbar d-flex align-items-center justify-content-between p-2.5 px-4 shadow-sm" style="background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); z-index: 5; border-bottom: 1px solid #e2e8f0;">
                    <div class="text-muted small fw-bold text-uppercase d-flex align-items-center gap-2"><i class="fa fa-desktop text-success"/> Live Canvas Preview</div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-primary px-3 shadow-sm rounded-pill fw-bold" t-on-click="openPdfPreview" title="Open PDF Report">
                            <i class="fa fa-file-pdf-o me-1"/> PDF Preview
                        </button>
                        <button class="btn btn-sm btn-outline-secondary shadow-sm rounded-circle bg-white" t-on-click="_triggerPreview" title="Force Refresh">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>
                </div>
                
                <!-- Preview Canvas -->
                <div class="flex-grow-1 overflow-auto d-flex justify-content-center p-4 pcc-preview-container" style="background: #ffffff;">
                    
                    <!-- Loading overlay -->
                    <div t-if="state.isPreviewLoading" class="position-absolute w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(255,255,255,0.7); z-index: 10; top: 0; left: 0; backdrop-filter: blur(3px); transition: all 0.3s;">
                        <div class="spinner-border text-success" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    
                    <!-- The paper sheet -->
                    <div class="pcc-paper-sheet shadow border bg-white position-relative my-3" style="width: 21cm; min-height: 29.7cm; padding: 1.2cm 1.5cm; border-radius: 4px; transition: all 0.3s ease;">
                        <t t-if="state.previewHtml">
                            <t t-out="state.previewHtml"/>
                        </t>
                        <t t-else="">
                            <div class="text-center text-muted mt-5 pt-5">
                                <i class="fa fa-file-text-o fa-3x mb-3 opacity-25"/>
                                <h5>Preview Unavailable</h5>
                                <p class="small">Change a setting to generate the preview.</p>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
