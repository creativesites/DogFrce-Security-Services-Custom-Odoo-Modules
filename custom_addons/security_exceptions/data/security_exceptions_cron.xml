<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_exceptions_sync" model="ir.cron">
            <field name="name">Exceptions: sync from notifications</field>
            <field name="model_id" ref="model_security_exception_instance"/>
            <field name="state">code</field>
            <field name="code">model.action_sync_from_notifications()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="cron_exceptions_escalate" model="ir.cron">
            <field name="name">Exceptions: process escalations</field>
            <field name="model_id" ref="model_security_exception_instance"/>
            <field name="state">code</field>
            <field name="code">model.action_process_escalations()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
