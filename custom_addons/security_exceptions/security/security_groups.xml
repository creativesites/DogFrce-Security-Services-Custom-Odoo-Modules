<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_exception_triage" model="res.groups">
        <field name="name">Exceptions / Triage</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees every exception instance and can acknowledge/resolve/reopen them -- the manager/supervisor inbox role.</field>
    </record>

    <record id="security_base.group_security_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_exception_triage'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_exception_triage'))]"/>
    </record>
</odoo>
