<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_backup_restore_wizard_form" model="ir.ui.view">
        <field name="name">security.backup.restore.wizard.form</field>
        <field name="model">security.backup.restore.wizard</field>
        <field name="arch" type="xml">
            <form string="Restore Backup Snapshot">
                <group>
                    <field name="backup_record_id" options="{'no_create': True}"/>
                    <field name="target_environment" widget="radio"/>
                    <field name="confirm_production" invisible="target_environment != 'production'"/>
                </group>
                <group string="Audit Logging">
                    <field name="restore_reason" placeholder="State operational or technical reason for database restore..."/>
                </group>
                <footer>
                    <button name="action_execute_restore" string="Initiate Restore Job" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_security_backup_restore_wizard" model="ir.actions.act_window">
        <field name="name">Restore Snapshot</field>
        <field name="res_model">security.backup.restore.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
