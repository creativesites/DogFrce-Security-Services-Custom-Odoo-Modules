<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= -->
    <!-- ZM Payslip Sub-Template Overrides                       -->
    <!-- Targets sub-templates in security_payroll_core         -->
    <!-- ======================================================= -->

    <!-- ── 1. Company address in Header ──────────────────────── -->
    <template id="report_security_zm_payslip_header" inherit_id="security_payroll_core.report_payslip_header">
        <xpath expr="//p[contains(text(),'Windhoek')]" position="replace">
            <p class="text-muted small mb-0"
               t-if="not (doc.period_id.rule_set_id and doc.period_id.rule_set_id.country_code == 'ZM')">
                <t t-esc="res_company.city or 'Windhoek'"/>, <t t-esc="res_company.country_id.name or 'Namibia'"/>
            </p>
            <p class="text-muted small mb-0"
               t-if="doc.period_id.rule_set_id and doc.period_id.rule_set_id.country_code == 'ZM'">
                <t t-esc="res_company.city or 'Lusaka'"/>, <t t-esc="res_company.country_id.name or 'Zambia'"/>
            </p>
        </xpath>
    </template>

    <!-- ── 2. SSC Number → ZM statutory IDs in Employee Info ──── -->
    <template id="report_security_zm_payslip_employee_info" inherit_id="security_payroll_core.report_payslip_employee_info">
        <xpath expr="//tr[td[contains(text(),'SSC Number')]]" position="replace">
            <tr t-if="not (doc.period_id.rule_set_id and doc.period_id.rule_set_id.country_code == 'ZM')">
                <td class="text-muted py-1">SSC Number:</td>
                <td class="py-1">
                    <span t-field="doc.employee_id.security_ssc_number"/>
                    <span t-if="not doc.employee_id.security_ssc_number" class="text-muted">-</span>
                </td>
            </tr>
            <t t-if="doc.period_id.rule_set_id and doc.period_id.rule_set_id.country_code == 'ZM'">
                <tr>
                    <td class="text-muted py-1">NAPSA Member No.:</td>
                    <td class="py-1">
                        <span t-field="doc.employee_id.security_napsa_number"/>
                        <span t-if="not doc.employee_id.security_napsa_number" class="text-muted">-</span>
                    </td>
                </tr>
                <tr>
                    <td class="text-muted py-1">NHIMA Member No.:</td>
                    <td class="py-1">
                        <span t-field="doc.employee_id.security_nhima_number"/>
                        <span t-if="not doc.employee_id.security_nhima_number" class="text-muted">-</span>
                    </td>
                </tr>
                <tr>
                    <td class="text-muted py-1">TPIN:</td>
                    <td class="py-1">
                        <span t-field="doc.employee_id.security_tpin"/>
                        <span t-if="not doc.employee_id.security_tpin" class="text-muted">-</span>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>

    <!-- ── 3a. Attendance table "Rate" header ─────────────────── -->
    <template id="report_security_zm_payslip_attendance" inherit_id="security_payroll_core.report_payslip_attendance">
        <xpath expr="//th[text()='Rate']" position="replace">
            <th class="py-2" t-attf-style="color: {{ tmpl_settings.get('header_text_color') }} !important; background-color: {{ tmpl_settings.get('header_bg_color') }} !important;">
                Rate (<t t-esc="doc.period_id.rule_set_id.currency_id.name or 'NAD'"/>)
            </th>
        </xpath>
    </template>

    <!-- ── 3b. Earnings column heading ────────────────────────── -->
    <template id="report_security_zm_payslip_earnings" inherit_id="security_payroll_core.report_payslip_earnings">
        <xpath expr="//h6[contains(.,'Earnings')]" position="replace">
            <h6 class="fw-bold pcc-secondary mb-2">
                <i class="fa fa-plus-circle text-success me-1"/>
                Earnings (<t t-esc="doc.period_id.rule_set_id.currency_id.name or 'NAD'"/>)
            </h6>
        </xpath>
    </template>

    <!-- ── 3c. Deductions column heading ──────────────────────── -->
    <template id="report_security_zm_payslip_deductions" inherit_id="security_payroll_core.report_payslip_deductions">
        <xpath expr="//h6[contains(.,'Deductions')]" position="replace">
            <h6 class="fw-bold pcc-secondary mb-2">
                <i class="fa fa-minus-circle text-danger me-1"/>
                Deductions (<t t-esc="doc.period_id.rule_set_id.currency_id.name or 'NAD'"/>)
            </h6>
        </xpath>
    </template>

    <!-- ── 3d/e/f. Financial summary &amp; Net pay in Totals ──────── -->
    <template id="report_security_zm_payslip_totals" inherit_id="security_payroll_core.report_payslip_totals">
        <xpath expr="//div[span[@t-field='doc.total_earnings']]" position="replace">
            <div class="col-5 text-end fw-bold text-success">
                <span t-field="doc.total_earnings"/>
                <t t-esc="' ' + (doc.period_id.rule_set_id.currency_id.name or 'NAD')"/>
            </div>
        </xpath>
        <xpath expr="//div[span[@t-field='doc.total_deductions']]" position="replace">
            <div class="col-5 text-end fw-bold text-danger">
                <span t-field="doc.total_deductions"/>
                <t t-esc="' ' + (doc.period_id.rule_set_id.currency_id.name or 'NAD')"/>
            </div>
        </xpath>
        <xpath expr="//h3[span[@t-field='doc.net_pay']]" position="replace">
            <h3 class="fw-bold mb-0 mt-1" style="font-size: 24px;">
                <span t-field="doc.net_pay"/>
                <t t-esc="' ' + (doc.period_id.rule_set_id.currency_id.name or 'NAD')"/>
            </h3>
        </xpath>
    </template>

</odoo>
